nextflow_pipeline {

    name "Test pipeline (probe-capture data: --protocol capture, --skip_primer_trimming, --duplicates)"
    script "../main.nf"
    tag "pipeline"
    tag "capture"

    // Relative paths in a samplesheet are checked against the launch directory: write a copy with absolute paths
    def absoluteSamplesheet = { outDir, root, dataset ->
        def sheet = new File("${outDir}/samplesheet_${dataset}.csv")
        sheet.parentFile.mkdirs()
        sheet.text = new File("${root}/tests/${dataset}/samplesheet.csv").text.replace("tests/${dataset}/", "${root}/tests/${dataset}/")
        return sheet.toString()
    }
    def processes = { workflow -> workflow.trace.tasks().collect { task -> task.name.tokenize(':').last().tokenize(' ').first() } as Set }

    test("-stub: --protocol capture skips primer trimming and amplicon analysis, marks duplicates") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir   = "$outputDir"
                input    = absoluteSamplesheet(outputDir, projectDir, 'data_capture')
                protocol = 'capture'
                barcodes = 'latest'
                db_dir   = "$outputDir/db"
            }
        }

        then {
            def run_info = new groovy.json.JsonSlurper().parse(new File("$outputDir/pipeline_info/run_info.json"))
            assertAll(
                { assert workflow.success },
                { assert processes(workflow).containsAll(['SAMTOOLS_SORT', 'SAMTOOLS_MARKDUP', 'FREYJA_VARIANTS', 'QC_SAMPLE']) },
                { assert !processes(workflow).any { name -> name in ['IVAR_TRIM', 'AMPLICON_COVERAGE'] } },
                { assert !new File("$outputDir/summary/amplicon_coverage.tsv").exists() },
                { assert new File("$outputDir/samples/CAP_MIX/bam/CAP_MIX.markdup_stats.txt").exists() },
                { assert new File("$outputDir/samples/CAP_MIX/bam/CAP_MIX.mapped.markdup.bam").exists() },
                { assert !new File("$outputDir/samples/CAP_MIX/bam/CAP_MIX.mapped.bam").exists() }, // the marked BAM replaces it
                { assert run_info.protocol == 'capture' && run_info.primer_trimming == false && run_info.duplicates == 'mark' },
                { assert run_info.params.protocol == 'capture' },
                { assert !run_info.input_checksums.containsKey('primer_bed') },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/software_versions.yml")).match() }
            )
        }
    }

    test("-stub: capture with --primer_scheme midnight warns that the scheme is ignored, and runs") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir        = "$outputDir"
                input         = absoluteSamplesheet(outputDir, projectDir, 'data_capture')
                protocol      = 'capture'
                primer_scheme = 'midnight'
                barcodes      = 'latest'
                db_dir        = "$outputDir/db"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // log.warn lines are in the run's own log (nf-test does not hand them to workflow.stdout)
                { assert new File("$outputDir").parentFile.toPath().resolve('meta/nextflow.log').toFile().text.contains('--primer_scheme/--primer_bed are ignored') },
                { assert !processes(workflow).contains('IVAR_TRIM') },
                { assert !new File("$outputDir/summary/amplicon_coverage.tsv").exists() }
            )
        }
    }

    test("-stub: --skip_primer_trimming on amplicon data (no trimming, no amplicon QC, duplicates left alone)") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir               = "$outputDir"
                input                = absoluteSamplesheet(outputDir, projectDir, 'data')
                skip_primer_trimming = true
                barcodes             = 'latest'
                db_dir               = "$outputDir/db"
            }
        }

        then {
            def run_info = new groovy.json.JsonSlurper().parse(new File("$outputDir/pipeline_info/run_info.json"))
            assertAll(
                { assert workflow.success },
                { assert !processes(workflow).any { name -> name in ['IVAR_TRIM', 'AMPLICON_COVERAGE', 'SAMTOOLS_MARKDUP'] } },
                { assert run_info.protocol == 'amplicon' && run_info.primer_trimming == false && run_info.duplicates == 'none' },
                { assert new File("$outputDir/samples/MIX_A/bam/MIX_A.mapped.bam").exists() }
            )
        }
    }

    test("-stub: --duplicates mark on amplicon data keeps trimming and adds the marked BAM") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir     = "$outputDir"
                input      = absoluteSamplesheet(outputDir, projectDir, 'data')
                duplicates = 'mark'
                barcodes   = 'latest'
                db_dir     = "$outputDir/db"
            }
        }

        then {
            def run_info = new groovy.json.JsonSlurper().parse(new File("$outputDir/pipeline_info/run_info.json"))
            assertAll(
                { assert workflow.success },
                { assert processes(workflow).containsAll(['IVAR_TRIM', 'SAMTOOLS_MARKDUP', 'AMPLICON_COVERAGE']) },
                { assert new File("$outputDir/samples/MIX_A/bam/MIX_A.primertrimmed.markdup.bam").exists() },
                { assert run_info.primer_trimming == true && run_info.duplicates == 'mark' }
            )
        }
    }

    test("-stub: a bad --protocol is refused by the schema") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir   = "$outputDir"
                input    = absoluteSamplesheet(outputDir, projectDir, 'data')
                protocol = 'shotgun'
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).join('\n').contains('--protocol') }
            )
        }
    }

    // Real run on the synthetic probe-capture dataset (tests/data_capture): the demix recovers the mixtures, the
    // negative control stays clean, duplicates are marked, nothing is primer-trimmed.
    test("real run on tests/data_capture with --protocol capture") {

        tag "docker"

        when {
            params {
                outdir   = "$outputDir"
                input    = absoluteSamplesheet(outputDir, projectDir, 'data_capture')
                protocol = 'capture'
                barcodes = "${projectDir}/tests/data/barcodes_test.csv"
                lineage_summary = false // custom barcodes file: no lineage hierarchy
                db_dir   = "$outputDir/db"
            }
        }

        then {
            def status = new File("$outputDir/summary/demix_status.tsv").readLines().drop(1).collect { line -> line.split('\t') }.collectEntries { cols -> [ (cols[0]): cols[1] ] }
            def qc_lines = new File("$outputDir/summary/qc_summary.tsv").readLines()
            def qc = qc_lines.drop(1).collect { line -> [ qc_lines[0].split('\t'), line.split('\t', -1) ].transpose().collectEntries { k, v -> [ (k): v ] } }.collectEntries { row -> [ (row.sample): row ] }
            def aggregated = new File("$outputDir/summary/freyja_aggregated.tsv").readLines().drop(1).collect { line -> line.split('\t')[0] } as Set
            def dup = { sample ->
                def f = new File("$outputDir/samples/${sample}/bam/${sample}.markdup_stats.txt").readLines().collectEntries { line -> line.contains(': ') ? [ (line.split(': ')[0]): line.split(': ')[1] ] : [:] }
                (f['DUPLICATE PAIR'] as double) / (f['EXAMINED'] as double)
            }
            assertAll(
                { assert workflow.success },
                { assert status == [ CAP_MIX: 'ok', CAP_MIX3: 'ok', CAP_PURE: 'ok', CAP_LOWCOV: 'skipped_low_coverage', CAP_NEG: 'skipped_low_coverage' ] },
                { assert aggregated == ['CAP_MIX', 'CAP_MIX3', 'CAP_PURE'] as Set },
                { assert qc.CAP_LOWCOV.qc_status == 'FAIL' && qc.CAP_LOWCOV.qc_reasons == 'low_coverage' },
                { assert qc.values().every { row -> row.amplicons_total == 'NA' && !row.qc_reasons.contains('amplicon_dropout') } },
                // the planted PCR duplicates are found (about 17% of the pairs)
                { assert dup('CAP_MIX') > 0.10 && dup('CAP_MIX') < 0.25 },
                { assert !new File("$outputDir/summary/amplicon_coverage.tsv").exists() },
                { assert !new File("$outputDir/samples/CAP_MIX/bam").list().any { name -> name.contains('primertrimmed') } },
                { assert new File("$outputDir/summary/report.html").text.contains('Not applicable for protocol') }
            )
        }
    }
}
