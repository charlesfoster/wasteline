nextflow_pipeline {

    name "Test pipeline (mode aggregate)"
    script "../main.nf"
    tag "pipeline"
    tag "aggregate"

    def sheetFor = { outDir, root ->
        def sheet = new File("${outDir}/aggregate_samplesheet.csv")
        sheet.parentFile.mkdirs()
        def base = "${root}/tests/fixtures/samplesheet/results_legacy"
        sheet.text = "sample,demix,sample_type,collection_date,site\n" +
            "Old_1,${base}/Old_1/freyja/Old_1.demix,sample,2026-01-05,A\n" +
            "NEG_Old,${base}/Old_1/freyja/Old_1.demix,negative,2026-01-06,A\n" +
            "Gz_only,${base}/Gz_only/freyja/Gz_only.demix,sample,,\n"
        return sheet.toString()
    }

    test("-stub: samplesheet, negative control excluded, time-aware plot for dated samples") {

        tag "stub"
        options "-stub"

        when {
            params {
                mode     = 'aggregate'
                outdir   = "$outputDir"
                input    = sheetFor(outputDir, projectDir)
                barcodes = 'latest'
                db_dir   = "$outputDir/db"
            }
        }

        then {
            def aggregated = new File("$outputDir/summary/freyja_aggregated.tsv").readLines().drop(1).collect { line -> line.split('\t')[0] }
            def run_info = new groovy.json.JsonSlurper().parse(new File("$outputDir/pipeline_info/run_info.json"))
            assertAll(
                { assert workflow.success },
                { assert aggregated == ['Gz_only', 'Old_1'] },
                { assert new File("$outputDir/summary/freyja_plot_times.pdf").exists() },
                { assert run_info.mode == 'aggregate' },
                { assert run_info.previous_runs == [] },
                // no demix happened: no barcode sidecar claiming a version for these results
                { assert !new File("$outputDir/summary/barcode_version.json").exists() },
                { assert !new File("$outputDir/summary/demix_status.tsv").exists() },
                { assert snapshot(removeNextflowVersion("$outputDir/pipeline_info/software_versions.yml")).match() }
            )
        }
    }
}
