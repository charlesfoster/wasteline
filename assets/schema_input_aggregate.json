{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/charlesfoster/wasteline/main/assets/schema_input_aggregate.json",
    "title": "charlesfoster/wasteline pipeline - params.input schema (mode 'aggregate')",
    "description": "Schema for the samplesheet provided with params.input in mode 'aggregate': existing Freyja .demix files",
    "type": "array",
    "uniqueEntries": ["sample"],
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Sample ID must be provided and may only contain letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "demix": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+$",
                "errorMessage": "demix must be an existing Freyja demix file without spaces in its path"
            },
            "sample_type": {
                "type": "string",
                "enum": ["sample", "negative"],
                "default": "sample",
                "errorMessage": "sample_type must be 'sample' or 'negative'",
                "meta": ["sample_type"]
            },
            "collection_date": {
                "type": "string",
                "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
                "format": "date",
                "errorMessage": "collection_date must be an ISO date (YYYY-MM-DD)",
                "meta": ["collection_date"]
            },
            "site": {
                "type": "string",
                "errorMessage": "site must be a string",
                "meta": ["site"]
            },
            "viral_load": {
                "type": "number",
                "exclusiveMinimum": 0,
                "errorMessage": "viral_load must be a positive number (e.g. gene copies per litre), or left blank",
                "meta": ["viral_load"]
            }
        },
        "required": ["sample", "demix"]
    }
}
