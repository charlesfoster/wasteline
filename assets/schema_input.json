{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/charlesfoster/wasteline/main/assets/schema_input.json",
    "title": "charlesfoster/wasteline pipeline - params.input schema",
    "description": "Schema for the samplesheet provided with params.input (mode 'full')",
    "type": "array",
    "uniqueEntries": ["sample"],
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "errorMessage": "Sample ID must be provided and may only contain letters, digits, '.', '_' and '-'",
                "meta": ["id"]
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "FastQ file for reads 2 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "sample_type": {
                "type": "string",
                "enum": ["sample", "negative"],
                "default": "sample",
                "errorMessage": "sample_type must be 'sample' or 'negative'",
                "meta": ["sample_type"]
            },
            "collection_date": {
                "type": "string",
                "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
                "format": "date",
                "errorMessage": "collection_date must be an ISO date (YYYY-MM-DD)",
                "meta": ["collection_date"]
            },
            "site": {
                "type": "string",
                "errorMessage": "site must be a string",
                "meta": ["site"]
            }
        },
        "required": ["sample", "fastq_1", "fastq_2"]
    }
}
