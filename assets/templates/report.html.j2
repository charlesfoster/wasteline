{#- wasteline HTML report. Self-contained: no external URLs, fonts or images.
    Rendered by bin/render_report.py with autoescape ON; every data string goes through {{ }}.
    Python only precomputes numbers / class names (see build_context). -#}
{% macro qcbadge(s) -%}
<span class="badge b-{{ (s or 'NA')|lower }}">{{ s or 'NA' }}</span>
{%- endmacro %}
{% macro dxbadge(s, reason='') -%}
{%- set cls = {'ok': 'pass', 'low_confidence': 'warn', 'failed': 'fail', 'skipped_low_coverage': 'warn', 'missing': 'warn'}.get(s, 'na') -%}
<span class="badge b-{{ cls }}"{% if s == 'low_confidence' %} title="{{ reason or 'Demixed with low genome coverage: treat the estimate with care' }}"{% endif %}>{{ 'low confidence' if s == 'low_confidence' else (s or 'n/a') }}</span>
{%- endmacro %}
{% macro filterbar(scope, with_qc=false) -%}
<div class="filterbar" data-scope="#{{ scope }}">
  <label>Filter <input type="search" placeholder="sample name" data-f="text" aria-label="Filter samples by name"></label>
  {% if with_qc %}
  <label>QC <select data-f="qc" aria-label="Filter by QC status">
    <option value="">all</option><option>PASS</option><option>WARN</option><option>FAIL</option><option>NA</option>
  </select></label>
  <label><input type="checkbox" data-f="issues"> only WARN/FAIL</label>
  {% endif %}
  <label><input type="checkbox" data-f="hidentc"> hide controls</label>
  <span class="count" data-f="count" aria-live="polite"></span>
</div>
{%- endmacro %}
{% macro lineage_block(v, what, id) -%}
<div id="{{ id }}" class="lin" {{ 'hidden' if what == 'full' }}>
  {% if v.n_ok == 0 %}
  <p class="note">No sample has a successful lineage result.</p>
  {% else %}
  <ul class="legend" aria-label="Colour legend">
    {% for item in v.legend %}<li><i class="sw {{ item.cls }}"></i>{{ item.name }}</li>{% endfor %}
  </ul>
  <h3>Relative abundance per sample</h3>
  <div class="bars" id="{{ id }}-bars">
    {% for row in v.rows %}
    <div class="brow" data-sample="{{ row.sample }}" data-qc="{{ row.qc }}" data-ntc="{{ 1 if row.ntc else 0 }}">
      <span class="lbl" title="{{ row.sample }}">{{ row.sample }}{% if row.ntc %} <em class="chip">NTC</em>{% endif %}{% if row.status == 'low_confidence' %} <em class="chip" title="{{ row.reason }}">low conf.</em>{% endif %}</span>
      {% if row.segs %}
      <svg viewBox="0 0 1000 14" preserveAspectRatio="none" role="img" aria-label="Lineage abundance of {{ row.sample }}">
        <rect class="track" x="0" y="0" width="1000" height="14"/>
        {% for s in row.segs %}<rect class="{{ s.cls }}" x="{{ s.x }}" y="0" width="{{ s.w }}" height="14"><title>{{ s.title }}</title></rect>{% endfor %}
      </svg>
      {% else %}
      <span class="nobar">{{ dxbadge(row.status) }} {{ row.reason|short(90) if row.reason }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <h3>Sample &times; lineage heatmap <small>(% abundance; colour scale is square-root)</small></h3>
  {% if v.n_hidden %}<p class="note">{{ v.n_hidden }} sample(s) without a lineage result are not shown (see Demix status).</p>{% endif %}
  <div class="scroll" id="{{ id }}-heat">
    <table class="heat">
      <thead><tr><th class="s">Sample</th>{% for c in v.columns %}<th class="vh" title="{{ c }}"><span>{{ c|short(22) }}</span></th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in v.heat_rows %}
        <tr data-sample="{{ row.sample }}" data-qc="{{ row.qc }}" data-ntc="{{ 1 if row.ntc else 0 }}"><th class="s" title="{{ row.sample }}">{{ row.sample|short(28) }}</th>{% for c in row.cells %}<td class="{{ c.cls }}" title="{{ c.title }}">{{ c.text }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>
{%- endmacro %}
{% macro growth_block(g) -%}
{% if g.status %}
<h3 id="growth-rates">Growth advantage <small>(freyja relgrowthrate)</small></h3>
{% if g.status == 'ok' and g.rows %}
<p class="note">{% if g.inputs.n_samples %}Fitted on {{ g.inputs.n_samples }} sample(s) over {{ g.inputs.n_dates_window or g.inputs.n_dates }} collection date(s){% if g.inputs.window_span_days %} spanning {{ g.inputs.window_span_days }} days{% endif %}{% if g.inputs.n_with_viral_load %}, {{ g.inputs.n_with_viral_load }} with a viral load{% endif %}. {% endif %}All sites are pooled.</p>
<div class="scroll"><table class="sortable" id="growth-table">
  <thead><tr><th data-sort>Lineage</th><th class="n" data-sort title="Relative growth advantage per serial interval versus all other lineages">Estimated advantage %</th><th data-sort title="Freyja's bootstrap 95% interval (on the growth-rate scale)">Bootstrap 95% interval</th></tr></thead>
  <tbody>
  {% for r in g.rows %}
  <tr><td>{{ r.lineage }}</td><td class="n {{ 'pos' if (r.advantage_pct or 0) > 0 else 'neg' }}" data-v="{{ r.advantage_pct|sortval }}">{% if r.advantage_pct is not none %}{{ '+' if r.advantage_pct > 0 }}{{ r.advantage_pct|dec(1) }}{% else %}&ndash;{% endif %}</td><td class="mono">{{ r.interval_text|dash }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="note"><b>How to read this.</b> The advantage is the lineage's relative growth versus all the other lineages per serial interval ({{ g.params.serial_interval or 5.5 }} days, <code>exp(interval &times; r) &minus; 1</code> for the logistic growth rate <i>r</i> of its share): +60% means it grows about 60% faster per serial interval, a negative value that it is declining. The bootstrap interval is Freyja's percentile interval of the growth rate times the serial interval, i.e. on a different scale than the estimate, so the estimate can fall outside it: treat it as a rough indication of uncertainty, not as a confidence interval. Few collection dates or a short time span make the numbers unstable; abundances are pooled over all sites.</p>
{% elif g.status == 'ok' %}
<p class="na-note">Freyja returned no lineage with a growth estimate (no lineage was above its abundance threshold in the fitted window).</p>
{% else %}
<p class="na-note"><b>Growth rates could not be computed.</b> {{ g.reason or 'No reason was recorded.' }}</p>
{% endif %}
{% endif %}
{% if g.dashboard %}
<p class="note">An interactive Freyja dashboard was also produced: <code>{{ g.dashboard }}</code> (in the results folder). It is not part of this report and needs internet access to load its styling; this report works offline.</p>
{% endif %}
{%- endmacro %}
{% macro sa_block(sa, key, id) -%}
<div id="{{ id }}" class="sa"{% if key == 'full' %} hidden{% endif %}>
  <ul class="legend" aria-label="Colour legend">
    {% for item in sa.legend[key] %}<li><i class="sw {{ item.cls }}"></i>{{ item.name }}</li>{% endfor %}
  </ul>
  {% for agg in sa.aggregates %}
  <h3>{{ agg.name }}</h3>
  <div class="bars">
    {% for p in agg.periods %}
    {% set row = p.rows[key] %}
    <div class="sarow">
      <span class="lbl" title="{{ p.label }}">{{ p.period|dash }}{% if p.start %} <small class="reasons">{{ p.start }}</small>{% endif %}</span>
      {% if row.segs %}
      <svg viewBox="0 0 1000 14" preserveAspectRatio="none" role="img" aria-label="Aggregated lineages of {{ p.label }}">
        <rect class="track" x="0" y="0" width="1000" height="14"/>
        {% for s in row.segs %}<rect class="{{ s.cls }}" x="{{ s.x }}" y="0" width="{{ s.w }}" height="14"><title>{{ s.title }}</title></rect>{% endfor %}
      </svg>
      {% else %}
      <span class="nobar">{{ dxbadge(row.status) }} {{ row.reason }}</span>
      {% endif %}
      <span class="chips">
        <span class="badge b-{{ 'fail' if p.n_inc == 0 else ('pass' if not p.missing else 'warn') }}" title="Sites that contributed: {{ p.included|default('none', true) }}">{{ p.n_inc }}/{{ p.n_total }} sites</span>
        {% if p.basis %}<span class="chip2{{ ' weak' if p.weak_basis }}" title="Weighting basis of the average{% if p.weak_basis %} (weaker than requested){% endif %}">{{ p.basis }}</span>{% endif %}
        {% if p.frac is not none %}<span class="chip2" title="Share of the member sites' total weight that contributed">{{ p.frac|round(0)|int }}% of weight</span>{% endif %}
        {% for m in p.missing %}<span class="chip2 miss" title="{{ m.site }}: {{ m.reason }}">missing {{ m.site }}</span>{% endfor %}
        {% if p.n_samples is not none %}<small class="reasons">{{ p.n_samples }} sample(s)</small>{% endif %}
      </span>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="wasteline render_report.py">
<title>{{ h.pipeline_name or 'wasteline' }} report</title>
<style>
