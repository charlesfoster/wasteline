  --pass:#00775a;--pass-bg:#d9f0e8;--warn:#8a5a00;--warn-bg:#fdebc8;--fail:#a83900;--fail-bg:#fbdccc;--na:#5b6570;--na-bg:#e8ebee;--info:#0b5cad;--info-bg:#dcebf8;
  --c0:#0072B2;--c1:#E69F00;--c2:#009E73;--c3:#CC79A7;--c4:#56B4E9;--c5:#D55E00;--c6:#F0E442;--c7:#882255;--c8:#44AA99;--c9:#332288;--co:#9aa0a6;
  --track:#e8ebee;--thr:#1c2128;--drop:rgba(213,94,0,.28);
  --h0:#f1f3f5;--h1:#e1edf7;--h2:#cfe2f3;--h3:#b3d3ec;--h4:#8fbfe3;--h5:#6aa8d6;--h6:#4a8fc6;--h7:#2f75b0;--h8:#1b5a96;--h9:#0b3d78;
