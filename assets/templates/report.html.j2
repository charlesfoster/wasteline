    --pass:#4cc9a4;--pass-bg:#10382e;--warn:#f0b84a;--warn-bg:#40300c;--fail:#ff9a66;--fail-bg:#4a1f0c;--na:#9aa5b1;--na-bg:#262d35;--info:#6db3f2;--info-bg:#17324b;
    --c0:#4da3e0;--c1:#E69F00;--c2:#1fbf94;--c3:#d98bb8;--c4:#56B4E9;--c5:#ee7a33;--c6:#F0E442;--c7:#cc6688;--c8:#44AA99;--c9:#8c80e0;--co:#6b737c;
    --track:#262d35;--thr:#e4e8ec;--drop:rgba(238,122,51,.32);
    --h0:#1d232a;--h1:#1f3347;--h2:#234563;--h3:#285882;--h4:#2f6da3;--h5:#3d84c0;--h6:#5b9fd6;--h7:#7fb7e3;--h8:#a5cdee;--h9:#cde4f6;
    --hfg-lo:#e4e8ec;--hfg-hi:#14181d;
    --d0:#ff6b3d;--d1:#f09a6a;--d2:#234563;--d3:#2f6da3;--d4:#5b9fd6;--d5:#cde4f6;--dn:#3a424b;
  }
}
:root[data-theme="dark"]{
  --bg:#14181d;--fg:#e4e8ec;--muted:#9aa5b1;--line:#2f3741;--panel:#1b2128;--link:#6db3f2;
  --pass:#4cc9a4;--pass-bg:#10382e;--warn:#f0b84a;--warn-bg:#40300c;--fail:#ff9a66;--fail-bg:#4a1f0c;--na:#9aa5b1;--na-bg:#262d35;--info:#6db3f2;--info-bg:#17324b;
  --c0:#4da3e0;--c1:#E69F00;--c2:#1fbf94;--c3:#d98bb8;--c4:#56B4E9;--c5:#ee7a33;--c6:#F0E442;--c7:#cc6688;--c8:#44AA99;--c9:#8c80e0;--co:#6b737c;
  --track:#262d35;--thr:#e4e8ec;--drop:rgba(238,122,51,.32);
  --h0:#1d232a;--h1:#1f3347;--h2:#234563;--h3:#285882;--h4:#2f6da3;--h5:#3d84c0;--h6:#5b9fd6;--h7:#7fb7e3;--h8:#a5cdee;--h9:#cde4f6;
  --hfg-lo:#e4e8ec;--hfg-hi:#14181d;
  --d0:#ff6b3d;--d1:#f09a6a;--d2:#234563;--d3:#2f6da3;--d4:#5b9fd6;--d5:#cde4f6;--dn:#3a424b;
}
*{box-sizing:border-box}
html{font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--fg)}
body{margin:0;background:var(--bg);color:var(--fg)}
[hidden]{display:none!important}
a{color:var(--link)}
.wrap{max-width:1240px;margin:0 auto;padding:0 16px 48px}
header.top{border-bottom:1px solid var(--line);padding:18px 0 14px;margin-bottom:12px}
header.top h1{margin:0 0 4px;font-size:1.6rem}
.sub{color:var(--muted);margin:0 0 10px}
.facts{display:flex;flex-wrap:wrap;gap:8px 28px;margin:10px 0 0}
.facts div{min-width:120px}
.facts dt{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.facts dd{margin:0;font-weight:600;overflow-wrap:anywhere}
.barcode{display:inline-block;border:2px solid var(--pass);background:var(--pass-bg);color:var(--fg);border-radius:8px;padding:6px 12px;margin:6px 0}
.barcode.unknown,.barcode.missing{border-color:var(--warn);background:var(--warn-bg)}
.barcode.custom{border-color:var(--info);background:var(--info-bg)}
.barcode b{font-size:1.25rem;font-variant-numeric:tabular-nums}
.barcode small{display:block;color:var(--muted)}
nav.toc{display:flex;flex-wrap:wrap;gap:4px 14px;margin:8px 0 4px;font-size:.9rem}
section{margin:26px 0;scroll-margin-top:8px}
h2{font-size:1.25rem;margin:0 0 8px;padding-bottom:4px;border-bottom:1px solid var(--line)}
h3{font-size:1rem;margin:18px 0 6px}
h3 small{font-weight:400;color:var(--muted)}
p.note,.note{color:var(--muted);margin:6px 0}
.na-note{border:1px dashed var(--line);border-radius:6px;padding:8px 12px;color:var(--muted);background:var(--panel)}
.cards{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 12px;min-width:110px}
.stat b{font-size:1.3rem;display:block;font-variant-numeric:tabular-nums}
.stat span{font-size:.78rem;color:var(--muted)}
ul.flags{list-style:none;margin:0;padding:0;display:grid;gap:6px}
ul.flags li{border-left:5px solid var(--line);background:var(--panel);padding:6px 10px;border-radius:0 6px 6px 0}
ul.flags li.error{border-color:var(--fail);background:var(--fail-bg)}
ul.flags li.warn{border-color:var(--warn);background:var(--warn-bg)}
ul.flags li.info{border-color:var(--info);background:var(--info-bg)}
ul.flags .lv{font-weight:700;font-size:.72rem;letter-spacing:.06em;margin-right:8px}
ul.flags .code{color:var(--muted);font-size:.78rem;margin-left:8px}
.badge{display:inline-block;padding:1px 8px;border-radius:999px;font-size:.78rem;font-weight:700;border:1px solid currentColor;white-space:nowrap}
.badge::before{margin-right:4px}
.b-pass{color:var(--pass);background:var(--pass-bg)}.b-pass::before{content:"\2713"}
.b-warn{color:var(--warn);background:var(--warn-bg)}.b-warn::before{content:"!"}
.b-fail{color:var(--fail);background:var(--fail-bg)}.b-fail::before{content:"\2715"}
.b-na{color:var(--na);background:var(--na-bg)}.b-na::before{content:"\2013"}
.chip{font-style:normal;font-size:.68rem;font-weight:700;border:1px solid var(--muted);color:var(--muted);border-radius:4px;padding:0 4px;margin-left:4px}
.filterbar{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;margin:8px 0;font-size:.9rem}
.filterbar input[type=search],.filterbar select{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:3px 8px}
.filterbar .count{color:var(--muted)}
.seg button{font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);padding:3px 12px;cursor:pointer}
.seg button:first-child{border-radius:6px 0 0 6px}.seg button:last-child{border-radius:0 6px 6px 0;border-left:0}
.seg button[aria-pressed=true]{background:var(--link);color:var(--bg);border-color:var(--link)}
.scroll{overflow:auto;max-width:100%;border:1px solid var(--line);border-radius:6px}
table{border-collapse:collapse;width:100%;font-size:.86rem}
th,td{padding:3px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums}
table.sortable td:nth-child(-n+4){white-space:nowrap}
thead th{position:sticky;top:0;background:var(--panel);z-index:2;white-space:nowrap}
table.sortable thead th[data-sort]{cursor:pointer;user-select:none}
table.sortable thead th[aria-sort=ascending]::after{content:" \25B2";font-size:.7em}
table.sortable thead th[aria-sort=descending]::after{content:" \25BC";font-size:.7em}
tbody tr:hover{background:var(--panel)}
tr.ntc td:first-child,tr.ntc th:first-child{font-style:italic}
.qc-wrap{max-height:70vh}
#qc-table table{font-size:.8rem}
#qc-table th,#qc-table td{padding:3px 5px}
#qc-table td{white-space:nowrap}
#qc-table thead th{white-space:normal;vertical-align:bottom;line-height:1.2;min-width:58px}
#qc-table th:first-child,#qc-table td:first-child{position:sticky;left:0;z-index:1;background:var(--bg);box-shadow:1px 0 0 var(--line)}
#qc-table thead th:first-child{z-index:3;background:var(--panel)}
#qc-table tbody tr:hover td:first-child{background:var(--panel)}
#qc-table td.reasons{min-width:100px;max-width:170px;white-space:normal}
.reasons{color:var(--muted);font-size:.8rem}
/* categorical colours */
.c0{fill:var(--c0);background:var(--c0)}.c1{fill:var(--c1);background:var(--c1)}.c2{fill:var(--c2);background:var(--c2)}
.c3{fill:var(--c3);background:var(--c3)}.c4{fill:var(--c4);background:var(--c4)}.c5{fill:var(--c5);background:var(--c5)}
.c6{fill:var(--c6);background:var(--c6)}.c7{fill:var(--c7);background:var(--c7)}.c8{fill:var(--c8);background:var(--c8)}
.c9{fill:var(--c9);background:var(--c9)}.co{fill:var(--co);background:var(--co)}
ul.legend{list-style:none;display:flex;flex-wrap:wrap;gap:4px 16px;margin:6px 0;padding:0;font-size:.85rem}
.sw{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.bars{display:grid;gap:3px}
.brow{display:grid;grid-template-columns:minmax(80px,200px) 1fr;gap:8px;align-items:center}
.brow .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.83rem}
.brow svg{width:100%;height:14px;display:block}
.brow svg .track{fill:var(--track)}
.nobar{font-size:.8rem;color:var(--muted)}
/* heatmaps (html tables) */
table.heat{width:auto;font-size:.72rem}
table.heat th,table.heat td{padding:1px 3px;border:0;text-align:center;min-width:26px}
table.heat th.s{position:sticky;left:0;background:var(--bg);text-align:left;white-space:nowrap;z-index:1;font-weight:400;font-size:.78rem}
table.heat thead th.s{z-index:3;background:var(--panel)}
table.heat th.vh{vertical-align:bottom;height:130px;padding:2px 0}
table.heat th.vh span{writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;font-weight:400;font-size:.75rem}
.h0{background:var(--h0)}.h1{background:var(--h1)}.h2{background:var(--h2)}.h3{background:var(--h3)}.h4{background:var(--h4)}
.h5{background:var(--h5)}.h6{background:var(--h6)}.h7{background:var(--h7)}.h8{background:var(--h8)}.h9{background:var(--h9)}
.h0,.h1,.h2,.h3,.h4,.h5{color:var(--hfg-lo)}.h6,.h7,.h8,.h9{color:var(--hfg-hi)}
td.na{color:var(--muted);background:transparent}
td.lowd{outline:1px dashed var(--muted);outline-offset:-2px;font-style:italic}
/* coverage */
.covgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:10px}
.cov{border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:var(--panel)}
.cov h4{margin:0 0 3px;font-size:.84rem;display:flex;justify-content:space-between;gap:6px;align-items:center}
.cov h4 span.nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cov svg{width:100%;height:64px;display:block;background:var(--bg);border:1px solid var(--line)}
.cov svg .area{fill:var(--c0);fill-opacity:.8;stroke:none}
.cov svg .thr{stroke:var(--thr);stroke-width:1;stroke-dasharray:4 3;vector-effect:non-scaling-stroke}
.cov svg .thr2{stroke:var(--muted);stroke-width:1;stroke-dasharray:1 3;vector-effect:non-scaling-stroke}
.cov svg .drop{fill:var(--drop);stroke:var(--d0);stroke-width:1;vector-effect:non-scaling-stroke}
.cov .meta{font-size:.74rem;color:var(--muted);display:flex;flex-wrap:wrap;gap:2px 10px}
.key{display:inline-block;width:18px;height:0;border-top:2px dashed var(--thr);vertical-align:middle;margin-right:4px}
.key.drop{width:14px;height:10px;border:1px solid var(--d0);background:var(--drop)}
/* amplicon dropout */
.arows{position:relative}
.arow{display:grid;grid-template-columns:minmax(80px,200px) 1fr;gap:8px;align-items:center;margin:1px 0}
.arow .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.78rem}
.arow svg{width:100%;height:11px;display:block;shape-rendering:crispEdges;background:var(--dn)}
.arow svg.freq{height:34px;background:transparent}
.arow svg.freq rect{fill:var(--d1)}
.arow .ruler{position:relative;height:14px;font-size:.68rem;color:var(--muted)}
.arow .ruler span{position:absolute;transform:translateX(-50%)}
.d0{fill:var(--d0);background:var(--d0)}.d1{fill:var(--d1);background:var(--d1)}.d2{fill:var(--d2);background:var(--d2)}
.d3{fill:var(--d3);background:var(--d3)}.d4{fill:var(--d4);background:var(--d4)}.d5{fill:var(--d5);background:var(--d5)}
.dn{fill:var(--dn);background:var(--dn)}
#tip{position:fixed;z-index:50;pointer-events:none;background:var(--fg);color:var(--bg);font-size:.78rem;padding:3px 8px;border-radius:4px;max-width:320px}
/* time series / comparison */
.tsgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:12px}
.ts svg{width:100%;height:auto;display:block;border:1px solid var(--line);border-radius:6px;background:var(--bg)}
.ts svg text{fill:var(--muted);font-size:10px}
.ts svg .grid{stroke:var(--line);stroke-width:1}
.ts svg polyline{fill:none;stroke-width:2;stroke:currentColor}
.ts svg circle{stroke:var(--bg);stroke-width:1}
.ts polyline.c0{color:var(--c0)}.ts polyline.c1{color:var(--c1)}.ts polyline.c2{color:var(--c2)}.ts polyline.c3{color:var(--c3)}.ts polyline.c4{color:var(--c4)}
.ts polyline.c5{color:var(--c5)}.ts polyline.c6{color:var(--c6)}.ts polyline.c7{color:var(--c7)}.ts polyline.c8{color:var(--c8)}.ts polyline.c9{color:var(--c9)}.ts polyline.co{color:var(--co)}
.mb{display:inline-block;width:80px;height:8px;background:var(--track);vertical-align:middle;margin-right:6px}
.mb i{display:block;height:100%;background:var(--c0)}.mb.b i{background:var(--c1)}
.pos{color:var(--c1)}.neg{color:var(--c0)}
details.prov{margin:10px 0}
details.prov summary{cursor:pointer;font-weight:600}
pre{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px 10px;overflow:auto;max-height:420px;font-size:.78rem}
code,td.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.82em}
td.wrap-any{overflow-wrap:anywhere}
footer{margin-top:40px;color:var(--muted);font-size:.8rem;border-top:1px solid var(--line);padding-top:8px}
@media print{
  html{font-size:11px}.wrap{max-width:none}.filterbar,.seg,nav.toc{display:none!important}
  .scroll,.qc-wrap,pre{overflow:visible;max-height:none}thead th{position:static}
  #qc-table th:first-child,#qc-table td:first-child{position:static}
  section{break-inside:auto}h2{break-after:avoid}.cov,.stat,ul.flags li{break-inside:avoid}
  table.heat th.s{position:static}
}
</style>
{% if extras %}
<style>
.b-info{color:var(--info);background:var(--info-bg)}.b-info::before{content:"i"}
.rtip{text-decoration:underline dotted;cursor:help}
tr.hl td{background:var(--warn-bg)}
tr.hl:hover td{background:var(--warn-bg)}
table.capped tr.more{display:none}
table.capped.show-more tr.more,.filtering table.capped tr.more{display:table-row}
button.showall{font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:3px 12px;cursor:pointer}
.tsctl{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:center;margin:6px 0 10px;font-size:.9rem}
.tsctl select{font:inherit;color:inherit;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:3px 8px}
.seg button:disabled{opacity:.45;cursor:not-allowed}
.seg button{background:var(--panel)}
.seg button[aria-pressed=true]{background:var(--link);color:var(--bg);border-color:var(--link)}
.seg button+button{border-left:0}
.sarow{display:grid;grid-template-columns:minmax(110px,170px) minmax(160px,1fr) 370px;gap:8px;align-items:center;margin:3px 0}
.sarow .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.83rem}
.sarow svg{width:100%;height:16px;display:block}
.sarow svg .track{fill:var(--track)}
.sarow .chips{display:flex;flex-wrap:wrap;gap:4px;align-items:center;justify-content:flex-start;font-size:.74rem}
.chip2{border:1px solid var(--line);border-radius:999px;padding:0 7px;background:var(--panel);white-space:nowrap}
.chip2.weak{border-color:var(--warn);color:var(--warn);background:var(--warn-bg)}
.chip2.miss{border-color:var(--warn);color:var(--warn)}
@media (max-width:980px){.sarow{grid-template-columns:1fr}}
@media print{table.capped tr.more{display:table-row}.tsctl{display:none}}
</style>
{% endif %}
{% if seg %}
<style>
.cov svg .segbg{fill:var(--thr);fill-opacity:.07;stroke:none}
.cov svg .segsep{stroke:var(--muted);stroke-width:1;vector-effect:non-scaling-stroke}
.cov .segs{position:relative;height:13px;margin-top:1px;font-size:.62rem;line-height:13px;color:var(--muted)}
.cov .segs span{position:absolute;top:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;box-sizing:border-box;padding-left:2px;border-left:1px solid var(--line)}
tr.seg-bad td{background:var(--warn-bg)}
</style>
{% endif %}
</head>
<body>
<div class="wrap">
<header class="top">
  <h1>{{ h.pipeline_name or 'wasteline' }} report</h1>
  <p class="sub">Wastewater {{ h.pathogen or 'SARS-CoV-2' }} lineage deconvolution &middot; mode <b>{{ mode }}</b>{% if h.pipeline_version %} &middot; pipeline {{ h.pipeline_version }}{% endif %}</p>
  {% if seg %}
  <p class="note" id="segments-note">Freyja demixes <b>{{ seg.freyja or 'one segment' }}</b> only; other segments are QC/consensus only.</p>
  {% endif %}
  {% if d.anonymized and d.anonymized != 'none' %}
  <p class="note" id="anonymized-note"><b>Anonymised for sharing ({{ d.anonymized }}).</b> Local paths, home directories and user names were removed{% if d.anonymized == 'full' %}; sample IDs and site names were replaced by pseudonyms (S001, SITE1, ...){% endif %}. Dates, lineage names, barcode versions and QC values are unchanged.</p>
  {% endif %}
  <div class="barcode {{ barcode_kind }}" id="barcode-version">
    <small>Freyja barcode version{% if h.pathogen %} ({{ h.pathogen }}){% endif %}</small>
    <b>{{ barcode or 'not recorded' }}</b>
    {% if barcode_kind == 'unknown' %}<small>Version unknown (legacy results): lineage calls cannot be tied to a barcode dataset.</small>
    {% elif barcode_kind == 'missing' %}<small>No barcode version in the run provenance.</small>
    {% elif barcode_kind == 'custom' %}<small>Custom barcode file{% if h.barcode_sha256 %}, sha256 {{ h.barcode_sha256[:16] }}&hellip;{% endif %}</small>
    {% elif h.barcode_source %}<small>source: {{ h.barcode_source }}{% if h.barcode_version_iso %} &middot; {{ h.barcode_version_iso }}{% endif %}</small>{% endif %}
  </div>
  <dl class="facts">
    <div><dt>Samples</dt><dd>{{ n_samples }}{% if n_ntc %} ({{ n_ntc }} control{{ 's' if n_ntc != 1 }}){% endif %}</dd></div>
    <div><dt>Pipeline version</dt><dd>{{ h.pipeline_version|dash }}</dd></div>
    <div><dt>Git commit</dt><dd>{% if h.git_commit %}<code>{{ h.git_commit|string|truncate(12, True, '') }}</code>{% else %}&ndash;{% endif %}</dd></div>
    {% if h.protocol %}<div><dt>Library protocol</dt><dd>{{ h.protocol }}{% if h.protocol == 'capture' %} (no primer trimming{% if h.duplicates == 'mark' %}, duplicates marked{% endif %}){% elif h.protocol == 'mixed' %} ({{ h.protocol_counts or 'per sample' }}; capture samples have no primer trimming and no amplicon analysis){% endif %}</dd></div>{% endif %}
    <div><dt>Freyja</dt><dd>{{ h.freyja_version|dash }}</dd></div>
    <div><dt>Nextflow</dt><dd>{{ h.nextflow_version|dash }}</dd></div>
    <div><dt>Run started</dt><dd>{{ h.run_started|dash }}</dd></div>
    <div><dt>Report data</dt><dd>{{ d.generated|dash }}</dd></div>
  </dl>
  {% if d.params_summary %}
  <details class="prov"><summary>Key parameters ({{ d.params_summary|length }})</summary>
    <div class="scroll"><table><tbody>
      {% for k, v in d.params_summary.items() %}<tr><th scope="row">{{ k }}</th><td class="mono wrap-any">{{ 'null' if v is none else v }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>
  {% endif %}
  <nav class="toc" aria-label="Sections">
    <a href="#sec-flags">Run flags</a><a href="#sec-qc">QC</a><a href="#sec-lineage">Lineages</a>
    {% if sa %}<a href="#sec-site-aggregates">Site aggregates</a>{% endif %}
    {% if controls %}<a href="#sec-controls">Negative controls</a>{% endif %}
    <a href="#sec-coverage">Coverage</a><a href="#sec-amplicons">Amplicon dropout</a><a href="#sec-demix">Demix status</a>
    {% if dx %}<a href="#sec-dropout-impact">Dropout impact</a>{% endif %}
    {% if moi %}<a href="#sec-moi">Mutations of interest</a>{% endif %}
    {% if ue %}<a href="#sec-unexplained">Unexplained mutations</a>{% endif %}
    {% if ts_new or ts or growth %}<a href="#sec-timeseries">Time series</a>{% endif %}
    {% if bc %}<a href="#sec-barcode">Barcode comparison</a>{% endif %}
    <a href="#sec-consensus">Consensus</a><a href="#sec-provenance">Provenance</a>
  </nav>
</header>

<section id="sec-flags">
  <h2>Run-level flags</h2>
  {% if flags %}
  <ul class="flags">
    {% for f in flags %}
    <li class="{{ f.level }}"><span class="lv">{{ (f.level or 'info')|upper }}</span>{{ f.message }}<span class="code">{{ f.code }}</span></li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="note"><span class="badge b-pass">no flags</span> No run-level issues were detected.</p>
  {% endif %}
</section>

<section id="sec-qc">
  <h2>Quality control</h2>
  {% if has_qc %}
  <div class="cards">
    <div class="stat"><b>{{ qc_counts.get('PASS', 0) }}</b><span>PASS</span></div>
    <div class="stat"><b>{{ qc_counts.get('WARN', 0) }}</b><span>WARN</span></div>
    <div class="stat"><b>{{ qc_counts.get('FAIL', 0) }}</b><span>FAIL</span></div>
    <div class="stat"><b>{{ qc_counts.get('NA', 0) }}</b><span>not assessed</span></div>
    <div class="stat"><b>{{ n_ntc }}</b><span>negative controls</span></div>
  </div>
  <p class="note">Counts exclude negative controls. Click a column header to sort.</p>
  {{ filterbar('qc-table', true) }}
  <div class="scroll qc-wrap" id="qc-table">
  <table class="sortable">
    <thead><tr>
      <th data-sort>Sample</th><th data-sort>Type</th><th data-sort>Date</th><th data-sort>Site</th><th data-sort>QC</th><th>Reasons</th>
      <th class="n" data-sort>Raw reads</th><th class="n" data-sort{% if seg %} title="% of trimmed reads mapped to the whole reference (all segments)"{% endif %}>Mapped %</th><th class="n" data-sort>Mean depth</th>
      <th class="n" data-sort>&ge;10x %</th><th class="n" data-sort>&ge;min depth %</th><th class="n" data-sort>Amplicons dropped</th>
      <th data-sort>Demix</th><th data-sort>Top group</th><th class="n" data-sort title="% of the reference positions with a called base (A, C, G, T or an IUPAC code) in the consensus; the rest is N or deleted">Consensus coverage %</th>
      {% if qc_extra.trim %}<th class="n" data-sort title="{{ qc_extra.trim_title }}">Primer trimmed %</th>{% endif %}
      {% if qc_extra.check %}<th data-sort title="Do read starts line up with the declared primer scheme?">Primer scheme</th>{% endif %}
    </tr></thead>
    <tbody>
    {% for s in samples %}
    <tr data-sample="{{ s.sample }}" data-qc="{{ s._qc }}" data-ntc="{{ 1 if s._ntc else 0 }}"{% if s._ntc %} class="ntc"{% endif %}>
      <td>{{ s.sample }}{% if s._ntc %}<em class="chip">NTC</em>{% endif %}</td>
      <td>{{ s.sample_type }}</td>
      <td>{{ s.collection_date|dash }}</td>
      <td>{{ s.site|dash }}</td>
      <td data-v="{{ {'FAIL': 0, 'WARN': 1, 'PASS': 2}.get(s._qc, 3) }}">{{ qcbadge(s.qc_status) }}</td>
      <td class="reasons">{% if s._rtip %}{% for r in s.qc_reasons %}{% if r in qc_extra.reason_titles %}<span class="rtip" title="{{ qc_extra.reason_titles[r] }}">{{ r }}</span>{% else %}{{ r }}{% endif %}{{ '; ' if not loop.last }}{% endfor %}{% else %}{{ s.qc_reasons|join('; ') }}{% endif %}</td>
      <td class="n" data-v="{{ s.raw_reads|sortval }}">{{ s.raw_reads|num }}</td>
      <td class="n" data-v="{{ s.mapped_pct|sortval }}">{{ s.mapped_pct|pct }}</td>
      <td class="n" data-v="{{ s.mean_depth|sortval }}">{{ s.mean_depth|dec }}</td>
      <td class="n" data-v="{{ s.pct_genome_ge_10x|sortval }}">{{ s.pct_genome_ge_10x|pct }}</td>
      <td class="n" data-v="{{ s.pct_genome_ge_min_depth|sortval }}">{{ s.pct_genome_ge_min_depth|pct }}</td>
      <td class="n" data-v="{{ s.amplicons_dropped|sortval }}">{% if s.amplicons_total is not none %}{{ s.amplicons_dropped|num }} / {{ s.amplicons_total|num }}{% else %}&ndash;{% endif %}</td>
      <td data-v="{{ s._demix.status or '' }}">{{ dxbadge(s._demix.status, s._demix.reason) }}</td>
      <td data-v="{{ s._top[0] if s._top else '' }}">{% if s._top %}{{ s._top[0] }} <span class="reasons">{{ s._top[1]|frac(0) }}%</span>{% else %}&ndash;{% endif %}</td>
      <td class="n" data-v="{{ s.consensus_coverage_pct|sortval }}">{{ s.consensus_coverage_pct|pct }}</td>
      {% if qc_extra.trim %}<td class="n" data-v="{{ s.primer_trimmed_pct|sortval }}" title="{{ qc_extra.trim_title }}">{{ s.primer_trimmed_pct|pct }}</td>{% endif %}
      {% if qc_extra.check %}<td data-v="{{ s.primer_scheme_check or '' }}">{% if s.primer_scheme_check %}<span class="badge b-{{ {'ok': 'pass', 'mismatch': 'warn'}.get(s.primer_scheme_check, 'na') }}" title="{{ s._pcheck_title }}">{{ s.primer_scheme_check }}</span>{% endif %}</td>{% endif %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% elif n_samples %}
  <p class="na-note">QC statistics are not available ({{ mode_note }}). Samples were taken from the lineage results only.</p>
  {% else %}
  <p class="na-note">No samples.</p>
  {% endif %}
</section>

<section id="sec-lineage">
  <h2>Lineage abundance</h2>
  {% if has_demix and (summ.n_ok or full.n_ok or n_samples) %}
  <div class="seg" role="group" aria-label="Lineage resolution">
    <button type="button" data-show="#lin-summ" data-hide="#lin-full" aria-pressed="true">Summarized groups</button><button type="button" data-show="#lin-full" data-hide="#lin-summ" aria-pressed="false">All lineages</button>
  </div>
  <p class="note">Summarized groups are Freyja's lineage groupings (e.g. Alpha, Delta); the full view shows individual (sub)lineages. Colours are shared only within a view; the same categorical palette is colour-blind safe, and every segment has a tooltip.</p>
  {{ filterbar('lin-wrap', false) }}
  <div id="lin-wrap">
    {{ lineage_block(summ, 'summ', 'lin-summ') }}
    {{ lineage_block(full, 'full', 'lin-full') }}
  </div>
  {% else %}
  <p class="na-note">Lineage results are not available ({{ mode_note }}).</p>
  {% endif %}
</section>

{% if sa %}
<section id="sec-site-aggregates">
  <h2>Site aggregates</h2>
  <p class="note">Groups of sites (for example a catchment made of several treatment plants), <b>combined from the per-site results, never from pooled reads</b>: every site's samples are demixed on their own, then the finished abundances of the member sites are averaged per period. Weights: <i>viral_load</i> weights each site by its viral load in that period, <i>site_weight</i> by the weight (for example population served) in your sites file, <i>equal</i> counts every site alike; a basis such as <i>equal (viral_load missing)</i> means the weighting you asked for was not available that period. Several samples of one site and period are combined first, so a site never counts twice. A period with sites <b>missing</b> is still shown: hover the amber chip for the reason (<code>not_ok:failed</code>: that site's demix failed or was skipped; <code>no_sample</code>: no sample in that period; <code>no_date</code>: samples without a valid date).</p>
  <div class="seg" role="group" aria-label="Lineage resolution">
    <button type="button" data-show="#sa-summ" data-hide="#sa-full" aria-pressed="true">Summarized groups</button><button type="button" data-show="#sa-full" data-hide="#sa-summ" aria-pressed="false"{% if not sa.has_full %} disabled{% endif %}>All lineages</button>
  </div>
  {{ sa_block(sa, 'summ', 'sa-summ') }}
  {{ sa_block(sa, 'full', 'sa-full') }}
</section>
{% endif %}
<section id="sec-coverage">
  <h2>Coverage tracks</h2>
  {% if coverage %}
  <p class="note">Mean depth per ~{{ coverage.bin_size }} bp bin across {{ coverage.genome_length|num }} bp{% if coverage.segments %} in {{ coverage.segments|length }} segments (alternating shading and labels mark them{% if coverage.segments_numbered %}; where a name does not fit the segment is numbered in reference order, hover for the name{% endif %}){% endif %}, log scale (top = {{ coverage.ymax|num }}x).
    <span class="key"></span>{{ coverage.amp_min }}x amplicon dropout threshold{% if coverage.y_cons is not none %}; dotted line = {{ coverage.cons_min }}x consensus minimum{% endif %}.
    <span class="key drop"></span>amplicon dropped.</p>
  {{ filterbar('cov-grid', true) }}
  <div class="covgrid" id="cov-grid">
    {% for c in coverage.cards %}
    <div class="cov" data-sample="{{ c.sample }}" data-qc="{{ c.qc }}" data-ntc="{{ 1 if c.ntc else 0 }}">
      <h4><span class="nm" title="{{ c.sample }}">{{ c.sample }}{% if c.ntc %}<em class="chip">NTC</em>{% endif %}</span>{{ qcbadge(c.qc if c.qc != 'NA' else none) }}</h4>
      <svg viewBox="0 0 {{ coverage.n_bins }} 100" preserveAspectRatio="none" role="img" aria-label="Coverage of {{ c.sample }}">
        {% for g in coverage.segments if g.alt %}<rect class="segbg" x="{{ g.x }}" y="0" width="{{ g.w }}" height="100"/>{% endfor %}
        {% for r in c.drops %}<rect class="drop" x="{{ r.x }}" y="0" width="{{ r.w }}" height="100"><title>{{ r.title }}</title></rect>{% endfor %}
        <path class="area" d="{{ c.path }}"/>
        <line class="thr" x1="0" x2="{{ coverage.n_bins }}" y1="{{ coverage.y_amp }}" y2="{{ coverage.y_amp }}"/>
        {% if coverage.y_cons is not none %}<line class="thr2" x1="0" x2="{{ coverage.n_bins }}" y1="{{ coverage.y_cons }}" y2="{{ coverage.y_cons }}"/>{% endif %}
        {% for g in coverage.segments[1:] %}<line class="segsep" x1="{{ g.x }}" x2="{{ g.x }}" y1="0" y2="100"/>{% endfor %}
      </svg>
      {% if coverage.segments %}
      <div class="segs">{% for g in coverage.segments %}<span style="left:{{ g.left }}%;width:{{ g.width }}%" title="{{ g.name }} ({{ g.length|num }} bp)">{{ g.label }}</span>{% endfor %}</div>
      {% endif %}
      <div class="meta"><span>mean {{ c.mean_depth|dec(0) }}x</span><span>&ge;10x: {{ c.pct10|pct(0) }}%</span><span>dropped: {{ c.dropped }}</span></div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="na-note">Per-position depth was not available ({{ mode_note }}).</p>
  {% endif %}
  {% if seg and seg.table.rows %}
  <h3 id="segments">Segments</h3>
  <p class="note">Per-segment QC for the {{ seg.n_contigs }} reference contigs. Amber rows: fewer than {{ seg.min_pct|round(1) if seg.min_pct is not none else 'the PASS threshold' }}% of positions at 10x, or an empty consensus; the whole-genome QC can still pass.{% if seg.n_bad %} {{ seg.n_bad }} sample(s) affected.{% endif %} Only <b>{{ seg.freyja or 'one segment' }}</b> is demixed.</p>
  {{ filterbar('seg-table', true) }}
  <div class="scroll qc-wrap" id="seg-table">
  <table class="sortable capped">
    <thead><tr><th data-sort>Sample</th><th data-sort>Segment</th><th class="n" data-sort>Length (bp)</th><th class="n" data-sort>Mean depth</th><th class="n" data-sort>&ge;10x %</th><th class="n" data-sort title="% of the segment with a called base in the consensus">Consensus coverage %</th><th data-sort>Consensus</th><th class="n" data-sort>Amplicons dropped</th></tr></thead>
    <tbody>
    {% for r in seg.table.rows %}
    <tr data-sample="{{ r.sample }}" data-qc="{{ r.qc }}" data-ntc="{{ 1 if r.ntc else 0 }}" class="{{ 'seg-bad' if r.bad and not r.ntc }}{{ ' more' if loop.index > seg.table.n_visible else '' }}">
      <td>{{ r.sample }}{% if r.ntc %}<em class="chip">NTC</em>{% endif %}</td>
      <td>{{ r.contig|dash }}{% if r.contig == seg.freyja %}<em class="chip" title="The segment Freyja demixes">demixed</em>{% endif %}</td>
      <td class="n" data-v="{{ r.length|sortval }}">{{ r.length|num }}</td>
      <td class="n" data-v="{{ r.mean_depth|sortval }}">{{ r.mean_depth|dec }}</td>
      <td class="n" data-v="{{ r.pct10|sortval }}">{{ r.pct10|pct }}</td>
      <td class="n" data-v="{{ r.cons|sortval }}">{{ r.cons|pct }}</td>
      <td>{{ r.cons_status|dash }}</td>
      <td class="n" data-v="{{ r.dropped|sortval }}">{% if r.total is not none %}{{ r.dropped|num }} / {{ r.total|num }}{% else %}&ndash;{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if seg.table.n > seg.table.n_visible %}<p class="note"><button type="button" class="showall" data-target="#seg-table">Show all {{ seg.table.n_shown|num }} rows</button>{% if seg.table.truncated %} (of {{ seg.table.n|num }}; the rest are in <code>contig_coverage.tsv</code>){% endif %}</p>{% endif %}
  {% endif %}
</section>

<section id="sec-amplicons">
  <h2>Amplicon dropout</h2>
  {% if amp %}
  <ul class="legend" aria-label="Amplicon colour legend">
    <li><i class="sw d0"></i>dropped, no coverage</li><li><i class="sw d1"></i>dropped (&lt;{{ amp.amp_min }}x)</li>
    <li><i class="sw d2"></i>&lt;{{ amp.amp_min * 10 }}x</li><li><i class="sw d3"></i>&lt;{{ amp.amp_min * 100 }}x</li>
    <li><i class="sw d4"></i>&lt;{{ amp.amp_min * 1000 }}x</li><li><i class="sw d5"></i>&ge;{{ amp.amp_min * 1000 }}x</li><li><i class="sw dn"></i>no data</li>
  </ul>
  <p class="note">{{ amp.rows|length }} sample(s) &times; {{ amp.n }} amplicons, in genome order; hover a cell for the amplicon and its mean depth. The top bar shows how often each amplicon dropped out across the {{ amp.considered }} non-control sample(s).</p>
  {% if h.protocol == 'mixed' %}<p class="note">Mixed run: probe-capture samples have no amplicons and are not listed here.</p>{% endif %}
  {{ filterbar('amp-rows', true) }}
  <div class="arows" id="amp-rows" data-amps='{{ amp.names|tojson }}'>
    <div class="arow"><span class="lbl">dropout frequency</span>
      <svg class="freq" viewBox="0 0 {{ amp.n }} 20" preserveAspectRatio="none" role="img" aria-label="Fraction of samples in which each amplicon dropped out">
        {% for f in amp.freq %}<rect x="{{ f.x }}" y="{{ 20 - f.h }}" width="1" height="{{ f.h }}"><title>{{ f.title }}</title></rect>{% endfor %}
      </svg></div>
    <div class="arow"><span class="lbl">amplicon #</span><div class="ruler">{% for t in amp.ticks %}<span style="left:{{ t.left }}%">{{ t.label }}</span>{% endfor %}</div></div>
    {% for r in amp.rows %}
    <div class="arow" data-sample="{{ r.sample }}" data-qc="{{ r.qc }}" data-ntc="{{ 1 if r.ntc else 0 }}">
      <span class="lbl" title="{{ r.sample }} ({{ r.dropped }} dropped)">{{ r.sample }}{% if r.ntc %}<em class="chip">NTC</em>{% endif %}</span>
      <svg viewBox="0 0 {{ amp.n }} 1" preserveAspectRatio="none" class="am" data-v="{{ r['values'] }}" role="img" aria-label="Amplicon depth of {{ r.sample }}">{% for p in r.paths %}<path class="{{ p.cls }}" d="{{ p.d }}"/>{% endfor %}</svg>
    </div>
    {% endfor %}
  </div>
  {% elif h.protocol == 'capture' %}
  <p class="na-note">Not applicable for protocol <b>capture</b>: probe-capture libraries have no amplicons, so there is no amplicon dropout to report (genome-wide depth is under Coverage tracks).</p>
  {% else %}
  <p class="na-note">Amplicon coverage is not available ({{ mode_note }}).</p>
  {% endif %}
</section>

{% if dx %}
<section id="sec-dropout-impact">
  <h2>Amplicon dropout impact</h2>
  {% if seg %}
  <p class="note"><b>{{ seg.freyja or 'The demixed segment' }} only.</b> Lineage impact is scored for the segment Freyja demixes; dropped amplicons of the other segments are in the amplicon dropout heatmap but not scored here.</p>
  {% endif %}
  {% if dx.has_defining %}
  <p class="note">A dropped amplicon hides every mutation inside it. What matters for the lineage estimate are the <b><abbr title="Defining mutations are the mutations a lineage has that its parent lineage lacks: they are what tells it apart from its parent and siblings. Mutations inherited from ancestors do not count.">defining mutations</abbr></b> of the lineages detected in the sample{% if dx.min_abundance is not none %} (abundance &ge; {{ (dx.min_abundance * 100)|round(1) }}%){% endif %}. For each dropped amplicon the table counts the defining sites it hides (primary), the <i>differential</i> sites (carried by some but not all detected lineages) and the lineage-informative sites (secondary context). Amber rows (<i>hides defining sites</i>) mean a lineage detected at {% if dx.min_affect is not none %}&ge; {{ (dx.min_affect * 100)|round(1) }}%{% else %}a noticeable abundance{% endif %} loses defining mutations, so its abundance estimate may be biased. Samples without a lineage estimate (skipped, failed, controls) show &ldquo;no lineage estimate&rdquo;.</p>
  {% else %}
  <p class="note">A dropped amplicon hides every mutation inside it. For each dropped amplicon this shows how many <b>lineage-informative</b> sites it covers (mutations carried by some but not nearly all lineages of the Freyja dataset) and how many of those belong to the lineages detected in the sample{% if dx.min_abundance is not none %} (abundance &ge; {{ (dx.min_abundance * 100)|round(1) }}%){% endif %}. Amber rows (<i>affects detected lineages</i>) mean the abundance estimate of those lineages may be biased. Samples without a lineage estimate (skipped, failed, controls) show &ldquo;no lineage estimate&rdquo;.</p>
  {% endif %}
  <div class="cards">
    <div class="stat"><b>{{ dx.n_affected }}</b><span>sample(s) with dropout {% if dx.has_defining %}hiding defining sites of detected lineages{% else %}affecting detected lineages{% endif %}</span></div>
    <div class="stat"><b>{{ dx.summary|length }}</b><span>sample(s) with dropped amplicons (of {{ dx.n_samples }})</span></div>
  </div>
  {% if dx.summary %}
  <h3>Per-sample summary</h3>
  <div class="scroll qc-wrap"><table class="sortable">
    {% if dx.has_defining %}
    <thead><tr><th data-sort>Sample</th><th class="n" data-sort>Dropped amplicons</th><th class="n" data-sort title="Defining sites of the detected lineages inside dropped amplicons / all defining sites the scheme can observe">Defining sites lost</th><th class="n" data-sort title="Share of the defining sites of the detected lineages that lie in dropped amplicons">% defining sites lost</th><th class="n" data-sort>Dropouts hiding defining sites</th><th class="n" data-sort title="Lineage-informative sites (carried by some but not nearly all lineages) in dropped amplicons / observable">Informative sites lost (%)</th></tr></thead>
    <tbody>
    {% for x in dx.summary %}
    <tr{% if x.affects %} class="hl"{% endif %}><td>{{ x.sample }}{% if x.ntc %}<em class="chip">NTC</em>{% endif %}</td><td class="n" data-v="{{ x.n_dropped|sortval }}">{{ x.n_dropped|num }}</td><td class="n" data-v="{{ x.def_lost|sortval }}">{% if x.def_total is none and x.def_lost is none %}<span class="reasons">no lineage estimate</span>{% else %}{{ x.def_lost|num }} / {{ x.def_total|num }}{% endif %}</td><td class="n" data-v="{{ x.def_pct|sortval }}"><b>{{ x.def_pct|pct(2) }}</b></td><td class="n" data-v="{{ x.n_affecting|sortval if not x.no_estimate else '' }}">{% if x.no_estimate %}<span class="reasons">no lineage estimate</span>{% else %}{{ x.n_affecting|num }}{% endif %}</td><td class="n reasons" data-v="{{ x.pct|sortval }}">{{ x.lost|num }} / {{ x.total|num }} ({{ x.pct|pct(1) }})</td></tr>
    {% endfor %}
    </tbody>
    {% else %}
    <thead><tr><th data-sort>Sample</th><th class="n" data-sort>Dropped amplicons</th><th class="n" data-sort>Informative sites lost</th><th class="n" data-sort title="Share of the lineage-informative sites the scheme can observe that lie in dropped amplicons">% informative sites lost</th><th class="n" data-sort>Dropouts affecting detected lineages</th></tr></thead>
    <tbody>
    {% for x in dx.summary %}
    <tr{% if x.affects %} class="hl"{% endif %}><td>{{ x.sample }}{% if x.ntc %}<em class="chip">NTC</em>{% endif %}</td><td class="n" data-v="{{ x.n_dropped|sortval }}">{{ x.n_dropped|num }}</td><td class="n" data-v="{{ x.lost|sortval }}">{{ x.lost|num }} / {{ x.total|num }}</td><td class="n" data-v="{{ x.pct|sortval }}">{{ x.pct|pct(2) }}</td><td class="n" data-v="{{ x.n_affecting|sortval if not x.no_estimate else '' }}">{% if x.no_estimate %}<span class="reasons">no lineage estimate</span>{% else %}{{ x.n_affecting|num }}{% endif %}</td></tr>
    {% endfor %}
    </tbody>
    {% endif %}
  </table></div>
  {% if dx.n_without %}<p class="note">{{ dx.n_without }} sample(s) without dropped amplicons are not listed.</p>{% endif %}
  {% endif %}
  {% if dx.table.rows %}
  <h3>Dropped amplicons</h3>
  {{ filterbar('dx-table', true) }}
  <div class="scroll qc-wrap" id="dx-table">
  <table class="sortable capped">
    {% if dx.has_defining %}
    <thead><tr><th data-sort>Sample</th><th data-sort>Amplicon</th><th class="n" data-sort>Span (bp)</th><th class="n" data-sort>Mean depth</th><th class="n" data-sort title="Defining mutations (lineage has them, its parent lacks them) of the detected lineages inside the dropped amplicon">Defining sites hidden</th><th>Lineages losing defining sites</th><th class="n" data-sort title="Sites in the amplicon carried by some but not all detected lineages (reported, not part of the warning)">Differential sites</th><th class="n" data-sort title="Lineage-informative sites in the amplicon (secondary context)">Informative sites</th></tr></thead>
    {% else %}
    <thead><tr><th data-sort>Sample</th><th data-sort>Amplicon</th><th class="n" data-sort>Span (bp)</th><th class="n" data-sort>Mean depth</th><th class="n" data-sort>Informative sites</th><th class="n" data-sort>In detected lineages</th><th>Affected lineages (informative sites)</th></tr></thead>
    {% endif %}
    <tbody>
    {% for r in dx.table.rows %}
    <tr data-sample="{{ r.sample }}" data-qc="{{ r.qc }}" data-ntc="{{ 1 if r.ntc else 0 }}" class="{{ 'hl' if r.affects }}{{ ' more' if loop.index > dx.table.n_visible else '' }}">
      <td>{{ r.sample }}{% if r.ntc %}<em class="chip">NTC</em>{% endif %}</td>
      <td>{{ r.amplicon|dash }}</td>
      <td class="n" data-v="{{ r.start|sortval }}">{{ r.start|num }}&ndash;{{ r.end|num }}</td>
      <td class="n" data-v="{{ r.mean_depth|sortval }}">{{ r.mean_depth|dec(1) }}</td>
      {% if dx.has_defining %}
      <td class="n" data-v="{{ r.n_def|sortval }}">{% if r.no_estimate %}<span class="reasons">no lineage estimate</span>{% else %}<b>{{ r.n_def|num }}</b>{% endif %}</td>
      <td>{% if r.affects %}<span class="badge b-warn" title="A lineage detected at or above the affect threshold loses defining mutations">hides defining sites</span> {% endif %}{% for l in r.lineages %}{{ l.lineage }} ({{ l.n_sites }}){% if not loop.last %}, {% endif %}{% endfor %}</td>
      <td class="n reasons" data-v="{{ r.n_diff|sortval }}">{{ r.n_diff|num }}</td>
      <td class="n reasons" data-v="{{ r.n_inf|sortval }}">{{ r.n_inf|num }}</td>
      {% else %}
      <td class="n" data-v="{{ r.n_inf|sortval }}">{{ r.n_inf|num }}</td>
      <td class="n" data-v="{{ r.n_det|sortval }}">{% if r.no_estimate %}<span class="reasons">no lineage estimate</span>{% else %}{{ r.n_det|num }}{% endif %}</td>
      <td>{% if r.affects %}<span class="badge b-warn">affects detected lineages</span> {% endif %}{% for l in r.lineages %}{{ l.lineage }} ({{ l.n_sites }}){% if not loop.last %}, {% endif %}{% endfor %}</td>
      {% endif %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if dx.table.n > dx.table.n_visible %}<p class="note"><button type="button" class="showall" data-target="#dx-table">Show all {{ dx.table.n_shown|num }} rows</button>{% if dx.table.truncated %} (of {{ dx.table.n|num }}; the rest are in <code>dropout_impact.tsv</code>){% endif %}</p>{% endif %}
  {% else %}
  <p class="note">No amplicon was dropped in any sample.</p>
  {% endif %}
</section>
{% endif %}
{% if controls %}
<section id="sec-controls">
  <h2>Negative controls</h2>
  <p class="note">Negative controls are demixed when they pass the coverage gate so that contamination is visible, but they are <b>excluded from the aggregate, the lineage view and the time series</b>{% if controls|selectattr('excluded_from_aggregate', 'equalto', false)|list %} (except where the run was told to include them){% endif %}. What each control contains:</p>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Control</th><th data-sort>QC</th><th>Reasons</th><th class="n" data-sort>Mapped reads</th><th class="n" data-sort>Genome &ge;1x %</th><th class="n" data-sort>Demix coverage %</th><th>Lineages detected</th><th>Aggregate</th></tr></thead>
    <tbody>
    {% for c in controls %}
    <tr class="ntc">
      <td>{{ c.sample }}<em class="chip">NTC</em></td>
      <td data-v="{{ {'FAIL': 0, 'WARN': 1, 'PASS': 2}.get(c.qc_status, 3) }}">{{ qcbadge(c.qc_status) }}</td>
      <td>{{ c.qc_reasons|join(', ')|dash }}</td>
      <td class="n" data-v="{{ c.mapped_reads|sortval }}">{{ c.mapped_reads|num }}</td>
      <td class="n" data-v="{{ c.pct_genome_ge_1x|sortval }}">{{ c.pct_genome_ge_1x|pct }}</td>
      <td class="n" data-v="{{ c.coverage|sortval }}">{{ c.coverage|pct }}</td>
      <td>{% if c.lineages %}{% for p in c.lineages[:5] %}{{ p[0] }} {{ p[1]|frac(1) }}%{% if not loop.last %}, {% endif %}{% endfor %}{% if c.lineages|length > 5 %}, &hellip;{% endif %}{% else %}&ndash;{% endif %}</td>
      <td>{{ 'excluded' if c.excluded_from_aggregate else 'included' }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endif %}

<section id="sec-demix">
  <h2>Demix status</h2>
  {% if has_demix %}
  <div class="cards">
    <div class="stat"><b>{{ demix_counts.get('ok', 0) }}</b><span>ok</span></div>
    {% if demix_counts.get('low_confidence', 0) %}<div class="stat"><b>{{ demix_counts.get('low_confidence', 0) }}</b><span title="Demixed, but with less genome coverage than the high-confidence threshold">low confidence</span></div>{% endif %}
    <div class="stat"><b>{{ demix_counts.get('skipped_low_coverage', 0) }}</b><span>skipped (low coverage)</span></div>
    <div class="stat"><b>{{ demix_counts.get('failed', 0) }}</b><span>failed</span></div>
    {% if demix_counts.get('missing', 0) %}<div class="stat"><b>{{ demix_counts.get('missing', 0) }}</b><span>no result</span></div>{% endif %}
  </div>
  {% if demix_counts.get('low_confidence', 0) %}
  {% set high_conf = (d.thresholds or {}).get('min_genome_coverage_for_demix') %}
  <p class="note"><span class="badge b-warn">low confidence</span> Demixed, but with less of the genome covered than the high-confidence threshold{% if high_conf is not none %} ({{ high_conf }}%){% endif %}: the estimate rests on fewer lineage-defining sites, so treat it with care. These samples are in <code>freyja_aggregated.tsv</code> and the lineage summary, but left out of the time series, growth rates, dashboard and site aggregates unless the run used <code>--include_low_confidence true</code>.</p>
  {% endif %}
  <div class="scroll">
  <table class="sortable">
    <thead><tr><th data-sort>Sample</th><th data-sort>Status</th><th>Reason</th><th data-sort>Barcode version</th><th class="n" data-sort>Genome coverage %</th><th class="n" data-sort>Residual</th></tr></thead>
    <tbody>
    {% for s in samples %}
    {% set x = s._demix %}
    <tr{% if s._ntc %} class="ntc"{% endif %}>
      <td>{{ s.sample }}{% if s._ntc %}<em class="chip">NTC</em>{% endif %}</td>
      <td data-v="{{ x.status or '' }}">{{ dxbadge(x.status, x.reason) }}</td>
      <td>{{ x.reason|dash }}</td>
      <td class="mono" >{{ x.barcode_version|dash }}</td>
      <td class="n" data-v="{{ x.coverage|sortval }}">{{ x.coverage|pct }}</td>
      <td class="n" data-v="{{ x.resid|sortval }}">{{ x.resid|dec(3) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="na-note">No demix results are available ({{ mode_note }}).</p>
  {% endif %}
</section>

{% if moi %}
<section id="sec-moi">
  <h2>Mutations of interest</h2>
  {% if moi.columns %}
  <p class="note">Alternate-allele frequency (%) per sample; dashed outline = depth below {{ moi.min_depth }}x; &ndash; = no coverage or no data.</p>
  {{ filterbar('moi-table', false) }}
  <div class="scroll" id="moi-table">
    <table class="heat">
      <thead><tr><th class="s">Sample</th>{% for c in moi.columns %}<th class="vh" title="{{ c.name }} {{ c.mutation }}"><span>{{ (c.name or c.mutation)|short(24) }}</span></th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in moi.rows %}
        <tr data-sample="{{ row.sample }}" data-qc="{{ row.qc }}" data-ntc="{{ 1 if row.ntc else 0 }}"><th class="s">{{ row.sample|short(28) }}</th>{% for c in row.cells %}<td class="{{ c.cls }}" title="{{ c.title }}">{{ c.text }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="note">A mutations-of-interest file was supplied but it contains no rows.</p>
  {% endif %}
</section>
{% endif %}

{% if ue %}
<section id="sec-unexplained">
  <h2>Unexplained mutations</h2>
  <p class="note"><b>What this is.</b> High-frequency single-nucleotide mutations in a sample that the demixed lineage mixture does not account for: for each site the frequency <i>expected</i> from the detected lineages and their abundances is compared with the <i>observed</i> frequency. A recurrent mutation (unexplained in {{ ue.min_recurrence|int if ue.min_recurrence else 'several' }} or more samples) is an early hint of a novel or cryptic lineage, or of a lineage missing from the barcodes. <b>It is not a variant caller</b>: sequencing errors, mixed-in reference lineages, low depth and amplicon dropout can all produce false hits, so confirm anything interesting on the reads.{% if ue.thresholds %} Thresholds: {{ ue.thresholds|join('; ') }}.{% endif %}{% if ue.has_in_dataset %} P-values are floored at 1e-300 (shown as &lt;=1e-300, meaning &ldquo;at most&rdquo;). <span class="chip">not in dataset</span> marks mutations at sites that no lineage in the Freyja dataset models: a dataset blind spot (for example masked sites) or a novel change{% if ue.n_blind %} ({{ ue.n_blind }} mutation{{ 's' if ue.n_blind != 1 }} here){% endif %}.{% endif %}</p>
  {% if ue.table.rows %}
  <div class="cards">
    <div class="stat"><b>{{ ue.table.n|num }}</b><span>unexplained mutation call(s)</span></div>
    <div class="stat"><b>{{ ue.n_samples }}</b><span>sample(s)</span></div>
    <div class="stat"><b>{{ ue.n_recurrent }}</b><span>recurrent mutation(s)</span></div>
  </div>
  {{ filterbar('ue-table', true) }}
  <div class="scroll qc-wrap" id="ue-table">
  <table class="sortable capped">
    <thead><tr><th data-sort>Sample</th><th class="n" data-sort>Position</th><th data-sort>Change</th><th data-sort>Gene</th><th data-sort>Amino acid</th><th data-sort>Effect</th><th class="n" data-sort>Observed %</th><th class="n" data-sort>Expected %</th><th class="n" data-sort>Depth</th><th class="n" data-sort>Alt reads</th><th class="n" data-sort title="One-sided binomial tail probability of the alt read count given the expected frequency">p-value</th><th data-sort>Recurrence</th></tr></thead>
    <tbody>
    {% for r in ue.table.rows %}
    <tr data-sample="{{ r.sample }}" data-qc="{{ r.qc }}" data-ntc="{{ 1 if r.ntc else 0 }}" class="{{ 'hl' if r.recurrent }}{{ ' more' if loop.index > ue.table.n_visible else '' }}">
      <td>{{ r.sample }}{% if r.ntc %}<em class="chip">NTC</em>{% endif %}</td>
      <td class="n" data-v="{{ r.position|sortval }}">{{ r.position|default('', true) }}</td>
      <td class="mono">{{ r.ref|dash }}&gt;{{ r.alt|dash }}</td>
      <td>{{ r.gene|dash }}</td>
      <td class="mono">{{ r.aa_change|dash }}</td>
      <td>{{ r.effect|dash }}</td>
      <td class="n" data-v="{{ r.observed_freq|sortval }}">{{ r.observed_freq|frac(1) }}</td>
      <td class="n" data-v="{{ r.expected_freq|sortval }}" title="excess {{ r.excess|frac(1) }} percentage points">{{ r.expected_freq|frac(1) }}</td>
      <td class="n" data-v="{{ r.depth|sortval }}">{{ r.depth|num }}</td>
      <td class="n" data-v="{{ r.alt_depth|sortval }}">{{ r.alt_depth|num }}</td>
      <td class="n" data-v="{{ r.p_value|sortval }}">{{ r.p_value|pval }}</td>
      <td data-v="{{ r.n_samples|sortval if r.recurrent else 0 }}">{% if r.recurrent %}<span class="badge b-info" title="The same mutation is unexplained in {{ r.n_samples if r.n_samples is not none else 'several' }} samples">recurrent{% if r.n_samples is not none %} ({{ r.n_samples }}){% endif %}</span>{% else %}<span class="reasons">single sample</span>{% endif %}{% if r.in_dataset is false %} <span class="chip" title="No lineage in the Freyja dataset models this mutation: a dataset blind spot (for example masked sites) or a novel change">not in dataset</span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if ue.table.n > ue.table.n_visible %}<p class="note"><button type="button" class="showall" data-target="#ue-table">Show all {{ ue.table.n_shown|num }} rows</button>{% if ue.table.truncated %} (of {{ ue.table.n|num }}; the rest are in <code>unexplained_mutations.tsv</code>){% endif %}</p>{% endif %}
  {% else %}
  <p class="na-note">None found with the current thresholds.</p>
  {% endif %}
</section>
{% endif %}
{% if ts_new %}
<section id="sec-timeseries" class="ts">
  <h2>Time series</h2>
  <div id="ts-root" data-level="{{ ts_new.views[0].level }}" data-weight="{{ ts_new.views[0].weight }}">
  <div class="tsctl">
    <span class="seg" role="group" aria-label="Lineage resolution"><button type="button" data-ts="level" data-v="summ" aria-pressed="{{ 'true' if ts_new.views[0].level == 'summ' else 'false' }}">Summarized groups</button><button type="button" data-ts="level" data-v="full" aria-pressed="{{ 'true' if ts_new.views[0].level == 'full' else 'false' }}"{% if not ts_new.has_lineages %} disabled title="No full-lineage time series in this run (needs freyja_timeseries_lineages.tsv)"{% endif %}>All lineages</button></span>
    <span class="seg" role="group" aria-label="Abundance weighting"{% if not ts_new.has_load %} title="Load-weighting is unavailable: no viral_load was recorded in the samplesheet"{% endif %}><button type="button" data-ts="weight" data-v="unw" aria-pressed="true">Unweighted</button><button type="button" data-ts="weight" data-v="w" aria-pressed="false"{% if not ts_new.has_load %} disabled title="No viral load recorded: add a viral_load column to the samplesheet"{% endif %}>Viral-load weighted</button></span>
    <label>Site <select id="ts-site" aria-label="Site">
      <option value="each">Each site</option>
      {% if ts_new.has_pooled %}<option value="__all__">All sites (pooled)</option>{% endif %}
      {% for st in ts_new.sites %}<option value="{{ st.key }}">{{ st.name }}</option>{% endfor %}
    </select></label>
  </div>
  <p class="note">Mean abundance of the top lineage groups per collection date ({{ ts_new.n_dates }} dates, {{ ts_new.first }} to {{ ts_new.last }}); negative controls, undated samples and samples below the coverage cut-off{% if ts_new.min_coverage is not none %} ({{ ts_new.min_coverage|int }}% of the genome){% endif %} are excluded. Several samples on the same date and site are averaged. <i>Viral-load weighted</i> lets each sample count in proportion to its viral load, so a low-load sample moves the curve less; dates without any recorded load are left blank. The pooled panel combines sites by sample count (or by total viral load when weighted).{% if ts_new.lineages_total_groups %} The full-lineage view is based on the most abundant lineages only ({{ ts_new.lineages_total_groups }} lineages occur in the data).{% endif %}</p>
  {% for v in ts_new.views %}
  <div class="tsview" id="{{ v.id }}" data-level="{{ v.level }}" data-weight="{{ v.weight }}"{% if not loop.first %} hidden{% endif %}>
    <ul class="legend">{% for item in v.legend %}<li><i class="sw {{ item.cls }}"></i>{{ item.name }}</li>{% endfor %}</ul>
    <div class="tsgrid">
      {% for p in v.panels %}
      <figure class="tspanel" data-site="{{ p.key }}" style="margin:0"{% if p.key == '__all__' %} hidden{% endif %}>
        <figcaption><b>{{ p.title }}</b></figcaption>
        <svg viewBox="0 0 {{ ts_new.width }} {{ ts_new.height }}" role="img" aria-label="Lineage abundance over time: {{ p.title }}">
          {% for t in v.yticks %}<line class="grid" x1="{{ ts_new.x0 }}" x2="{{ ts_new.x1 }}" y1="{{ t.y }}" y2="{{ t.y }}"/><text x="{{ ts_new.x0 - 4 }}" y="{{ t.y + 3 }}" text-anchor="end">{{ t.label }}</text>{% endfor %}
          <text x="{{ ts_new.x0 }}" y="{{ ts_new.height - 6 }}" text-anchor="start">{{ ts_new.first }}</text>
          <text x="{{ ts_new.x1 }}" y="{{ ts_new.height - 6 }}" text-anchor="end">{{ ts_new.last }}</text>
          {% for l in p.lines %}
          <polyline class="{{ l.cls }}" points="{{ l.points }}"/>
          {% for pt in l.dots %}<circle class="{{ l.cls }}" cx="{{ pt.x }}" cy="{{ pt.y }}" r="3"><title>{{ pt.title }}</title></circle>{% endfor %}
          {% endfor %}
        </svg>
      </figure>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
  </div>
  {% if growth %}{{ growth_block(growth) }}{% endif %}
</section>
{% elif ts %}
<section id="sec-timeseries" class="ts">
  <h2>Time series</h2>
  <p class="note">Mean abundance of the top summarized groups per collection date ({{ ts.n_dates }} dates, {{ ts.first }} to {{ ts.last }}); negative controls and samples without a lineage result are excluded. One panel per site, shared axes.</p>
  <ul class="legend">{% for item in ts.legend %}<li><i class="sw {{ item.cls }}"></i>{{ item.name }}</li>{% endfor %}</ul>
  <div class="tsgrid">
    {% for p in ts.panels %}
    <figure style="margin:0">
      <figcaption><b>{{ p.site or '(no site)' }}</b></figcaption>
      <svg viewBox="0 0 {{ ts.width }} {{ ts.height }}" role="img" aria-label="Lineage abundance over time at {{ p.site or 'no site' }}">
        {% for t in ts.yticks %}<line class="grid" x1="{{ ts.x0 }}" x2="{{ ts.x1 }}" y1="{{ t.y }}" y2="{{ t.y }}"/><text x="{{ ts.x0 - 4 }}" y="{{ t.y + 3 }}" text-anchor="end">{{ t.label }}</text>{% endfor %}
        <text x="{{ ts.x0 }}" y="{{ ts.height - 6 }}" text-anchor="start">{{ ts.first }}</text>
        <text x="{{ ts.x1 }}" y="{{ ts.height - 6 }}" text-anchor="end">{{ ts.last }}</text>
        {% for l in p.lines %}
        <polyline class="{{ l.cls }}" points="{{ l.points }}"/>
        {% for pt in l.dots %}<circle class="{{ l.cls }}" cx="{{ pt.x }}" cy="{{ pt.y }}" r="3"><title>{{ pt.title }}</title></circle>{% endfor %}
        {% endfor %}
      </svg>
    </figure>
    {% endfor %}
  </div>
  {% if growth %}{{ growth_block(growth) }}{% endif %}
</section>
{% elif growth %}
<section id="sec-timeseries" class="ts">
  <h2>Time series</h2>
  {{ growth_block(growth) }}
</section>
{% endif %}

{% if bc %}
<section id="sec-barcode">
  <h2>Barcode comparison</h2>
  <p class="note">Lineage abundances re-estimated with a second barcode dataset: <b>A</b> = {{ bc.label_a }}, <b>B</b> = {{ bc.label_b }}.
    Turnover = half the summed absolute change in abundance (0 = identical, 1 = completely different).</p>
  <h3>Samples with the largest changes{% if bc.n_summary > bc.summary|length %} <small>(top {{ bc.summary|length }} of {{ bc.n_summary }})</small>{% endif %}</h3>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Sample</th><th class="n" data-sort>Turnover %</th><th class="n" data-sort>Largest single change (points)</th></tr></thead>
    <tbody>{% for e in bc.summary %}<tr><td>{{ e.sample }}</td><td class="n" data-v="{{ e.tv|sortval }}">{{ e.tv|frac(1) }}</td><td class="n" data-v="{{ e.max|sortval }}">{{ e.max|frac(1) }}</td></tr>{% endfor %}</tbody>
  </table></div>
  <h3>Largest lineage changes{% if bc.n_rows > bc.rows|length %} <small>(top {{ bc.rows|length }} of {{ bc.n_rows }})</small>{% endif %}</h3>
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Sample</th><th data-sort>Lineage</th><th class="n" data-sort>A %</th><th class="n" data-sort>B %</th><th class="n" data-sort>Change (points)</th></tr></thead>
    <tbody>
    {% for r in bc.rows %}
    <tr><td>{{ r.sample }}</td><td>{{ r.lineage }}</td>
      <td class="n" data-v="{{ r.a|sortval }}"><span class="mb"><i style="width:{{ (r.a * 100)|round(1) }}%"></i></span>{{ r.a|frac(1) }}</td>
      <td class="n" data-v="{{ r.b|sortval }}"><span class="mb b"><i style="width:{{ (r.b * 100)|round(1) }}%"></i></span>{{ r.b|frac(1) }}</td>
      <td class="n {{ 'pos' if r.delta > 0 else 'neg' }}" data-v="{{ r.delta|sortval }}">{{ '+' if r.delta > 0 }}{{ r.delta|frac(1) }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endif %}

<section id="sec-consensus">
  <h2>Consensus genomes</h2>
  {% if consensus %}
  <div class="scroll"><table class="sortable">
    <thead><tr><th data-sort>Sample</th><th class="n" data-sort>Length</th><th class="n" data-sort>N count</th><th class="n" data-sort title="% of the reference positions with a called base (A, C, G, T or an IUPAC code); 100 minus the N and deleted positions">Coverage %</th><th class="n" data-sort>Other ambiguous</th><th data-sort>Status</th>{% if cons_reason %}<th data-sort>Reason</th>{% endif %}</tr></thead>
    <tbody>
    {% for r in consensus %}
    <tr><td>{{ r.sample }}</td><td class="n" data-v="{{ r.length|sortval }}">{{ r.length|num }}</td><td class="n" data-v="{{ r.n_count|sortval }}">{{ r.n_count|num }}</td>
      <td class="n" data-v="{{ r.consensus_coverage_pct|sortval }}">{{ r.consensus_coverage_pct|pct(2) }}</td><td class="n" data-v="{{ r.ambiguous_count|sortval }}">{{ r.ambiguous_count|num }}</td>
      <td data-v="{{ r.status or '' }}"><span class="badge b-{{ {'ok': 'pass', 'empty': 'warn', 'failed': 'fail'}.get(r.status, 'na') }}"{% if r.reason %} title="{{ r.reason }}"{% endif %}>{{ r.status or 'n/a' }}</span></td>{% if cons_reason %}<td class="reasons wrap-any">{{ r.reason|dash }}</td>{% endif %}</tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p class="na-note">Consensus statistics are not available ({{ mode_note }}).</p>
  {% endif %}
</section>

<section id="sec-provenance">
  <h2>Provenance</h2>
  {% if freyja_data %}
  <h3>Freyja dataset</h3>
  <div class="scroll"><table><tbody>
    {% for k, v in freyja_data.items() %}<tr><th scope="row">{{ k }}</th><td class="mono wrap-any">{{ 'null' if v is none else v }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% else %}
  <p class="na-note">The run provenance contains no <code>freyja_data</code> block.</p>
  {% endif %}
  {% if lgi %}
  <p class="note">Lineage groups: <code>{{ lgi.file }}</code>{% if lgi.sha %}, sha256 {{ lgi.sha }}{% endif %}{% if lgi.dataset %}, dataset {{ lgi.dataset }}{% endif %}; table in <code>summary/lineage_summary.csv</code></p>
  {% endif %}
  {% if previous_runs %}
  <h3>Previous runs this report builds on</h3>
  <div class="scroll"><table>
    <thead><tr><th>Path</th><th>Barcode version</th><th>run_info sha256</th></tr></thead>
    <tbody>{% for p in previous_runs %}<tr><td class="mono wrap-any">{{ p.path|dash }}</td><td>{% if (p.barcode_version or 'unknown')|lower == 'unknown' %}<span class="badge b-warn">unknown</span>{% else %}{{ p.barcode_version }}{% endif %}</td><td class="mono wrap-any">{{ (p.run_info_sha256 or '')[:16]|dash }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
  <details class="prov"><summary>Full run provenance (run_info.json without parameters)</summary><pre>{{ provenance_json }}</pre></details>
  <details class="prov"><summary>All pipeline parameters</summary><pre>{{ params_json }}</pre></details>
</section>

<footer>Generated by wasteline {{ h.pipeline_version or '' }} &middot; report data schema v{{ d.schema_version }} &middot; self-contained file, no external resources.</footer>
</div>
<div id="tip" hidden></div>
<script>
(function () {
  "use strict";
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  /* column sorting */
  $$("table.sortable").forEach(function (table) {
    $$("thead th[data-sort]", table).forEach(function (th) {
      th.tabIndex = 0;
      var go = function () {
        var idx = Array.prototype.indexOf.call(th.parentNode.children, th);
        var dir = th.getAttribute("aria-sort") === "ascending" ? "descending" : "ascending";
        $$("thead th", table).forEach(function (o) { o.removeAttribute("aria-sort"); });
        th.setAttribute("aria-sort", dir);
        var body = table.tBodies[0];
        var rows = $$("tr", body);
        var key = function (tr) {
          var c = tr.children[idx];
          if (!c) { return ""; }
          return c.hasAttribute("data-v") ? c.getAttribute("data-v") : c.textContent.trim();
        };
        var num = function (v) { return v !== "" && !isNaN(Number(v)); };
        rows.sort(function (a, b) {
          var x = key(a), y = key(b);
          if (x === "" && y === "") { return 0; }
          if (x === "") { return 1; }
          if (y === "") { return -1; }
          var r = (num(x) && num(y)) ? Number(x) - Number(y) : x.localeCompare(y, undefined, { numeric: true });
          return dir === "ascending" ? r : -r;
        });
        rows.forEach(function (tr) { body.appendChild(tr); });
      };
      th.addEventListener("click", go);
      th.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
    });
  });

  /* filter bars: act on every [data-sample] element inside data-scope */
  $$(".filterbar").forEach(function (bar) {
    var scope = $(bar.getAttribute("data-scope"));
    if (!scope) { return; }
    var f = function (n) { return $('[data-f="' + n + '"]', bar); };
    var apply = function () {
      var text = f("text").value.trim().toLowerCase();
      var qc = f("qc") ? f("qc").value : "";
      var issues = f("issues") && f("issues").checked;
      var hideNtc = f("hidentc").checked;
      var shown = 0, total = 0;
      $$("[data-sample]", scope).forEach(function (el) {
        if (el.closest("[hidden]") !== null && el.closest("[hidden]") !== el) { /* in a hidden view: still filter */ }
        var q = el.getAttribute("data-qc");
        var ok = (!text || el.getAttribute("data-sample").toLowerCase().indexOf(text) !== -1) &&
          (!qc || q === qc) && (!issues || q === "WARN" || q === "FAIL") &&
          (!hideNtc || el.getAttribute("data-ntc") !== "1");
        el.hidden = !ok;
        total += 1; if (ok) { shown += 1; }
      });
      f("count").textContent = (text || qc || issues || hideNtc) ? shown + " of " + total + " shown" : "";
    };
    $$("input,select", bar).forEach(function (c) { c.addEventListener("input", apply); c.addEventListener("change", apply); });
  });

  /* summarized / full toggle */
  $$(".seg button").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var on = $(btn.getAttribute("data-show")), off = $(btn.getAttribute("data-hide"));
      if (on) { on.hidden = false; }
      if (off) { off.hidden = true; }
      $$("button", btn.parentNode).forEach(function (b) { b.setAttribute("aria-pressed", b === btn ? "true" : "false"); });
    });
  });

  /* amplicon tooltip */
  var tip = $("#tip"), host = $("#amp-rows");
  if (host && tip) {
    var names = [];
    try { names = JSON.parse(host.getAttribute("data-amps")); } catch (e) { names = []; }
    host.addEventListener("mousemove", function (e) {
      var svg = e.target.closest ? e.target.closest("svg.am") : null;
      if (!svg) { tip.hidden = true; return; }
      var box = svg.getBoundingClientRect();
      var i = Math.floor((e.clientX - box.left) / box.width * names.length);
      var vals = svg.getAttribute("data-v").split(",");
      if (i < 0 || i >= names.length) { tip.hidden = true; return; }
      var row = svg.parentNode.getAttribute("data-sample");
      tip.textContent = row + " / " + names[i] + ": " + (vals[i] === "" ? "no data" : vals[i] + "x");
      tip.style.left = Math.min(e.clientX + 12, window.innerWidth - 330) + "px";
      tip.style.top = (e.clientY + 14) + "px";
      tip.hidden = false;
    });
    host.addEventListener("mouseleave", function () { tip.hidden = true; });
  }

  /* print: expand collapsed details */
  window.addEventListener("beforeprint", function () { $$("details").forEach(function (d) { d.open = true; }); });
})();
</script>
{% if extras %}
<script>
(function () {
  "use strict";
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  /* long tables: "show all" button; an active filter searches every row */
  $$("button.showall").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var scope = $(btn.getAttribute("data-target"));
      var table = scope && $("table.capped", scope);
      if (!table) { return; }
      var on = table.classList.toggle("show-more");
      btn.textContent = on ? "Show fewer rows" : btn.getAttribute("data-label");
    });
    btn.setAttribute("data-label", btn.textContent);
  });
  $$(".filterbar").forEach(function (bar) {
    var scope = $(bar.getAttribute("data-scope"));
    if (!scope || !$("table.capped", scope)) { return; }
    var update = function () {
      var active = false;
      $$("input,select", bar).forEach(function (c) {
        if (c.type === "checkbox" ? c.checked : c.value !== "") { active = true; }
      });
      scope.classList.toggle("filtering", active);
    };
    $$("input,select", bar).forEach(function (c) { c.addEventListener("input", update); c.addEventListener("change", update); });
  });

  /* time series: resolution, weighting and site selector */
  var root = $("#ts-root");
  if (root) {
    var state = { level: root.getAttribute("data-level"), weight: root.getAttribute("data-weight"), site: "each" };
    var sel = $("#ts-site", root);
    var apply = function () {
      var shown = false;
      $$(".tsview", root).forEach(function (v) {
        var on = v.getAttribute("data-level") === state.level && v.getAttribute("data-weight") === state.weight;
        v.hidden = !on;
        if (on) { shown = true; }
        $$(".tspanel", v).forEach(function (p) {
          var key = p.getAttribute("data-site");
          p.hidden = state.site === "each" ? key === "__all__" : key !== state.site;
        });
      });
      $$("button[data-ts]", root).forEach(function (b) {
        b.setAttribute("aria-pressed", state[b.getAttribute("data-ts")] === b.getAttribute("data-v") ? "true" : "false");
      });
      return shown;
    };
    $$("button[data-ts]", root).forEach(function (b) {
      b.addEventListener("click", function () {
        var prev = state[b.getAttribute("data-ts")];
        state[b.getAttribute("data-ts")] = b.getAttribute("data-v");
        if (!apply()) { state[b.getAttribute("data-ts")] = prev; apply(); }
      });
    });
    if (sel) { sel.addEventListener("change", function () { state.site = sel.value; apply(); }); }
    apply();
  }
})();
</script>
{% endif %}
</body>
</html>
