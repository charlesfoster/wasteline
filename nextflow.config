/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    charlesfoster/wasteline Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input/output options
    input                      = null
    outdir                     = null
    mode                       = 'full'      // full | demix | aggregate | report | update_db
    previous_results           = null        // demix/aggregate: results dir(s) of an earlier run (comma-separated); read only
    demix_dir                  = null        // aggregate: directory of *.demix files
    results_dir                = null        // report: results dir of an earlier run
    include_negatives_in_aggregate = false   // keep negative controls in the aggregate and the plots
    include_low_confidence     = false       // keep low_confidence samples in the time series, growth rates, dashboard and site aggregation (D18)

    // Panels: several targets (pathogens) in one run
    panel                      = null        // built-in panel name (rsv | flu) or path to a panel CSV (target[,overrides]); excludes --pathogen/--fasta/--gff/--freyja_contig/--whole_genome
    targets                    = null        // comma-separated targets: demix/aggregate/report use only these targets of panel results
    panel_min_fragments        = 100         // a target is detected with at least this many read fragments (typing, uncalibrated)
    panel_min_breadth_pct      = 5           // ... and at least this % of its marker sequence covered
    panel_family_share_pct     = 5           // ... and, unless it is the top target of its family, at least this % of the family's fragments
    panel_mapq                 = 10          // a fragment counts for a target only with mapping quality >= this

    // Reference and primers (reference FASTA/GFF defaults live in conf/pathogens/<profile>.config, chosen by --pathogen)
    // pathogen, fasta, gff and the other per-pathogen facts are set by conf/pathogens/*.config: Nextflow 25.10's
    // strict config parser does not let an included file override a value set here (even null)
    whole_genome               = false       // influenza H1N1/H3N2/H5Nx/H5Nx-cattle: map to all eight segments instead of HA only (PLAN D25); HA is the demixed segment
    protocol                   = 'amplicon'  // amplicon | capture (probe-capture, e.g. Twist: no primer trimming)
    skip_primer_trimming       = false       // do not primer-trim (reads already trimmed); implied by protocol capture
    duplicates                 = 'auto'      // auto | mark | none: auto = mark for capture, none for amplicon
    primer_scheme              = null        // scheme name: bundled (assets/primer_schemes/, per pathogen) or in --primer_scheme_dir; null = the pathogen's default (SARS-CoV-2: qiagenv1, mode full, D14)
    primer_scheme_dir          = null        // directory of your own <name>.bed schemes, usable by name in --primer_scheme and the samplesheet (D26)
    primer_bed                 = null        // custom primer BED; overrides primer_scheme
    ivar_offset                = null        // ivar trim -x; null = 5 for the swift scheme, otherwise 0

    // Read trimming (fastp; defaults mirror the Snakemake pipeline)
    fastp_cut_front            = true
    fastp_cut_tail             = true
    fastp_trim_poly_x          = true
    fastp_correction           = true
    fastp_cut_mean_quality     = 20
    fastp_qualified_quality_phred = 20
    fastp_unqualified_percent_limit = 10
    fastp_length_required      = 50
    save_trimmed_reads         = false
    save_bam                   = true

    // Freyja data (barcodes): latest | container | <YYYY-MM-DD> | <MM_DD_YYYY-HH-MM> | <YYYY-MM-DDTHH-MM> | <dir> | <.csv/.feather>
    barcodes                   = 'latest'
    db_dir                     = null        // default: ~/.wasteline/db

    // Freyja
    freyja_minq                = 20
    freyja_varthresh           = 0.0
    freyja_eps                 = 0.001
    freyja_covcut              = 10
    freyja_depthcutoff         = 0
    freyja_adapt               = 0.0
    freyja_autoadapt           = false
    freyja_relaxedmrca         = false
    freyja_solver              = 'CLARABEL'
    freyja_confirmedonly       = false
    compare_barcodes           = null        // second Freyja dataset (same forms as --barcodes): demix again and compare
    freyja_boot                = false       // freyja boot: bootstrap intervals per lineage
    freyja_boot_n              = 100         // number of bootstraps
    freyja_boot_seed           = 0           // fixed seed: reruns give identical intervals
    freyja_plot_mincov         = null        // minimum genome coverage (%) for freyja plot, the time series, growth rates and dashboard. null = follow the pipeline (derived below)
    freyja_plot_config         = null        // Freyja plot config (YAML): colours of the plotted groups and custom lineage groups; null = Freyja's defaults
    freyja_plot_interval       = 'MS'        // time-aware plot (when collection dates are known): MS (month), W (week) or D (day)
    freyja_plot_windowsize     = 14          // rolling-average window (days) of the daily time-aware plot
    min_genome_coverage_for_demix = 50   // high-confidence threshold (D17): % of the genome at freyja_covcut; below it the sample is low_confidence or not demixed
    demix_floor_coverage       = 25          // D18: from this % up to the threshold a sample is demixed and flagged low_confidence; below it skipped. 0 disables the band

    // Coverage QC and negative controls (PLAN 5.9, 5.10)
    amplicon_min_depth         = 10          // an amplicon is dropped when its mean depth is below this
    qc_min_depth               = 10          // depth used for the PASS/WARN/FAIL coverage test
    qc_pass_min_pct            = 60          // PASS needs at least this % of the genome at qc_min_depth (D17: real wastewater, not clinical isolates)
    qc_fail_below_pct          = 30          // FAIL below this % of the genome at qc_min_depth
    qc_max_dropped_amplicons   = 1           // WARN (amplicon_dropout) when more amplicons than this dropped
    ntc_max_mapped_reads       = 1000        // negative control FAIL (ntc_reads) above this many mapped reads
    ntc_max_genome_coverage_pct = 10         // negative control FAIL above this % of the genome at >= 1x

    // QC checks (primer scheme match, dropout impact, unexplained mutations)
    primer_scheme_check        = true        // does the primer scheme match the reads? (amplicon protocol with trimming)
    primer_check_min_enrichment = 5          // read starts at primers must be this many times above chance for `ok`
    primer_check_min_hit_fraction = 0.05 // at least this fraction of reads must start at the declared scheme's primers (guards sparse schemes; 0 = off)
    primer_check_window        = 2           // bp around a primer 5' end that count as "at the primer"
    qc_min_primer_trimmed_pct  = 0           // WARN (low_primer_trimming) below this % of primer-trimmed reads; 0 = off
    dropout_impact             = true        // which lineage-informative sites do dropped amplicons hide?
    dropout_min_affect_abundance = 0.05   // a dropped amplicon raises the flag only when it hides DEFINING sites of a lineage detected at >= this
    dropout_min_abundance      = 0.01        // a lineage counts as detected at this abundance
    unexplained_mutations      = true        // frequent mutations that the demixed lineages do not predict
    unexplained_min_freq       = 0.05
    unexplained_min_excess     = 0.05
    unexplained_min_depth      = 20
    unexplained_min_alt_depth  = 10
    unexplained_min_recurrence = 2           // samples with the same unexplained mutation for `recurrent`
    unexplained_max_pvalue     = 1.67e-6     // binomial guard against depth noise (0.05 / 29903)

    // Surveillance outputs (collection dates in the samplesheet)
    timeseries                 = true        // freyja_timeseries.tsv when >= 2 distinct collection dates exist
    timeseries_min_abundance   = 0.0
    freyja_growth              = false       // freyja relgrowthrate (needs >= 4 dates spanning >= 14 days)
    freyja_growth_days         = 56
    freyja_growth_nboots       = 1000
    freyja_growth_seed         = 1
    freyja_growth_serial_interval = 5.5
    freyja_growth_grthresh     = 0.001
    freyja_growth_min_abundance = 0.01
    freyja_growth_min_dates    = 4
    freyja_growth_min_span_days = 14
    freyja_growth_scale_by_viral_load = false
    freyja_dash                = false       // freyja dash: interactive dashboard (its page loads styling from the internet)
    freyja_dash_title          = 'wasteline wastewater dashboard'
    freyja_dash_intro          = 'Lineage prevalence over time from wasteline.'

    // Lineage groups (on by default, bundled list) and site aggregation (off unless a CSV is given)
    lineage_summary_xlsx       = true        // also write summary/lineage_summary.xlsx (a formatted workbook of the CSV)
    lineage_summary_xlsx_decimals = 3        // decimals shown for abundances in the workbook (display only)
    lineage_summary            = true        // per-sample table of lineage groups (summary/lineage_summary.csv); false = off
    lineage_groups             = null        // CSV: group,include[,exclude][,in_total]; null = the bundled assets/lineage_groups.csv
    lineage_major_threshold    = 0.1         // abundance at/above which a lineage is listed as major
    lineage_min_abundance      = 0.001       // lineages below this are not listed (group sums still include them)
    lineage_summary_zeros      = 'blank'     // blank | zero: a group with no abundance
    lineage_summary_decimals   = 6
    site_aggregation           = null        // CSV: aggregate_name,site_name[,weight] -> summary/site_aggregates_*.tsv
    site_aggregation_period    = 'week'      // week | day
    site_aggregation_weights   = 'auto'      // auto | viral_load | equal | site_weight
    site_aggregation_min_sites = 1

    // Alignment and storage
    aligner                    = 'bwa'       // bwa | minibwa (experimental)
    bam_format                 = 'bam'       // bam | cram: format of the published alignments (Freyja always uses the BAM)

    // Consensus genomes (PLAN 5.11)
    skip_consensus             = false
    consensus_min_depth        = 10          // positions below this depth are masked (N)
    consensus_freq             = 0.75        // SNV ALT_FREQ needed to apply the alt allele
    indel_freq                 = 0.75        // indel ALT_FREQ needed to apply it
    consensus_min_alt_qual     = 20          // minimum ALT_QUAL of a call
    consensus_min_depth_variants = 10        // minimum TOTAL_DP at a variant (not the mask depth)
    consensus_iupac            = true        // IUPAC code for ambiguous SNVs; false leaves the reference base
    consensus_iupac_min_af     = 0.25        // SNV ALT_FREQ must be above this (and below consensus_freq)
    consensus_iupac_min_alt_reads = 5        // ALT_DP needed for an IUPAC code

    // Opt-in extras and report
    mutations_of_interest      = null        // CSV name,mutation (e.g. S:N501Y); frequency + depth per sample
    skip_report                = false
    report_anonymize           = 'none'      // none | paths | full: remove identifying strings from report_data.json / report.html (full also writes summary/sample_id_map.csv)
    annotate_variants          = false       // bcftools csq amino-acid consequences of the called variants

    // Boilerplate options
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Schema validation default options
    validate_params            = true

    // Set by the test profiles
    config_profile_name        = null
    config_profile_description = null
}

// --freyja_plot_mincov (null = follow the pipeline, D17/D18): every sample that was demixed AND is meant to be analysed appears.
// That is the high-confidence threshold, or with --include_low_confidence the floor of the low-confidence band (0 when the band is off).
// An explicit --freyja_plot_mincov wins (command-line and params-file values are not overridden by this block).
// The one place that derives it: conf/modules.config, the report and run_info.json all read params.freyja_plot_mincov.
params {
    freyja_plot_mincov = (params.include_low_confidence.toString() == 'true')
        ? ((params.demix_floor_coverage.toString().toFloat() > 0 && params.demix_floor_coverage.toString().toFloat() < params.min_genome_coverage_for_demix.toString().toFloat()) ? params.demix_floor_coverage.toString().toFloat() : 0.0)
        : params.min_genome_coverage_for_demix.toString().toFloat()
}

// Pathogen-specific defaults (reference, annotation, Freyja pathogen name), chosen by --pathogen (PLAN D22):
// conf/pathogens/<profile>.config, where the profile is the bundled one named in this map, else `generic`
// (the reference must then come from --fasta). Nothing in the pipeline hard-codes a pathogen outside these files.
// A panel run (--panel without --pathogen) loads `generic`: the targets and their facts come from assets/panels/registry.csv.
includeConfig "conf/pathogens/${['SARS-CoV-2': 'sars2', 'MEASLESgenome': 'measles', 'MPX': 'mpx', 'RSVa': 'rsva', 'RSVb': 'rsvb', 'H1N1': 'h1n1', 'H3N2': 'h3n2', 'FLU-B-VIC': 'flu_b_vic', 'H5Nx': 'h5nx', 'H5Nx-cattle': 'h5nx_cattle'].get(params.pathogen ?: (params.panel ? 'panel' : 'SARS-CoV-2'), 'generic')}.config"

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// No process may request more than this machine has, whatever its label asks for in conf/base.config
// (so the defaults also run on a laptop). Override with `process.resourceLimits` in a -c config.
process.resourceLimits = [
    cpus: Runtime.runtime.availableProcessors(),
    memory: ((java.lang.management.ManagementFactory.operatingSystemMXBean as com.sun.management.OperatingSystemMXBean).totalMemorySize * 9 / 10) as long,
    time: 240.h,
]

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // Freyja and most bioconda images are linux/amd64 only: emulate on Apple Silicon / arm64 hosts
        docker.runOptions       = '-u $(id -u):$(id -g)' + (System.getProperty('os.arch') in ['aarch64', 'arm64'] ? ' --platform=linux/amd64' : '')
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    locked {
        // Immutable image digests for every process (bin/lock_containers.py). Use with docker/singularity:
        //   nextflow run . -profile docker,locked ...
        // Process container overrides only, not params; has no effect with conda/mamba.
        includeConfig 'conf/containers.lock.config'
    }
    test      { includeConfig 'conf/test.config'      }
    test_stub { includeConfig 'conf/test_stub.config' }
    test_full { includeConfig 'conf/test_full.config' }
}



// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    // `process` and `container` let run_info.json record the image used by every process
    fields  = 'task_id,hash,native_id,process,name,status,exit,container,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'charlesfoster/wasteline'
    contributors    = [
        [
            name: 'Charles Foster',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/charlesfoster/wasteline'
    description     = """Wastewater SARS-CoV-2 lineage abundance pipeline (Illumina amplicon, Freyja)"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.6.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs = params.monochrome_logs
    // Help flags follow the snake_case convention (the typed params block in main.nf declares help, help_full, show_hidden);
    // nf-schema's defaults are --help, --helpFull and --showHidden, which the help text would otherwise advertise.
    help {
        shortParameter      = 'help'
        fullParameter       = 'help_full'
        showHiddenParameter = 'show_hidden'
        showHidden          = params.show_hidden
    }
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
