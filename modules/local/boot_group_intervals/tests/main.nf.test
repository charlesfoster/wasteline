nextflow_process {

    name "Test Process BOOT_GROUP_INTERVALS"
    script "../main.nf"
    process "BOOT_GROUP_INTERVALS"
    tag "modules"
    tag "modules_local"
    tag "boot_group_intervals"

    // The behaviour (hand-computed percentiles, failure without lineages.yml) is covered by
    // tests/python/test_boot_group_intervals.py.

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = []
                input[2] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups/samplesheet.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.intervals[0].toString()).readLines()[0] == 'sample\tgroup\tabundance\tlo\thi\tn_boot' },
                { assert snapshot(file(process.out.intervals[0].toString()).name).match() }
            )
        }
    }
}
