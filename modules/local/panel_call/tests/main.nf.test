nextflow_process {

    name "Test Process PANEL_CALL"
    script "../main.nf"
    process "PANEL_CALL"
    tag "modules"
    tag "modules_local"
    tag "panel_call"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1', sample_type:'sample' ], file("\$projectDir/assets/samplesheet.csv") ]
                input[1] = file("\$projectDir/assets/schema_input.json")
                input[2] = 100
                input[3] = 5
                input[4] = 5
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.targets.collect { m, f -> [ m, file(f.toString()).name ] }).match() }
            )
        }
    }
}
