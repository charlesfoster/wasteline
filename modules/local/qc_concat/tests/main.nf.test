nextflow_process {

    name "Test Process QC_CONCAT"
    script "../main.nf"
    process "QC_CONCAT"
    tag "modules"
    tag "modules_local"
    tag "qc_concat"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id: 'T', target: [ name: 'T' ] ], [ file("\$projectDir/tests/fixtures/qc/concat/S_A.qc_row.tsv") ], [ file("\$projectDir/tests/fixtures/qc/concat/S_A.amplicon_coverage.tsv") ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.qc_summary, process.out.amplicon_coverage).match() }
            )
        }
    }
}
