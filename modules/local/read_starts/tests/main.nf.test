nextflow_process {

    name "Test Process READ_STARTS"
    script "../main.nf"
    process "READ_STARTS"
    tag "modules"
    tag "modules_local"
    tag "read_starts"
    tag "samtools"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/tests/fixtures/qc/read_starts_mini.bam") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1].toString().endsWith('S_1.read_starts.tsv') },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }

    test("5' ends: strands, soft clips, D/N/=/X, excluded flags - real") {

        // fixture: 11 records. Unmapped, secondary and supplementary are dropped; the rest give
        // (+,100) (-,239: 10S40M5S) (-,341: 20M2D10M3I10M) (+,500: 5S45M) (-,1149: 30M100N20M)
        // (-,449: flag 83) (+,450: flag 163) (-,649: 10=1X39=)
        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'MINI' ], file("\$projectDir/tests/fixtures/qc/read_starts_mini.bam") ]
                """
            }
        }

        then {
            def got = new File(process.out.tsv[0][1].toString()).readLines()
            def want = new File("${projectDir}/tests/fixtures/qc/read_starts_mini.expected.tsv").readLines()
            assertAll(
                { assert process.success },
                { assert got == want }
            )
        }
    }

    test("a real BAM slice (PURE_C): header plus one line per primary mapped read - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'PURE_C' ], file("\$projectDir/tests/fixtures/modules_phase3/PURE_C.slice.bam") ]
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0][1].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert lines[0] == 'strand\tfive_prime_pos' },
                { assert lines.size() - 1 == 697 },          // flagstat of the slice: 697 primary mapped (see the QC_SAMPLE test)
                { assert lines.drop(1).every { it ==~ /[+-]\t\d+/ } }
            )
        }
    }

    test("an empty BAM gives a header-only table - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'EMPTY' ], file("\$projectDir/tests/fixtures/qc/read_starts_empty.bam") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.tsv[0][1].toString()).readLines() == ['strand\tfive_prime_pos'] }
            )
        }
    }
}
