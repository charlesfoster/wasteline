nextflow_process {

    name "Test Process PRIMER_SCHEME_CHECK"
    script "../main.nf"
    process "PRIMER_SCHEME_CHECK"
    tag "modules"
    tag "modules_local"
    tag "primer_scheme_check"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/tests/fixtures/qc/PURE_C.read_starts.tsv") ]
                input[1] = 'midnight'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.summary[0][1].toString().endsWith('S_1.primer_scheme_summary.tsv') },
                { assert snapshot(process.out.tsv, process.out.summary).match() }
            )
        }
    }

    test("midnight reads, declared midnight: ok, all nine schemes scored - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'PURE_C' ], file("\$projectDir/tests/fixtures/qc/PURE_C.read_starts.tsv") ]
                input[1] = 'midnight'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = []
                """
            }
        }

        then {
            def detail = new File(process.out.tsv[0][1].toString()).readLines()*.split('\t', -1)
            def summ = new File(process.out.summary[0][1].toString()).readLines()
            def row = [summ[0].split('\t') as List, summ[1].split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] }
            assertAll(
                { assert process.success },
                { assert detail.size() == 10 },                       // header + 9 bundled schemes
                { assert row.sample == 'PURE_C' },
                { assert row.declared_scheme == 'midnight' },
                { assert row.scheme_check == 'ok' },
                { assert row.best_scheme == 'midnight/midnightv2' },
                { assert (row.declared_enrichment as double) > 30 }
            )
        }
    }

    test("midnight reads, declared articv4.1 (wrong): mismatch with best midnight - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'PURE_C' ], file("\$projectDir/tests/fixtures/qc/PURE_C.read_starts.tsv") ]
                input[1] = 'articv4.1'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = []
                """
            }
        }

        then {
            def summ = new File(process.out.summary[0][1].toString()).readLines()
            def row = [summ[0].split('\t') as List, summ[1].split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] }
            assertAll(
                { assert process.success },
                { assert row.scheme_check == 'mismatch' },
                { assert row.reason == 'best_other_scheme' },
                { assert row.best_scheme == 'midnight/midnightv2' },
                { assert (row.declared_enrichment as double) < 5 }
            )
        }
    }

    test("randomly fragmented reads (no primer anchoring): uninformative, not an error - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'UNANCHORED' ], file("\$projectDir/tests/fixtures/qc/UNANCHORED.read_starts.tsv") ]
                input[1] = 'midnight'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = []
                """
            }
        }

        then {
            def summ = new File(process.out.summary[0][1].toString()).readLines()
            def row = [summ[0].split('\t') as List, summ[1].split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] }
            assertAll(
                { assert process.success },
                { assert row.scheme_check == 'uninformative' },
                { assert row.best_scheme == 'NA' }
            )
        }
    }

    test("too few reads: NA - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ [ id:'FEW' ], file("\$projectDir/tests/fixtures/qc/read_starts_mini.expected.tsv") ]
                input[1] = 'midnight'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = []
                """
            }
        }

        then {
            def summ = new File(process.out.summary[0][1].toString()).readLines()
            def row = [summ[0].split('\t') as List, summ[1].split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] }
            assertAll(
                { assert process.success },
                { assert row.scheme_check == 'NA' },
                { assert row.reason == 'too_few_reads' }
            )
        }
    }

    test("a custom BED is the declared scheme (named by its file stem) and ext.args apply - real") {

        tag "docker"
        config "./ext_min_enrichment.config"
        when {
            process {
                """
                input[0] = [ [ id:'PURE_C' ], file("\$projectDir/tests/fixtures/qc/PURE_C.read_starts.tsv") ]
                input[1] = 'ignored'
                input[2] = file("\$projectDir/assets/primer_schemes")
                input[3] = file("\$projectDir/assets/primer_schemes/midnight.bed")
                """
            }
        }

        then {
            def summ = new File(process.out.summary[0][1].toString()).readLines()
            def row = [summ[0].split('\t') as List, summ[1].split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] }
            assertAll(
                { assert process.success },
                { assert row.declared_scheme == 'midnight' },
                { assert row.scheme_check == 'uninformative' }      // --min-enrichment 100000 cannot be reached
            )
        }
    }
}
