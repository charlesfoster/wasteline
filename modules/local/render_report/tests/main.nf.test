nextflow_process {

    name "Test Process RENDER_REPORT"
    script "../main.nf"
    process "RENDER_REPORT"
    tag "modules"
    tag "modules_local"
    tag "render_report"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id: 'T', target: [ name: 'T' ] ], file("\$projectDir/tests/fixtures/modules_report/minimal/report_data.json") ]
                input[1] = file("\$projectDir/assets/templates/report.html.j2")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html[0][1].toString().endsWith('report.html') }
            )
        }
    }
}
