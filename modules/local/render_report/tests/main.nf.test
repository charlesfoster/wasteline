nextflow_process {

    name "Test Process RENDER_REPORT"
    script "../main.nf"
    process "RENDER_REPORT"
    tag "modules"
    tag "modules_local"
    tag "render_report"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/modules_report/minimal/report_data.json")
                input[1] = file("\$projectDir/assets/templates/report.html.j2")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html[0].toString().endsWith('report.html') }
            )
        }
    }

    test("full report_data.json renders an offline report with the barcode version - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/modules_report/a_full/report_data.json")
                input[1] = file("\$projectDir/assets/templates/report.html.j2")
                """
            }
        }

        then {
            def html = new File(process.out.html[0].toString()).text
            assertAll(
                { assert process.success },
                { assert html.contains('<html') },
                { assert html.contains('09_17_2026-00-46') },
                { assert html.contains('WW_001') },
                { assert !html.contains('http://') },
                { assert !html.contains('https://') }
            )
        }
    }

    test("minimal (demix mode) report_data.json renders - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/modules_report/minimal/report_data.json")
                input[1] = file("\$projectDir/assets/templates/report.html.j2")
                """
            }
        }

        then {
            def html = new File(process.out.html[0].toString()).text
            assertAll(
                { assert process.success },
                { assert html.contains('09_17_2026-00-46') },
                { assert !html.contains('http://') },
                { assert !html.contains('https://') }
            )
        }
    }
}
