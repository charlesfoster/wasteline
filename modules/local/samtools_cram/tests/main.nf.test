nextflow_process {

    name "Test Process SAMTOOLS_CRAM"
    script "../main.nf"
    process "SAMTOOLS_CRAM"
    tag "modules"
    tag "modules_local"
    tag "samtools_cram"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/schema_input.json") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.cram.collect { m, c, i -> [ file(c.toString()).name, file(i.toString()).name ] }).match() }
            )
        }
    }

    // The fixture is the real mapped, sorted BAM of the synthetic dataset (2270 reads). The reference-based
    // CRAM must be smaller and be indexed; tests/roundtrip.nf.test checks that it decodes to the same reads.
    test("BAM -> indexed, smaller CRAM - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = [ [ id:'MIX_A' ], file("\$projectDir/tests/fixtures/markdup/MIX_A_1_4000.bam"), file("\$projectDir/tests/fixtures/markdup/MIX_A_1_4000.bam.bai") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[2] = []
                """
            }
        }

        then {
            def cram = file(process.out.cram[0][1].toString())
            def bamSize = file("${projectDir}/tests/fixtures/markdup/MIX_A_1_4000.bam").size()
            assertAll(
                { assert process.success },
                { assert cram.name == 'MIX_A.primertrimmed.cram' },
                { assert file(process.out.cram[0][2].toString()).name == 'MIX_A.primertrimmed.cram.crai' },
                { assert file(process.out.cram[0][2].toString()).size() > 0 },
                { assert cram.size() > 0 && cram.size() < bamSize },
                { assert process.out.versions_samtools[0][2] ==~ /\d+\.\d+.*/ }
            )
        }
    }

    // A sample without mapped reads (a clean negative control) must not stop the run
    test("a header-only BAM gives an empty, indexed CRAM - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = [ [ id:'EMPTY' ], file("\$projectDir/tests/fixtures/markdup/EMPTY.bam"), file("\$projectDir/tests/fixtures/markdup/EMPTY.bam.bai") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.cram[0][1].toString()).exists() },
                { assert file(process.out.cram[0][2].toString()).exists() }
            )
        }
    }
}
