nextflow_process {

    name "Test Process FREYJA_DATASET_INFO"
    script "../main.nf"
    process "FREYJA_DATASET_INFO"
    tag "modules"
    tag "modules_local"
    tag "freyja_dataset_info"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: params.pathogen, target: [ freyja_pathogen: params.pathogen, sample_sub: '', summary_sub: '' ] ],
                    file("\$projectDir/assets/references/NC_045512.fasta"),
                    'custom',
                    'somewhere',
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.freyja_data.collect { it[1] }, process.out.barcode_version.collect { it[1] }).match() }
            )
        }
    }
}
