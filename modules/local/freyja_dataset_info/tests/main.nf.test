nextflow_process {

    name "Test Process FREYJA_DATASET_INFO"
    script "../main.nf"
    process "FREYJA_DATASET_INFO"
    tag "modules"
    tag "modules_local"
    tag "freyja_dataset_info"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[1] = 'custom'
                input[2] = 'somewhere'
                input[3] = params.pathogen
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.freyja_data, process.out.barcode_version).match() }
            )
        }
    }
}
