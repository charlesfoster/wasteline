nextflow_process {

    name "Test Process DROPOUT_IMPACT"
    script "../main.nf"
    process "DROPOUT_IMPACT"
    tag "modules"
    tag "modules_local"
    tag "dropout_impact"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                def d = "\$projectDir/tests/fixtures/dropout_impact"
                input[0] = file("\$d/amplicon_coverage.tsv")
                input[1] = file("\$d/freyja_aggregated.tsv")
                input[2] = file("\$d/dataset")
                """
            }
        }

        then {
            def impact = new File(process.out.impact[0].toString()).readLines()
            def summary = new File(process.out.summary[0].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert impact.size() == 1 },       // header only
                { assert summary.size() == 1 },
                { assert snapshot(process.out.impact, process.out.summary).match() }
            )
        }
    }
}
