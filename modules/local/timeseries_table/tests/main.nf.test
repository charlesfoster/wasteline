nextflow_process {

    name "Test Process TIMESERIES_TABLE"
    script "../main.nf"
    process "TIMESERIES_TABLE"
    tag "modules"
    tag "modules_local"
    tag "timeseries_table"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out.table[0].toString()).readLines()).match() }
            )
        }
    }
}
