nextflow_process {

    name "Test Process SAMTOOLS_MARKDUP"
    script "../main.nf"
    process "SAMTOOLS_MARKDUP"
    tag "modules"
    tag "modules_local"
    tag "samtools_markdup"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/schema_input.json") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.bam.collect { m, b, i -> [ file(b.toString()).name, file(i.toString()).name ] }, process.out.stats.collect { m, f -> file(f.toString()).name }).match() }
            )
        }
    }
}
