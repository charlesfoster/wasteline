nextflow_process {

    name "Test Process CONSENSUS_STATS"
    script "../main.nf"
    process "CONSENSUS_STATS"
    tag "modules"
    tag "modules_local"
    tag "consensus_stats"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/tests/fixtures/modules_phase3/concat/S_A.consensus.fa"), [] ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1].toString().endsWith('S_1.consensus_stats.tsv') },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }

    test("full-length consensus with 100 N, 3 '-' and 2 ambiguity codes - real") {

        tag "docker"
        when {
            process {
                """
                def ref = new File("\$projectDir/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
                def chars = ref.toCharArray()
                (100..199).each { chars[it] = 'N' as char }
                (300..302).each { chars[it] = '-' as char }
                chars[400] = 'R' as char
                chars[401] = 'Y' as char
                def fasta = new File("\${launchDir}/S_1.consensus.fa")
                fasta.text = '>S_1\\n' + new String(chars).toList().collate(60).collect { it.join('') }.join('\\n') + '\\n'
                input[0] = [ [ id:'S_1' ], file(fasta.toString()), [] ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0][1].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert lines[0] == 'sample\tlength\tn_count\tn_pct\tambiguous_count\tstatus\treason' },
                { assert lines[1] == 'S_1\t29903\t103\t0.34\t2\tok\tNA' }
            )
        }
    }

    test("all-N consensus is status empty - real") {

        tag "docker"
        when {
            process {
                """
                def fasta = new File("\${launchDir}/E_1.consensus.fa")
                fasta.text = '>E_1\\n' + ('N' * 29903).toList().collate(60).collect { it.join('') }.join('\\n') + '\\n'
                input[0] = [ [ id:'E_1' ], file(fasta.toString()), [] ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.tsv[0][1].toString()).readLines()[1] == 'E_1\t29903\t29903\t100.00\t0\tempty\tconsensus contains only N or - characters' }
            )
        }
    }

    test("unreadable consensus is reported as failed, not a crash - real") {

        tag "docker"
        when {
            process {
                """
                def fasta = new File("\${launchDir}/F_1.consensus.fa")
                fasta.text = ''
                input[0] = [ [ id:'F_1' ], file(fasta.toString()), [] ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.tsv[0][1].toString()).readLines()[1] == 'F_1\tNA\tNA\tNA\tNA\tfailed\tF_1.consensus.fa: no FASTA record' }
            )
        }
    }

    test("status JSON failed wins over the all-N sequence and its reason is reported - real") {

        tag "docker"
        when {
            process {
                """
                def fasta = new File("\${launchDir}/J_1.consensus.fa")
                fasta.text = '>J_1\\n' + ('N' * 29903).toList().collate(60).collect { it.join('') }.join('\\n') + '\\n'
                def json = new File("\${launchDir}/J_1.consensus_status.json")
                json.text = '{"sample": "J_1", "status": "failed", "reason": "bcftools consensus failed: REF mismatch", "warnings": []}\\n'
                input[0] = [ [ id:'J_1' ], file(fasta.toString()), file(json.toString()) ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.tsv[0][1].toString()).readLines()[1] == 'J_1\t29903\t29903\t100.00\t0\tfailed\tbcftools consensus failed: REF mismatch' }
            )
        }
    }

    test("status JSON ok with warnings: computed status, warning text as reason - real") {

        tag "docker"
        when {
            process {
                """
                def ref = new File("\$projectDir/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
                def fasta = new File("\${launchDir}/W_1.consensus.fa")
                fasta.text = '>W_1\\n' + ref.toList().collate(60).collect { it.join('') }.join('\\n') + '\\n'
                def json = new File("\${launchDir}/W_1.consensus_status.json")
                json.text = '{"sample": "W_1", "status": "ok", "reason": "1 variant(s) not applied: skipped variant at NC_045512.2:11287 (REF mismatch)", "warnings": ["skipped variant at NC_045512.2:11287 (REF mismatch)"]}\\n'
                input[0] = [ [ id:'W_1' ], file(fasta.toString()), file(json.toString()) ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.tsv[0][1].toString()).readLines()[1] == 'W_1\t29903\t0\t0.00\t0\tok\t1 variant(s) not applied: skipped variant at NC_045512.2:11287 (REF mismatch)' }
            )
        }
    }
}
