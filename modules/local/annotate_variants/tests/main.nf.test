nextflow_process {

    name "Test Process ANNOTATE_VARIANTS"
    script "../main.nf"
    process "ANNOTATE_VARIANTS"
    tag "modules"
    tag "modules_local"
    tag "annotate_variants"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/schema_input.json") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[2] = file("\$projectDir/assets/references/NC_045512.gff3")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.tsv[0][1].toString()).name == 'S_1.annotated.tsv' },
                { assert snapshot(process.out.tsv.collect { m, f -> file(f.toString()).readLines()[0] }).match() }
            )
        }
    }
}
