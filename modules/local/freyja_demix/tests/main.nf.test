nextflow_process {

    name "Test Process FREYJA_DEMIX"
    script "../main.nf"
    process "FREYJA_DEMIX"
    tag "modules"
    tag "modules_local"
    tag "freyja_demix"

    // Real runs use the dataset bundled in the pinned Freyja container (FREYJA_UPDATE container)
    // and depths/variants files written by the tests themselves.

    test("low coverage -> skipped_low_coverage, with barcode version - real") {

        tag "docker"
        setup {
            run("FREYJA_UPDATE") {
                script "../../freyja_update/main.nf"
                process {
                    """
                    input[0] = 'container'
                    """
                }
            }
        }

        when {
            process {
                """
                def depths = new File("\${launchDir}/low.depths")
                depths.text = (1..100).collect { "ref\\t\${it}\\tA\\t0" }.join('\\n') + '\\n'
                def variants = new File("\${launchDir}/low.variants.tsv")
                variants.text = 'REGION\\tPOS\\tREF\\tALT\\tREF_DP\\tREF_RV\\tREF_QUAL\\tALT_DP\\tALT_RV\\tALT_QUAL\\tALT_FREQ\\tTOTAL_DP\\tPVAL\\tPASS\\n'
                def version = new File("\${launchDir}/barcode_version.json")
                version.text = '{"barcode_version": "09_17_2026-00-46", "barcode_version_iso": "2026-09-17T00-46"}'
                input[0] = [ [ id:'LOW_1' ], file(variants.toString()), file(depths.toString()) ]
                input[1] = FREYJA_UPDATE.out.dataset
                input[2] = file(version.toString())
                """
            }
        }

        then {
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert status.sample == 'LOW_1' },
                { assert status.status == 'skipped_low_coverage' },
                { assert status.reason },
                { assert status.barcode_version == '09_17_2026-00-46' },
                { assert status.barcode_version_iso == '2026-09-17T00-46' },
                { assert process.out.demix.size() == 0 }
            )
        }
    }

    test("demix crash is recorded as failed, never fatal - real") {

        tag "docker"
        setup {
            run("FREYJA_UPDATE") {
                script "../../freyja_update/main.nf"
                process {
                    """
                    input[0] = 'container'
                    """
                }
            }
        }

        when {
            process {
                """
                // Plenty of depth but a header-only variants file: freyja demix crashes on it
                def depths = new File("\${launchDir}/high.depths")
                depths.text = (1..100).collect { "ref\\t\${it}\\tA\\t50" }.join('\\n') + '\\n'
                def variants = new File("\${launchDir}/high.variants.tsv")
                variants.text = 'REGION\\tPOS\\tREF\\tALT\\tREF_DP\\tREF_RV\\tREF_QUAL\\tALT_DP\\tALT_RV\\tALT_QUAL\\tALT_FREQ\\tTOTAL_DP\\tPVAL\\tPASS\\n'
                def version = new File("\${launchDir}/barcode_version.json")
                version.text = '{"barcode_version": "09_17_2026-00-46", "barcode_version_iso": "2026-09-17T00-46"}'
                input[0] = [ [ id:'CRASH_1' ], file(variants.toString()), file(depths.toString()) ]
                input[1] = FREYJA_UPDATE.out.dataset
                input[2] = file(version.toString())
                """
            }
        }

        then {
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert status.status == 'failed' },
                { assert status.reason.startsWith('freyja demix failed') },
                { assert status.barcode_version == '09_17_2026-00-46' },
                { assert process.out.demix.size() == 0 }
            )
        }
    }

    test("legacy gzipped variants and depths with a legacy file name give the same demix as plain files - real") {

        tag "docker"

        when {
            process {
                """
                def version = new File("\${launchDir}/barcode_version.json")
                version.text = '{"barcode_version": "custom", "barcode_version_iso": null}'
                input[0] = [
                    [ id:'PURE_C' ],
                    file("\$projectDir/tests/fixtures/demix_legacy/PURE_C/variants/PURE_C.freyja_variants.tsv.gz"),
                    file("\$projectDir/tests/fixtures/demix_legacy/PURE_C/freyja/PURE_C.depths.gz"),
                ]
                input[1] = file("\$projectDir/tests/data/barcodes_test.csv")
                input[2] = file(version.toString())
                """
            }
        }

        then {
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert status.status == 'ok' },
                // the label inside the file is <sample>.variants.tsv whatever the input was called
                { assert new File(process.out.demix[0][1].toString()).bytes == new File("${projectDir}/tests/fixtures/demix_expected/PURE_C.demix").bytes }
            )
        }
    }

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/references/NC_045512.fasta") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.gff3")
                input[2] = file("\$projectDir/assets/schema_input.json")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.demix, process.out.status).match() }
            )
        }
    }
}
