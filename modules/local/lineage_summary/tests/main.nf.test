nextflow_process {

    name "Test Process LINEAGE_SUMMARY"
    script "../main.nf"
    process "LINEAGE_SUMMARY"
    tag "modules"
    tag "modules_local"
    tag "lineage_summary"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = []
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.sites.isEmpty() },
                // the stub leaves an empty placeholder: a stub run needs no python
                { assert file(process.out.xlsx[0].toString()).name == 'lineage_summary.xlsx' },
                { assert snapshot(
                    file(process.out.summary[0].toString()).name,
                    file(process.out.resolved[0].toString()).name,
                    file(process.out.xlsx[0].toString()).name
                ).match() }
            )
        }
    }
}
