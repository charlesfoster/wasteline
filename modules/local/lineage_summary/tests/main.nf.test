nextflow_process {

    name "Test Process LINEAGE_SUMMARY"
    script "../main.nf"
    process "LINEAGE_SUMMARY"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "lineage_summary"

    // Hand-made hierarchy and samples in tests/fixtures/lineage_groups (see bin/lineage_groups.py and
    // tests/python/test_lineage_groups.py for the full behaviour matrix). ext.args for these tests:
    // --decimals 4 --major-threshold 0.2 (see ./nextflow.config); that config also asks for the xlsx
    // (--xlsx-out lineage_summary.xlsx), nextflow_no_xlsx.config does not.

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = []
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.sites.isEmpty() },
                // the stub leaves an empty placeholder: a stub run needs no python
                { assert file(process.out.xlsx[0].toString()).name == 'lineage_summary.xlsx' },
                { assert snapshot(
                    file(process.out.summary[0].toString()).name,
                    file(process.out.resolved[0].toString()).name,
                    file(process.out.xlsx[0].toString()).name
                ).match() }
            )
        }
    }

    test("stub with site aggregates") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = file("\$projectDir/tests/fixtures/lineage_groups/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_freyja.tsv")
                input[6] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_meta.tsv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.sites[0].toString()).readLines()[0].startsWith('aggregate_name,period') },
                { assert snapshot(
                    file(process.out.summary[0].toString()).name,
                    file(process.out.sites[0].toString()).name
                ).match() }
            )
        }
    }

    test("fixture samples: groups, statuses, negatives, audit - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = file("\$projectDir/tests/fixtures/lineage_groups/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            def lines = file(process.out.summary[0].toString()).readLines()
            def header = lines[0]
            def rows = lines.drop(1)
            def main = rows.find { l -> l.startsWith('Site_1_week_2,') }
            def audit = file(process.out.resolved[0].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.sites.isEmpty() },
                // quoted group name with a comma, 8 groups in file order, then the fixed tail
                { assert header.startsWith('sample,site,collection_date,status,genome_coverage_pct,BA.2.86* (excludes JN.1*),BA.2.86* (includes JN.1*),JN.1* (excludes KP.3*),JN.1* (includes KP.3*),KP.3*,NB.1.8* (alias XAA.1.7.8*),"Old Omicron, B.1.1.529* only",Recombinants (excludes NB.1*),other,proportion_summary,major_lineages,') },
                // NEG_1 is a negative control (samplesheet), so 6 samples remain, sorted
                { assert rows.collect { l -> l.split(',')[0] } == ['ALLX_3', 'FAIL_5', 'LOW_6', 'MISS_7', 'Mixed_4', 'NOAGG_8', 'Site_1_week_2'] },
                // --decimals 4, --major-threshold 0.2: BA.5 (0.10) is minor; ZZ.9 (unknown to the hierarchy) is below min-abundance
                { assert main == 'Site_1_week_2,Site_1,2026-01-12,ok,93.06,,0.8000,0.5500,0.8000,0.2500,0.0195,0.1000,0.0500,0.0305,1.0000,JN.1.16 KP.3.1,0.5500 0.2500,BA.5 XAA.1.1 A.1 NB.1.8,0.1000 0.0500 0.0300 0.0195,A.1:0.0300,' },
                { assert rows.find { l -> l.startsWith('LOW_6,') }.startsWith('LOW_6,Site_1,2026-01-08,skipped_low_coverage,12.50,,,,,,,,,,,,,,,,') },
                { assert audit[0] == 'group\tinclude\texclude\tin_total\tn_lineages_matched\twarnings\tdataset_version\tgroups_sha256' },
                { assert audit.size() == 9 },
                { assert audit[1].startsWith('BA.2.86* (excludes JN.1*)\tBA.2.86*\tJN.1*\tyes\t2\t\t01_02_2026-03-04\t') }
            )
        }
    }

    test("site aggregates give a second table - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = []
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_freyja.tsv")
                input[6] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_meta.tsv")
                """
            }
        }

        then {
            def lines = file(process.out.sites[0].toString()).readLines()
            def samples = file(process.out.summary[0].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert lines[0].startsWith('aggregate_name,period,period_start,n_sites_included,sites_included,sites_missing,weight_basis,BA.2.86* (excludes JN.1*),') },
                { assert lines.size() == 4 },
                { assert lines[1] == 'Catchment_X,2026-W02,2026-01-05,2,Site_1;Site_2,,viral_load,,0.8000,0.5000,0.8000,0.3000,,,0.2000,,1.0000,JN.1.16 KP.3 XAA.1,0.5000 0.3000 0.2000,,,' },
                // without a samplesheet the negative control is kept and site/date are blank
                { assert samples.any { l -> l.startsWith('NEG_1,,,ok,') } }
            )
        }
    }

    test("xlsx workbook is a valid package with the expected sheets - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = file("\$projectDir/tests/fixtures/lineage_groups/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_freyja.tsv")
                input[6] = file("\$projectDir/tests/fixtures/lineage_groups/site_aggregates_meta.tsv")
                """
            }
        }

        then {
            def zip = new java.util.zip.ZipFile(file(process.out.xlsx[0].toString()))
            def parts = zip.entries().toList().collect { e -> e.name }
            def sheetNames = (zip.getInputStream(zip.getEntry('xl/workbook.xml')).text =~ /<sheet name="([^"]*)"/).collect { m -> m[1] }
            def sheet1 = zip.getInputStream(zip.getEntry('xl/worksheets/sheet1.xml')).text
            def csvRows = file(process.out.summary[0].toString()).readLines()
            zip.close()
            assertAll(
                { assert process.success },
                { assert parts[0] == '[Content_Types].xml' },
                { assert parts.containsAll(['_rels/.rels', 'xl/workbook.xml', 'xl/_rels/workbook.xml.rels', 'xl/styles.xml']) },
                { assert parts.findAll { p -> p.startsWith('xl/worksheets/sheet') }.size() == 5 },
                { assert sheetNames == ['Lineage summary', 'Ungrouped lineages', 'Site aggregates', 'Groups used', 'About'] },
                // the sheet carries the CSV's header and every row (+ the header row)
                { assert sheet1.contains('<dimension ref="A1:U' + csvRows.size() + '"/>') },
                { assert !sheet1.contains('<f>') },
                // the CSV outputs are the same with the xlsx switched on
                { assert csvRows[0].startsWith('sample,site,collection_date,status,genome_coverage_pct,BA.2.86* (excludes JN.1*),') },
                { assert file(process.out.sites[0].toString()).readLines().size() == 4 }
            )
        }
    }

    test("no xlsx unless ext.args asks for it, and the CSV is unchanged - real") {

        tag "docker"
        config "./nextflow_no_xlsx.config"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = file("\$projectDir/tests/fixtures/lineage_groups/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            def main = file(process.out.summary[0].toString()).readLines().find { l -> l.startsWith('Site_1_week_2,') }
            assertAll(
                { assert process.success },
                { assert process.out.xlsx.isEmpty() },
                { assert main == 'Site_1_week_2,Site_1,2026-01-12,ok,93.06,,0.8000,0.5500,0.8000,0.2500,0.0195,0.1000,0.0500,0.0305,1.0000,JN.1.16 KP.3.1,0.5500 0.2500,BA.5 XAA.1.1 A.1 NB.1.8,0.1000 0.0500 0.0300 0.0195,A.1:0.0300,' }
            )
        }
    }

    test("an empty groups file fails with a friendly message - real") {

        tag "docker"

        when {
            process {
                """
                def empty = new File("\${launchDir}/empty_groups.csv")
                empty.text = ''
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups/demix_status.tsv")
                input[2] = []
                input[3] = file(empty.toString())
                input[4] = file("\$projectDir/tests/fixtures/lineage_groups")
                input[5] = []
                input[6] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('is empty') }
            )
        }
    }
}
