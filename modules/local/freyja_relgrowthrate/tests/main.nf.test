nextflow_process {

    name "Test Process FREYJA_RELGROWTHRATE"
    script "../main.nf"
    process "FREYJA_RELGROWTHRATE"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "freyja_relgrowthrate"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[2] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.growth_rates.collect { f -> file(f.toString()).name },
                    process.out.failed.size()
                ).match() }
            )
        }
    }

    // Synthetic dataset tests/data_timeseries: lineage XBB.1.5 rises and BA.2 declines logistically (true
    // log-odds slope 0.10 per day, serial interval 5.5 days, 8 weekly dates at 3 sites), JN.1 is stable.
    // Freyja fits each lineage against all the others, so the estimates are smaller than the true advantage
    // of XBB.1.5 over BA.2 (+73%); the real run gave XBB.1.5 about +60%, BA.2 about -35%, JN.1 about -1%.
    test("rising and declining lineage recovered, seeded bootstrap - real") {

        tag "docker"

        setup {
            run("FREYJA_UPDATE") {
                script "../../freyja_update/main.nf"
                process {
                    """
                    input[0] = 'container'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[2] = FREYJA_UPDATE.out.dataset
                """
            }
        }

        then {
            def inputs = new groovy.json.JsonSlurper().parseText(file(process.out.inputs[0].toString()).text)
            def rates = [:]
            file(process.out.growth_rates[0].toString()).readLines().drop(1).each { line ->
                def f = line.split(',', 2)
                rates[f[0]] = (f[1].split(',')[0] - '%') as double
            }
            assertAll(
                { assert process.success },
                { assert process.out.failed.size() == 0 },
                // negative control, undated and low-coverage sample are not counted
                { assert inputs.n_samples == 30 },
                { assert inputs.n_dates == 8 },
                { assert rates['XBB.1.5'] > 30 && rates['XBB.1.5'] < 120 },
                { assert rates['BA.2'] < -10 },
                { assert Math.abs(rates['JN.1']) < 15 }
            )
        }
    }

    // scale_by_viral_load needs a load on every sample: those without one (26 of 30 have one) are left out
    test("scaled by viral load keeps only samples with a load - real") {

        tag "docker"
        config "./scale.config"

        setup {
            run("FREYJA_UPDATE") {
                script "../../freyja_update/main.nf"
                process {
                    """
                    input[0] = 'container'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[2] = FREYJA_UPDATE.out.dataset
                """
            }
        }

        then {
            def inputs = new groovy.json.JsonSlurper().parseText(file(process.out.inputs[0].toString()).text)
            assertAll(
                { assert process.success },
                { assert process.out.failed.size() == 0 },
                { assert inputs.n_samples == 26 },
                { assert inputs.n_with_viral_load == 26 },
                { assert file(process.out.growth_rates[0].toString()).readLines().size() > 1 }
            )
        }
    }

    // Freyja itself would return its optimiser start value (+73.3%) for every lineage with a single date.
    test("too few dates: failure note, no table, run continues - real") {

        tag "docker"

        setup {
            run("FREYJA_UPDATE") {
                script "../../freyja_update/main.nf"
                process {
                    """
                    input[0] = 'container'
                    """
                }
            }
        }

        when {
            process {
                """
                def sheet = new File("\${launchDir}/three_dates.csv")
                def lines = new File("\$projectDir/tests/data_timeseries/samplesheet.csv").readLines()
                def keep = ['2026-01-05', '2026-01-12', '2026-01-19']
                sheet.text = ([lines[0]] + lines.drop(1).findAll { l -> keep.contains(l.split(',', -1)[3]) }).join('\\n') + '\\n'
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file(sheet.toString())
                input[2] = FREYJA_UPDATE.out.dataset
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.growth_rates.size() == 0 },
                { assert process.out.failed.size() == 1 },
                { assert file(process.out.failed[0].toString()).text.contains('insufficient data: 3 distinct collection date(s)') }
            )
        }
    }
}
