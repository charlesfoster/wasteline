nextflow_process {

    name "Test Process CONSENSUS_FILTER_VCF"
    script "../main.nf"
    process "CONSENSUS_FILTER_VCF"
    tag "modules"
    tag "modules_local"
    tag "consensus_filter_vcf"
    tag "ivar_variants_to_vcf"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/tests/fixtures/modules_phase3/PURE_C.depths.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.vcf[0][1].toString().endsWith('S_1.consensus_variants.vcf.gz') },
                { assert process.out.vcf[0][2].toString().endsWith('S_1.consensus_variants.vcf.gz.tbi') },
                { assert process.out.bed[0][1].toString().endsWith('S_1.called_variants.bed') },
                { assert snapshot(process.out.bed).match() }
            )
        }
    }

    test("PURE_C (JN.1): only the 115 confident variants survive - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    def tsv = new File("\${launchDir}/PURE_C.variants.tsv")
                    tsv.bytes = new java.util.zip.GZIPInputStream(new FileInputStream("\$projectDir/tests/fixtures/modules_phase3/PURE_C.variants.tsv.gz")).bytes
                    input[0] = [ [ id:'PURE_C' ], file(tsv.toString()) ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            def records = vcf.findAll { !it.startsWith('#') }.collect { it.split('\t') as List }
            def freq = { rec -> rec[9].split(':')[7] as double }
            def qual = { rec -> rec[9].split(':')[6] as double }
            def bed = new File(process.out.bed[0][1].toString()).readLines().collect { it.split('\t') as List }
            assertAll(
                { assert process.success },
                { assert records.size() == 115 },                     // truth.json: 115 JN.1 changes applied to the synthetic genome
                { assert records.every { freq(it) >= 0.75 } },
                { assert records.every { it[9].startsWith('1/1:') } },     // no IUPAC candidates in the JN.1 sample
                { assert records.every { qual(it) >= 20 } },
                { assert records.every { (it[7] - 'DP=') as int >= 10 } },
                { assert bed.size() == 115 },
                { assert bed[0] == ['NC_045512.2', '240', '241'] },   // C241T, BED is 0-based half-open
                { assert file(process.out.vcf[0][2].toString()).exists() }
            )
        }
    }

    test("thresholds: AF, ALT_QUAL, DP, indels and multi-allelic sites (synthetic) - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'SYN_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_indels.variants.tsv") ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            def recs = vcf.findAll { !it.startsWith('#') }.collect { it.split('\t') as List }
            def kept = recs.collect { it[1] as int }
            def genotypes = recs.collectEntries { [(it[1] as int): it[9].split(':')[0]] }
            assertAll(
                { assert process.success },
                // 1000 SNV AF .9, 2000 SNV AF .6 (IUPAC candidate, 0/1), 5000 SNV AF == .75, 10000 deletion AF .8,
                // 15000 insertion AF .9, 20000 major alt AF .8
                { assert kept == [1000, 2000, 5000, 10000, 15000, 20000] },
                { assert genotypes == [1000: '1/1', 2000: '0/1', 5000: '1/1', 10000: '1/1', 15000: '1/1', 20000: '1/1'] },
                // dropped: 3000 (ALT_QUAL 15), 4000 (DP 8), 12000 (deletion AF .5), 17000 (insertion AF .5), 20000 minor alt (AF .1)
                { assert new File(process.out.bed[0][1].toString()).readLines().size() == 6 }
            )
        }
    }

    test("header-only VCF gives an empty, valid, indexed VCF - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    def tsv = new File("\${launchDir}/EMPTY.variants.tsv")
                    tsv.text = 'REGION\\tPOS\\tREF\\tALT\\tREF_DP\\tREF_RV\\tREF_QUAL\\tALT_DP\\tALT_RV\\tALT_QUAL\\tALT_FREQ\\tTOTAL_DP\\tPVAL\\tPASS\\n'
                    input[0] = [ [ id:'EMPTY_1' ], file(tsv.toString()) ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            assertAll(
                { assert process.success },
                { assert vcf.findAll { !it.startsWith('#') }.size() == 0 },
                { assert new File(process.out.bed[0][1].toString()).length() == 0 },
                { assert file(process.out.vcf[0][2].toString()).exists() }
            )
        }
    }

    test("thresholds from ext (consensus_freq 0.5, min_depth 45) - real") {

        tag "docker"
        config "./ext_thresholds.config"

        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'SYN_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_indels.variants.tsv") ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            def kept = vcf.findAll { !it.startsWith('#') }.collect { (it.split('\t') as List)[1] as int }
            assertAll(
                { assert process.success },
                // SNV AF >= 0.5 and DP >= 45, indel AF >= 0.75: 1000, 2000 (AF .6), 10000 (deletion .8), 15000 (insertion .9), 20000 (.8)
                // 5000 (DP 40) and the AF .5 indels are out; 12000/17000 fail the indel AF
                { assert kept == [1000, 2000, 10000, 15000, 20000] }
            )
        }
    }

    test("IUPAC rules: AF 0.25-0.75 SNVs with >= 5 alt reads become 0/1, nothing else does (synthetic) - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'IUPAC_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_iupac.variants.tsv") ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            def genotypes = vcf.findAll { !it.startsWith('#') }.collectEntries { def f = it.split('\t') as List; [(f[1] as int): f[9].split(':')[0]] }
            assertAll(
                { assert process.success },
                // 6003 / 6500: AF 0.5, 12 alt reads -> ambiguous; 9018: AF 0.8 -> alt
                // dropped: 7007 (3 alt reads), 7501 (4 alt reads), 8001 (AF .2), 10002 (AF == .25), 11009 / 12000 (indels at AF .5, never IUPAC)
                { assert genotypes == [6003: '0/1', 6500: '0/1', 9018: '1/1'] }
            )
        }
    }

    test("IUPAC off (ext.iupac = false): only AF >= 0.75 is applied - real") {

        tag "docker"
        config "./ext_no_iupac.config"

        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'IUPAC_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_iupac.variants.tsv") ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                """
            }
        }

        then {
            def vcf = new java.util.zip.GZIPInputStream(new FileInputStream(process.out.vcf[0][1].toString())).text.readLines()
            def genotypes = vcf.findAll { !it.startsWith('#') }.collectEntries { def f = it.split('\t') as List; [(f[1] as int): f[9].split(':')[0]] }
            assertAll(
                { assert process.success },
                { assert genotypes == [9018: '1/1'] }
            )
        }
    }
}
