nextflow_process {

    name "Test Process FREYJA_UPDATE"
    script "../main.nf"
    process "FREYJA_UPDATE"
    tag "modules"
    tag "modules_local"
    tag "freyja_update"

    test("latest - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id: params.pathogen, target: [ freyja_pathogen: params.pathogen, freyja_container_pathogen: params.freyja_container_pathogen, sample_sub: '', summary_sub: '' ] ], 'latest' ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.dataset[0][1].toString()).name == '2000-01-01T00-00' },
                { assert snapshot(process.out.dataset.collect { file(it[1].toString()).name }).match() }
            )
        }
    }
}
