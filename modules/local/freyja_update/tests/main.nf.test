nextflow_process {

    name "Test Process FREYJA_UPDATE"
    script "../main.nf"
    process "FREYJA_UPDATE"
    tag "modules"
    tag "modules_local"
    tag "freyja_update"

    test("container snapshot - real (offline)") {

        tag "docker"
        when {
            process {
                """
                input[0] = 'container'
                """
            }
        }

        then {
            def dataset = file(process.out.dataset[0].toString())
            assertAll(
                { assert process.success },
                { assert dataset.isDirectory() },
                { assert new File(dataset.toString(), 'usher_barcodes.feather').length() > 0 },
                { assert new File(dataset.toString(), 'last_barcode_update.txt').text.trim() ==~ /\d{2}_\d{2}_\d{4}-\d{2}-\d{2}/ }
            )
        }
    }

    test("latest - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = 'latest'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.dataset[0].toString()).name == '2000-01-01T00-00' },
                { assert snapshot(process.out.dataset.collect { file(it.toString()).name }).match() }
            )
        }
    }

    test("container - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = 'container'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.dataset.collect { file(it.toString()).name }).match() }
            )
        }
    }
}
