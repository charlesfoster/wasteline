nextflow_process {

    name "Test Process BUILD_OVERVIEW"
    script "../main.nf"
    process "BUILD_OVERVIEW"
    tag "modules"
    tag "modules_local"
    tag "build_overview"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/overview/targets.tsv")
                input[1] = file("\$projectDir/tests/fixtures/overview/manifest.tsv")
                input[2] = [ file("\$projectDir/tests/fixtures/overview/RSVa/qc_summary.tsv") ]
                input[3] = file("\$projectDir/assets/templates/overview.html.j2")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.html[0].toString().endsWith('overview.html') }
            )
        }
    }
}
