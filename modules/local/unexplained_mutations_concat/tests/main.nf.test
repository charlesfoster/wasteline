nextflow_process {

    name "Test Process UNEXPLAINED_MUTATIONS_CONCAT"
    script "../main.nf"
    process "UNEXPLAINED_MUTATIONS_CONCAT"
    tag "modules"
    tag "modules_local"
    tag "unexplained_mutations_concat"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ file("\$projectDir/tests/fixtures/unexplained/concat/S_ONE.unexplained_mutations.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }

    test("recurrence across three samples; skipped sample contributes nothing - real") {

        tag "docker"
        when {
            process {
                """
                def d = "\$projectDir/tests/fixtures/unexplained/concat"
                input[0] = [ file("\$d/S_THREE.unexplained_mutations.tsv"), file("\$d/S_SKIPPED.unexplained_mutations.tsv"), file("\$d/S_ONE.unexplained_mutations.tsv"), file("\$d/S_TWO.unexplained_mutations.tsv") ]
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0].toString()).readLines()
            def rows = lines.drop(1).collect { it.split('\t') as List }
            assertAll(
                { assert process.success },
                { assert lines[0] == 'sample\tposition\tref\talt\tobserved_freq\texpected_freq\texcess\tdepth\talt_depth\tgene\taa_change\teffect\tn_samples\trecurrent\tp_value' },
                { assert lines.count { it.startsWith('sample\t') } == 1 },
                { assert rows.collect { [it[0], it[1], it[12], it[13]] } == [
                    ['S_ONE', '22102', '3', 'true'],       // recurrent first, then excess descending
                    ['S_TWO', '22102', '3', 'true'],
                    ['S_THREE', '22102', '3', 'true'],
                    ['S_TWO', '23063', '1', 'false'],
                    ['S_ONE', '28802', '1', 'false']
                ] }
            )
        }
    }

    test("only header-only inputs: header-only output - real") {

        tag "docker"
        when {
            process {
                """
                input[0] = [ file("\$projectDir/tests/fixtures/unexplained/concat/S_SKIPPED.unexplained_mutations.tsv") ]
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert lines == ['sample\tposition\tref\talt\tobserved_freq\texpected_freq\texcess\tdepth\talt_depth\tgene\taa_change\teffect\tn_samples\trecurrent\tp_value'] }
            )
        }
    }

    test("--min-recurrence 4 via ext.args: nothing is recurrent - real") {

        tag "docker"
        config "./min_recurrence.config"
        when {
            process {
                """
                def d = "\$projectDir/tests/fixtures/unexplained/concat"
                input[0] = [ file("\$d/S_ONE.unexplained_mutations.tsv"), file("\$d/S_TWO.unexplained_mutations.tsv"), file("\$d/S_THREE.unexplained_mutations.tsv") ]
                """
            }
        }

        then {
            def rows = new File(process.out.tsv[0].toString()).readLines().drop(1).collect { it.split('\t') as List }
            assertAll(
                { assert process.success },
                { assert rows.size() == 5 },
                { assert rows.every { it[13] == 'false' } }
            )
        }
    }

    test("tables with different headers are rejected - real") {

        tag "docker"
        when {
            process {
                """
                def bad = new File("\${launchDir}/BAD.unexplained_mutations.tsv")
                bad.text = 'sample\\tother\\nBAD\\t1\\n'
                def d = "\$projectDir/tests/fixtures/unexplained/concat"
                input[0] = [ file("\$d/S_ONE.unexplained_mutations.tsv"), file(bad.toString()) ]
                """
            }
        }

        then {
            assertAll(
                // conf/modules.config sets errorStrategy 'ignore' for this process: no output table
                { assert process.failed || process.out.tsv.isEmpty() }
            )
        }
    }
}
