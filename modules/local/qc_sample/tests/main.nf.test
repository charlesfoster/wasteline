nextflow_process {

    name "Test Process QC_SAMPLE"
    script "../main.nf"
    process "QC_SAMPLE"
    tag "modules"
    tag "modules_local"
    tag "qc_sample"
    tag "samtools/flagstat"
    tag "amplicon_coverage"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'S_1', sample_type:'sample', collection_date:'2026-01-05', site:'SiteA' ],
                    file("\$projectDir/tests/fixtures/modules_phase3/PURE_C.depths.gz"),
                    [],
                    [],
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1].toString().endsWith('S_1.qc_row.tsv') },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }

    // The ivar logs below are real `ivar trim` 1.4.4 output (stderr) on PURE_C with the midnight scheme;
    // 3515 of 15998 mapped reads (21.97 %) had primers trimmed.

    // PRIMER_SCHEME_CHECK summaries (the real tool output on PURE_C read starts) written by the test itself
}
