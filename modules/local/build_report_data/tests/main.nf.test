nextflow_process {

    name "Test Process BUILD_REPORT_DATA"
    script "../main.nf"
    process "BUILD_REPORT_DATA"
    tag "modules"
    tag "modules_local"
    tag "build_report_data"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                def dir = "\$projectDir/tests/fixtures/modules_report/minimal"
                input[1] = [ [], [], [], [] ]
                input[2] = [ [], [], [], [], [], [], [], [], '' ]
                input[0] = [ file("\$dir/run_info.json"), [], [], [], [], [], [], [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.json[0].toString().endsWith('report_data.json') }
            )
        }
    }

    test("f_real_qc: run_info + qc + amplicons only - real") {

        tag "docker"
        when {
            process {
                """
                def dir = "\$projectDir/tests/fixtures/modules_report/f_real_qc"
                input[1] = [ [], [], [], [] ]
                input[2] = [ [], [], [], [], [], [], [], [], '' ]
                input[0] = [
                    file("\$dir/run_info.json"), file("\$dir/qc_summary.tsv"), file("\$dir/amplicon_coverage.tsv"),
                    [], [], [], [], [], []
                ]
                """
            }
        }

        then {
            def data = new groovy.json.JsonSlurper().parse(new File(process.out.json[0].toString()))
            assertAll(
                { assert process.success },
                { assert data.schema_version == 1 },
                { assert data.available.qc },
                { assert data.available.amplicons },
                { assert !data.available.demix },
                { assert !data.available.coverage_tracks },
                { assert data.samples.size() > 0 },
                { assert data.samples.collect { it.sample } == data.samples.collect { it.sample }.sort(false) }
            )
        }
    }

    test("a_full: every optional input incl. depths - real") {

        tag "docker"
        when {
            process {
                """
                def dir = "\$projectDir/tests/fixtures/modules_report/a_full"
                input[1] = [ [], [], [], [] ]
                input[2] = [ [], [], [], [], [], [], [], [], '' ]
                input[0] = [
                    file("\$dir/run_info.json"), file("\$dir/qc_summary.tsv"), file("\$dir/amplicon_coverage.tsv"),
                    file("\$dir/freyja_aggregated.tsv"), file("\$dir/demix_status.tsv"), file("\$dir/consensus_stats.tsv"),
                    file("\$dir/mutations_of_interest.tsv"), file("\$dir/barcode_compare.tsv"),
                    [ file("\$dir/WW_001.depths"), file("\$dir/WW_002.depths") ]
                ]
                """
            }
        }

        then {
            def data = new groovy.json.JsonSlurper().parse(new File(process.out.json[0].toString()))
            assertAll(
                { assert process.success },
                { assert data.mode == 'full' },
                { assert data.header.barcode_version == '09_17_2026-00-46' },
                { assert data.available.qc },
                { assert data.available.demix },
                { assert data.available.coverage_tracks },
                { assert data.available.mutations_of_interest },
                { assert data.available.consensus },
                { assert data.available.barcode_comparison },
                { assert data.coverage_tracks.samples.keySet().containsAll(['WW_001', 'WW_002']) },
                { assert data.demix.WW_001.status == 'ok' },
                { assert data.demix.WW_001.groups.size() > 0 }
            )
        }
    }

    test("minimal: run_info + demix_status + aggregated only (demix mode) - real") {

        tag "docker"
        when {
            process {
                """
                def dir = "\$projectDir/tests/fixtures/modules_report/minimal"
                input[1] = [ [], [], [], [] ]
                input[2] = [ [], [], [], [], [], [], [], [], '' ]
                input[0] = [
                    file("\$dir/run_info.json"), [], [], file("\$dir/freyja_aggregated.tsv"), file("\$dir/demix_status.tsv"),
                    [], [], [], []
                ]
                """
            }
        }

        then {
            def data = new groovy.json.JsonSlurper().parse(new File(process.out.json[0].toString()))
            assertAll(
                { assert process.success },
                { assert data.available.demix },
                { assert !data.available.qc },
                { assert !data.available.amplicons },
                { assert !data.available.consensus },
                { assert data.mutations_of_interest == null },
                { assert data.samples.size() == 2 },
                { assert data.header.barcode_version == '09_17_2026-00-46' }
            )
        }
    }
}
