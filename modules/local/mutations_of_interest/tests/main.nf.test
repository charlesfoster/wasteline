nextflow_process {

    name "Test Process MUTATIONS_OF_INTEREST"
    script "../main.nf"
    process "MUTATIONS_OF_INTEREST"
    tag "modules"
    tag "modules_local"
    tag "mutations_of_interest"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/tests/fixtures/modules_phase3/PURE_C.variants.tsv.gz"), [] ]
                input[1] = file("\$projectDir/tests/fixtures/modules_phase3/mutations_of_interest.csv")
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1].toString().endsWith('S_1.mutations_of_interest.tsv') },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }

    test("PURE_C (JN.1): nucleotide and amino-acid mutations, present and absent - real") {

        tag "docker"
        when {
            process {
                """
                def tsv = new File("\${launchDir}/PURE_C.variants.tsv")
                tsv.bytes = new java.util.zip.GZIPInputStream(new FileInputStream("\$projectDir/tests/fixtures/modules_phase3/PURE_C.variants.tsv.gz")).bytes
                def depths = new File("\${launchDir}/PURE_C.depths")
                depths.bytes = new java.util.zip.GZIPInputStream(new FileInputStream("\$projectDir/tests/fixtures/modules_phase3/PURE_C.depths.gz")).bytes
                input[0] = [ [ id:'PURE_C' ], file(tsv.toString()), file(depths.toString()) ]
                input[1] = file("\$projectDir/tests/fixtures/modules_phase3/mutations_of_interest.csv")
                input[2] = file("\$projectDir/assets/references/NC_045512.gff3")
                input[3] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0][1].toString()).readLines()
            def rows = lines.drop(1).collect { def f = it.split('\t') as List; [(f[1]): f] }.collectEntries()
            assertAll(
                { assert process.success },
                { assert lines[0] == 'sample\tname\tmutation\tref_depth\talt_depth\tdepth\talt_freq' },
                { assert lines.drop(1).collect { it.split('\t')[1] } == ['orf1ab_P4715L', 'spike_L455S', 'spike_N501Y', 'spike_R346T', 'nuc_C241T', 'nuc_A23063T'] }, // input order
                { assert rows.every { k, v -> v[0] == 'PURE_C' } },
                { assert rows.orf1ab_P4715L[6] == '1' && (rows.orf1ab_P4715L[4] as int) > 0 },  // present (JN.1 carries ORF1ab:P4715L)
                { assert rows.spike_L455S[6] == '1' },
                { assert rows.spike_N501Y[6] == '1' },
                { assert rows.nuc_C241T[6] == '1' && rows.nuc_C241T[4] == '113' },
                { assert rows.nuc_A23063T[6] == '1' },                                  // = S:N501Y at nucleotide level
                { assert rows.spike_R346T[4] == '0' && rows.spike_R346T[6] == '0' },     // absent: alt 0 ...
                { assert (rows.spike_R346T[5] as int) > 0 && rows.spike_R346T[3] == rows.spike_R346T[5] } // ... depth from the depths file
            )
        }
    }

    test("without depths or GFF: absent mutations get NA depth - real") {

        tag "docker"
        when {
            process {
                """
                def tsv = new File("\${launchDir}/PURE_C.variants.tsv")
                tsv.bytes = new java.util.zip.GZIPInputStream(new FileInputStream("\$projectDir/tests/fixtures/modules_phase3/PURE_C.variants.tsv.gz")).bytes
                def moi = new File("\${launchDir}/nuc.csv")
                moi.text = 'name,mutation\\nnuc_C241T,C241T\\nnuc_absent,A100T\\n'
                input[0] = [ [ id:'PURE_C' ], file(tsv.toString()), [] ]
                input[1] = file(moi.toString())
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            def lines = new File(process.out.tsv[0][1].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert lines[1].split('\t')[6] == '1' },
                { assert lines[2] == 'PURE_C\tnuc_absent\tA100T\tNA\t0\tNA\t0' }
            )
        }
    }
}
