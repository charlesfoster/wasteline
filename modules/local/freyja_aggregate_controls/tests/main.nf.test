nextflow_process {

    name "Test Process FREYJA_AGGREGATE_CONTROLS"
    script "../main.nf"
    process "FREYJA_AGGREGATE_CONTROLS"
    tag "modules"
    tag "modules_local"
    tag "freyja_aggregate_controls"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ ['NEG_B', 'NEG_A'], [ file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/schema_input.json") ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.aggregated).match() }
            )
        }
    }
}
