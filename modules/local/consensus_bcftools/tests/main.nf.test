    test("synthetic ivar indels: 9-base deletion printed as N, 3-base deletion, insertion, deletion to the genome end - consensus keeps its length, deletions are '-' - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'IND_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_ivar_indels.variants.tsv") ]
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
            run("CONSENSUS_FILTER_VCF") {
                script "../../consensus_filter_vcf/main.nf"
                process {
                    """
                    input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                    """
                }
            }
            run("LOW_DEPTH_MASK") {
                script "../../low_depth_mask/main.nf"
                process {
                    """
                    def depths = new File("\${launchDir}/const.depths")
                    depths.text = (1..29903).collect { "NC_045512.2\\t\${it}\\tN\\t30" }.join('\\n') + '\\n'
                    input[0] = CONSENSUS_FILTER_VCF.out.bed.map { meta, bed -> [ meta, file(depths.toString()), bed ] }
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CONSENSUS_FILTER_VCF.out.vcf.join(LOW_DEPTH_MASK.out.bed)
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert fa[0] == '>IND_1' },
                { assert status == [sample: 'IND_1', status: 'ok', reason: '', warnings: []] },
                // ivar "-NNNNNNNNN" at 11287 (AF 0.99 in the failing real sample): 9 marked deleted bases, anchor kept
                { assert ref.substring(11286, 11296) == 'GTCTGGTTTT' },
                { assert cons.substring(11286, 11296) == 'G' + '-' * 9 },
                { assert cons.substring(11296, 11300) == ref.substring(11296, 11300) },
                { assert cons[4999] == 'A' && ref[4999] == 'C' },
                { assert cons.substring(14999, 15003) == 'T' + 'AC' + ref.substring(15000, 15001) },   // insertion applied, +2 shift after it
                { assert cons.substring(19999 + 2, 20003 + 2) == 'T---' },                              // 3-base deletion TGA marked
                { assert cons.substring(23999 + 2, 24002 + 2) == 'G--' },                               // deletion GCA -> G--, the AF 0.2 SNV is ignored
                { assert cons.endsWith('A---') },                                                       // deletion running to the genome end keeps the length
                { assert cons.substring(9000, 9010) == ref.substring(9000, 9010) },                      // AF 0.002 deletion ignored
                { assert cons.size() == 29903 + 2 },                                                    // +2 for the AC insertion; deletions keep the length
                { assert cons.count('-') == 9 + 3 + 2 + 3 },
                { assert !cons.contains('N') }
            )
        }
    }

    test("SNV inside a deleted span: bcftools skips it, listed in warnings as an expected note, status ok - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'OVL_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_ivar_overlap.variants.tsv") ]
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
            run("CONSENSUS_FILTER_VCF") {
                script "../../consensus_filter_vcf/main.nf"
                process {
                    """
                    input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                    """
                }
            }
            run("LOW_DEPTH_MASK") {
                script "../../low_depth_mask/main.nf"
                process {
                    """
                    def depths = new File("\${launchDir}/const.depths")
                    depths.text = (1..29903).collect { "NC_045512.2\\t\${it}\\tN\\t30" }.join('\\n') + '\\n'
                    input[0] = CONSENSUS_FILTER_VCF.out.bed.map { meta, bed -> [ meta, file(depths.toString()), bed ] }
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CONSENSUS_FILTER_VCF.out.vcf.join(LOW_DEPTH_MASK.out.bed)
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert fa[0] == '>OVL_1' },
                { assert status.status == 'ok' },
                { assert status.warnings == ['skipped variant at NC_045512.2:11296 (inside a deleted region)'] },
                { assert status.reason.contains('1 variant(s) not applied') },
                { assert cons.size() == 29903 },
                { assert cons.substring(11286, 11296) == 'G' + '-' * 9 },                 // the deletion is applied
                { assert cons[11295] == '-' },                                            // the SNV inside it (11296) is not applied
                { assert cons[4999] == 'A' && ref[4999] == 'C' }
            )
        }
    }

    test("VCF records whose REF does not match the reference are skipped with a warning, the genome is kept (status ok) - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
