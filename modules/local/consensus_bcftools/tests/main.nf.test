        }

        then {
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert fa[0] == '>MISMATCH_1' },
                { assert status.status == 'ok' },                                                       // not discarded: broken records are skipped
                { assert status.warnings == ['skipped variant at NC_045512.2:100 (REF mismatch)', 'skipped variant at NC_045512.2:20000 (REF mismatch)'] },
                { assert status.reason.contains('2 variant(s) not applied') && status.reason.contains('NC_045512.2:100') },
                { assert cons.size() == 29903 },
                { assert cons[99] == ref[99] && cons[19999] == ref[19999] },                            // skipped: reference base
                { assert cons[4999] == 'A' && ref[4999] == 'C' },                                       // other variants applied
                { assert cons.substring(11286, 11296) == 'G' + '-' * 9 },
                { assert !cons.contains('N') },
                { assert new File(process.out.log[0][1].toString()).text.contains('retry 2') }
            )
        }
    }

    test("more than 10 mismatching records -> status failed, all-N sequence - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'MANY_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_ivar_many_mismatch.variants.tsv") ]
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
            run("CONSENSUS_FILTER_VCF") {
                script "../../consensus_filter_vcf/main.nf"
                process {
                    """
                    input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                    """
                }
            }
            run("LOW_DEPTH_MASK") {
                script "../../low_depth_mask/main.nf"
                process {
                    """
                    def depths = new File("\${launchDir}/const.depths")
                    depths.text = (1..29903).collect { "NC_045512.2\\t\${it}\\tN\\t30" }.join('\\n') + '\\n'
                    input[0] = CONSENSUS_FILTER_VCF.out.bed.map { meta, bed -> [ meta, file(depths.toString()), bed ] }
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CONSENSUS_FILTER_VCF.out.vcf.join(LOW_DEPTH_MASK.out.bed)
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert fa[0] == '>MANY_1' },
                { assert status.status == 'failed' },                                                   // 12 bad positions > 10 retries
                { assert status.reason.contains('bcftools consensus failed') },
                { assert status.reason.contains('does not match the REF allele') },
                { assert cons.size() == 29903 },
                { assert cons.every { it == 'N' } }
            )
        }
    }

    test("IUPAC: AF 0.5 with 12 alt reads gives the ambiguity code, weak or low-AF sites stay reference - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'IUPAC_1' ], file("\$projectDir/tests/fixtures/modules_phase3/synthetic_iupac.variants.tsv") ]
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
            run("CONSENSUS_FILTER_VCF") {
                script "../../consensus_filter_vcf/main.nf"
                process {
                    """
                    input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                    """
                }
            }
            run("LOW_DEPTH_MASK") {
                script "../../low_depth_mask/main.nf"
                process {
                    """
                    def depths = new File("\${launchDir}/const.depths")
                    depths.text = (1..29903).collect { "NC_045512.2\\t\${it}\\tN\\t30" }.join('\\n') + '\\n'
                    input[0] = CONSENSUS_FILTER_VCF.out.bed.map { meta, bed -> [ meta, file(depths.toString()), bed ] }
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CONSENSUS_FILTER_VCF.out.vcf.join(LOW_DEPTH_MASK.out.bed)
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def seqOf = { String path -> new File(path).readLines().findAll { !it.startsWith('>') }.join('') }
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert status.status == 'ok' },
                { assert cons[6002] == 'R' && ref[6002] == 'A' },              // A/G -> R
                { assert cons[6499] == 'Y' && ref[6499] == 'C' },              // C/T -> Y
                { assert cons[7006] == ref[7006] },                            // AF .5 but only 3 alt reads: reference
                { assert cons[7500] == ref[7500] },                            // AF .33, 4 alt reads: reference
                { assert cons[8000] == ref[8000] },                            // AF .2: reference
                { assert cons[10001] == ref[10001] },                          // AF == .25 (not above): reference
                { assert cons[9017] == 'T' && ref[9017] == 'A' },              // AF .8: plain alt base
                { assert cons.substring(11008, 11012) == ref.substring(11008, 11012) }, // insertion at AF .5: not applied, never IUPAC
                { assert cons.substring(11999, 12003) == ref.substring(11999, 12003) }, // deletion at AF .5: not applied
                { assert cons.size() == 29903 },
                { assert !cons.contains('N') }
            )
        }
    }

    test("multi-allelic sites: one IUPAC code for the whole mixture, no overlap warnings (synthetic) - real") {

        tag "docker"
        setup {
            run("IVAR_VARIANTS_TO_VCF") {
                script "../../ivar_variants_to_vcf/main.nf"
                process {
                    """
                    input[0] = [ [ id:'MA_1' ], file("\$projectDir/tests/fixtures/consensus_multiallelic/synthetic_multiallelic.variants.tsv") ]
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
            run("CONSENSUS_FILTER_VCF") {
                script "../../consensus_filter_vcf/main.nf"
                process {
                    """
                    input[0] = IVAR_VARIANTS_TO_VCF.out.vcf
                    """
                }
            }
            run("LOW_DEPTH_MASK") {
                script "../../low_depth_mask/main.nf"
                process {
                    """
                    def depths = new File("\${launchDir}/const.depths")
                    depths.text = (1..29903).collect { "NC_045512.2\\t\${it}\\tN\\t30" }.join('\\n') + '\\n'
                    input[0] = CONSENSUS_FILTER_VCF.out.bed.map { meta, bed -> [ meta, file(depths.toString()), bed ] }
                    input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CONSENSUS_FILTER_VCF.out.vcf.join(LOW_DEPTH_MASK.out.bed)
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            def seqOf = { String path -> new File(path).readLines().findAll { !it.startsWith('>') }.join('') }
            def ref = new File("${projectDir}/assets/references/NC_045512.fasta").readLines().findAll { !it.startsWith('>') }.join('')
            def fa = new File(process.out.fasta[0][1].toString()).readLines()
            def cons = fa.findAll { !it.startsWith('>') }.join('')
            def status = new groovy.json.JsonSlurper().parse(new File(process.out.status[0][1].toString()))
            def expected = [22942: 'R', 22896: 'S', 23604: 'R', 4000: 'B', 5000: 'V', 6000: 'A', 6100: 'A', 7000: 'C',
                            8000: 'A', 8100: 'W', 9000: 'M', 9100: 'A', 9200: 'W', 9300: 'G', 9400: 'C', 10000: 'T', 11000: 'M', 14000: 'A']
            assertAll(
                { assert process.success },
                { assert status == [sample: 'MA_1', status: 'ok', reason: '', warnings: []] },   // no 'overlaps another variant' any more
                { assert !new File(process.out.log[0][1].toString()).text.contains('overlaps') },
                { assert expected.every { pos, base -> cons[pos - 1] == base } },
                { assert cons[22941] == 'R' && ref[22941] == 'T' },                      // T>G 0.6849 + T>A 0.2941: A/G, was K (G/T)
                { assert cons.size() == 29903 },
                { assert (0..<cons.size()).findAll { cons[it] != ref[it] }.every { expected.containsKey(it + 1) } }
            )
        }
    }

