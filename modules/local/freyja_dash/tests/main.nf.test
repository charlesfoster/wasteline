nextflow_process {

    name "Test Process FREYJA_DASH"
    script "../main.nf"
    process "FREYJA_DASH"
    tag "modules"
    tag "modules_local"
    tag "freyja_dash"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[2] = file("\$projectDir/assets/references/NC_045512.fasta")
                input[3] = 'Test'
                input[4] = 'Intro'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.dashboard.collect { f -> file(f.toString()).name },
                    process.out.failed.size()
                ).match() }
            )
        }
    }
}
