nextflow_process {

    name "Test Process CONSENSUS_STATS_CONCAT"
    script "../main.nf"
    process "CONSENSUS_STATS_CONCAT"
    tag "modules"
    tag "modules_local"
    tag "consensus_stats_concat"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id: 'T', target: [ name: 'T' ] ], [ file("\$projectDir/tests/fixtures/modules_phase3/concat/S_A.consensus_stats.tsv") ] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }
}
