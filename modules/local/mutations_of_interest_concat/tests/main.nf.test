nextflow_process {

    name "Test Process MUTATIONS_OF_INTEREST_CONCAT"
    script "../main.nf"
    process "MUTATIONS_OF_INTEREST_CONCAT"
    tag "modules"
    tag "modules_local"
    tag "mutations_of_interest_concat"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ file("\$projectDir/tests/fixtures/modules_phase3/concat/S_A.mutations_of_interest.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }
}
