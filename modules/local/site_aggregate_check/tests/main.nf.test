nextflow_process {

    name "Test Process SITE_AGGREGATE_CHECK"
    script "../main.nf"
    process "SITE_AGGREGATE_CHECK"
    tag "modules"
    tag "modules_local"
    tag "site_aggregate_check"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/site_aggregate/sites.csv")
                input[1] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out.report[0].toString()).name).match() }
            )
        }
    }
}
