nextflow_process {

    name "Test Process FREYJA_BOOT"
    script "../main.nf"
    process "FREYJA_BOOT"
    tag "modules"
    tag "modules_local"
    tag "freyja_boot"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'S_1' ], file("\$projectDir/assets/samplesheet.csv"), file("\$projectDir/assets/schema_input.json"), file("\$projectDir/assets/schema_input_demix.json") ]
                input[1] = file("\$projectDir/assets/references/NC_045512.fasta")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.summary.collect { m, f -> file(f.toString()).name }, process.out.status.collect { m, f -> file(f.toString()).name }).match() }
            )
        }
    }
}
