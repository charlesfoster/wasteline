nextflow_process {

    name "Test Process SITE_AGGREGATE"
    script "../main.nf"
    process "SITE_AGGREGATE"
    tag "modules"
    tag "modules_local"
    tag "site_aggregate"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/site_aggregate/demix_status.tsv")
                input[2] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/site_aggregate/sites.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.aggregated[0].toString()).readLines(),
                    file(process.out.meta[0].toString()).readLines()
                ).match() }
            )
        }
    }

    // tests/data_timeseries (3 sites x 8 weekly dates) with a demix_status.tsv in which LOWCOV_1 was skipped, and a
    // sites file with Metro = SiteA + SiteB + SiteC (with weights) and Pair = SiteA + "siteb " (matched case-insensitively).
    // Week 2026-W03 (Monday 2026-01-12): XBB.1.5 per site, replicates weighted by viral load (computed by hand):
    //   SiteA (0.16710542 * 851825 + 0.23093447 * 301960) / 1153785   = 0.183810
    //   SiteB (0.08106117 * 1169960 + 0.11608544 * 938723) / 2108683  = 0.096653
    //   SiteC (0.05187679 * 110143 + 0.04421386 * 964206) / 1074349   = 0.044999
    // and the sites by their mean load (576892.5, 1054341.5, 537174.5) -> 0.107045 (equal weights would give 0.108488).
    test("fixture: weighted result-level aggregate, labels and metadata - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/site_aggregate/demix_status.tsv")
                input[2] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/site_aggregate/sites.csv")
                """
            }
        }

        then {
            def agg = file(process.out.aggregated[0].toString()).readLines().collect { l -> l.split('\t', -1) as List }
            def meta = file(process.out.meta[0].toString()).readLines().collect { l -> l.split('\t', -1) as List }
            def metro = agg.find { r -> r[0] == 'Metro_2026-W03' }
            def names = metro[2].split(' ') as List
            def values = metro[3].split(' ').collect { v -> v as double }
            def xbb = values[names.indexOf('XBB.1.5')]
            def a = (0.16710542 * 851825 + 0.23093447 * 301960) / (851825 + 301960)
            def b = (0.08106117 * 1169960 + 0.11608544 * 938723) / (1169960 + 938723)
            def c = (0.05187679 * 110143 + 0.04421386 * 964206) / (110143 + 964206)
            def la = (851825 + 301960) / 2
            def lb = (1169960 + 938723) / 2
            def lc = (110143 + 964206) / 2
            def expected = (a * la + b * lb + c * lc) / (la + lb + lc)
            def mrow = meta.find { r -> r[0] == 'Metro_2026-W03' }
            def pair = meta.find { r -> r[0] == 'Pair_2026-W03' }
            assertAll(
                { assert process.success },
                { assert agg[0] == ['', 'summarized', 'lineages', 'abundances', 'resid', 'coverage'] },
                { assert meta[0] == ['row_label', 'aggregate_name', 'period', 'period_start', 'n_sites_included', 'sites_included', 'sites_missing', 'missing_reasons', 'weight_basis', 'weight_fraction_included', 'n_samples'] },
                { assert agg.drop(1).size() == 16 },
                { assert Math.abs(a - 0.183810) < 1e-6 },
                { assert Math.abs(xbb - expected) < 1e-7 },
                { assert Math.abs((values.sum() as double) - 1.0) < 1e-6 },
                { assert mrow[2] == '2026-W03' && mrow[3] == '2026-01-12' && mrow[4] == '3' && mrow[5] == 'SiteA;SiteB;SiteC' },
                { assert mrow[8] == 'viral_load' && mrow[9] == '1.00000000' && mrow[10] == '6' },
                // SiteC_W01_1 has no viral load, so the first week falls back to the sites file's weights
                { assert meta.find { r -> r[0] == 'Metro_2026-W02' }[8] == 'site_weight (viral_load missing)' },
                // the negative control (SiteA) is excluded: SiteA still has its two replicate samples only
                { assert pair[5] == 'SiteA;siteb' && pair[10] == '4' },
                // an aggregate holds no lineage that was not in the input
                { assert (agg.drop(1).collect { r -> r[2].split(' ') as List }.flatten() as Set).every { n -> ['BA.2', 'XBB.1.5', 'JN.1', 'BA.1'].contains(n) } }
            )
        }
    }

    test("fixture: ext.args --weights equal --min-sites 3 - real") {

        tag "docker"
        config "./nextflow.config"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/site_aggregate/demix_status.tsv")
                input[2] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/site_aggregate/sites.csv")
                """
            }
        }

        then {
            def meta = file(process.out.meta[0].toString()).readLines().drop(1).collect { l -> l.split('\t', -1) as List }
            assertAll(
                { assert process.success },
                // Pair has only two member sites, so --min-sites 3 omits it entirely
                { assert meta.collect { r -> r[1] } as Set == ['Metro'] as Set },
                { assert meta.every { r -> r[8] == 'equal' } }
            )
        }
    }

    test("a sites file with a blank site name fails with a message naming the line - real") {

        tag "docker"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/data_timeseries/freyja_aggregated.tsv")
                input[1] = file("\$projectDir/tests/fixtures/site_aggregate/demix_status.tsv")
                input[2] = file("\$projectDir/tests/data_timeseries/samplesheet.csv")
                input[3] = file("\$projectDir/tests/fixtures/site_aggregate/sites_bad.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("line 3: site_name is blank") }
            )
        }
    }
}
