nextflow_process {

    name "Test Process LINEAGE_GROUPS_CHECK"
    script "../main.nf"
    process "LINEAGE_GROUPS_CHECK"
    tag "modules"
    tag "modules_local"
    tag "lineage_groups_check"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = file("\$projectDir/tests/fixtures/lineage_groups/groups.csv")
                input[1] = file("\$projectDir/tests/fixtures/lineage_groups")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(file(process.out.report[0].toString()).name).match() }
            )
        }
    }
}
