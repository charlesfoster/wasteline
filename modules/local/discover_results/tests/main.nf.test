nextflow_process {

    name "Test Process DISCOVER_RESULTS"
    script "../main.nf"
    process "DISCOVER_RESULTS"
    tag "modules"
    tag "modules_local"
    tag "discover_results"

    test("stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ 1, file("\$projectDir/tests/fixtures/samplesheet/results_legacy") ]
                input[1] = 'aggregate'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.samplesheet.collect { f -> file(f.toString()).name }).match() }
            )
        }
    }
}
