/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Tiny simulated reads (placeholder until the Phase 6 synthetic dataset) and the Freyja
    barcode snapshot bundled in the pinned Freyja container, so the test is fully offline.

    Use as follows:
        nextflow run charlesfoster/wasteline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // The synthetic FASTQ samplesheet is only the default for FASTQ-based runs: not when the run is
    // given results directories (--previous_results, --demix_dir, --results_dir) or needs no input
    input    = (params.previous_results || params.demix_dir || params.results_dir || params.mode in ['report', 'update_db']) ? null : "${projectDir}/tests/data/samplesheet.csv"
    barcodes = 'container'
    // reads are the midnight amplicon dataset; the default scheme is qiagenv1 (D14), so say so explicitly where amplicons
    // are analysed (full mode, trimmed amplicon reads). Demix/aggregate runs stay without an explicit scheme.
    primer_scheme = (params.mode ?: 'full') == 'full' && !params.primer_bed && params.protocol != 'capture' && !params.skip_primer_trimming ? 'midnight' : null
    db_dir   = "${params.outdir}/db"
}

// NOTE: relative paths in the samplesheet are checked against the launch directory by nf-schema,
// so the test profiles must be launched from the root of this repository (or pass an --input
// samplesheet with absolute paths).
