/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for stub (-stub) runs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same inputs as the test profile but resolves `--barcodes latest` (stubbed: no download).

    Use as follows:
        nextflow run charlesfoster/wasteline -profile test_stub,<docker/singularity> -stub --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Stub test profile'
    config_profile_description = 'Stub run: checks wiring and output layout only'

    // The synthetic FASTQ samplesheet is only the default for FASTQ-based runs: not when the run is
    // given results directories (--previous_results, --demix_dir, --results_dir) or needs no input
    input    = (params.previous_results || params.demix_dir || params.results_dir || params.mode in ['report', 'update_db']) ? null : "${projectDir}/tests/data/samplesheet.csv"
    barcodes = 'latest'
    // reads are the midnight amplicon dataset; the default scheme is qiagenv1 (D14), so say so explicitly where amplicons
    // are analysed (full mode, trimmed amplicon reads). Demix/aggregate runs stay without an explicit scheme.
    primer_scheme = (params.mode ?: 'full') == 'full' && !params.primer_bed && params.protocol != 'capture' && !params.skip_primer_trimming ? 'midnight' : null
    db_dir   = "${params.outdir}/db"
}
