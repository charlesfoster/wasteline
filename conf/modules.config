/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output layout (PLAN section 6): per-sample files under samples/<id>/<step>/, run-level
    files under summary/ and pipeline_info/. Nothing is published unless listed here.
----------------------------------------------------------------------------------------
*/

process {

    // ---- reads: fastp -------------------------------------------------------------------
    withName: 'FASTP' {
        ext.args = {
            [
                params.fastp_cut_front ? '--cut_front' : '',
                params.fastp_cut_tail ? '--cut_tail' : '',
                params.fastp_trim_poly_x ? '--trim_poly_x' : '',
                params.fastp_correction ? '--correction' : '',
                "--cut_mean_quality ${params.fastp_cut_mean_quality}",
                "--qualified_quality_phred ${params.fastp_qualified_quality_phred}",
                "--unqualified_percent_limit ${params.fastp_unqualified_percent_limit}",
                "--length_required ${params.fastp_length_required}",
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/fastp" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.fastq.gz') ? (params.save_trimmed_reads ? filename : null) : filename
            }
        ]
    }

    // ---- alignment ----------------------------------------------------------------------
    withName: 'BWA_MEM' {
        ext.prefix = { "${meta.id}" }
    }

    withName: 'SAMTOOLS_VIEW' {
        ext.args   = '--bam -F 4'          // drop unmapped reads
        ext.prefix = { "${meta.id}.mapped" }
    }

    withName: 'IVAR_TRIM' {
        ext.args   = { "-x ${params.ivar_offset != null ? params.ivar_offset : (!params.primer_bed && params.primer_scheme == 'swift' ? 5 : 0)} -e" }
        ext.prefix = { "${meta.id}.ivar_trimmed" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/bam" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    // The sorted, indexed BAM Freyja works on. Reads that were not primer-trimmed (--protocol capture or
    // --skip_primer_trimming) are named <id>.mapped; with duplicate marking the BAM that is kept and
    // published is the marked one (SAMTOOLS_MARKDUP), so this one is then not published.
    // NOTE: these two closures spell out the "effective settings" of protocolSettings() in
    // subworkflows/local/utils_nfcore_wasteline_pipeline (a config file cannot call it).
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { (params.protocol == 'capture' || params.skip_primer_trimming) ? "${meta.id}.mapped" : "${meta.id}.primertrimmed" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def marked = params.duplicates == 'mark' || (params.duplicates == 'auto' && params.protocol == 'capture')
                params.save_bam && params.bam_format == 'bam' && !marked ? filename : null
            }
        ]
    }

    withName: 'SAMTOOLS_MARKDUP' {
        ext.prefix = { (params.protocol == 'capture' || params.skip_primer_trimming) ? "${meta.id}.mapped.markdup" : "${meta.id}.primertrimmed.markdup" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.markdup_stats.txt') || (params.save_bam && params.bam_format == 'bam') ? filename : null }
        ]
    }

    // --bam_format cram: the published alignment is a reference-based CRAM named like the BAM it replaces;
    // Freyja and all QC steps still work on the BAM (SAMTOOLS_CRAM is a leaf)
    withName: 'SAMTOOLS_CRAM' {
        errorStrategy = 'ignore'
        ext.prefix = {
            def marked = params.duplicates == 'mark' || (params.duplicates == 'auto' && params.protocol == 'capture')
            def untrimmed = params.protocol == 'capture' || params.skip_primer_trimming
            (untrimmed ? "${meta.id}.mapped" : "${meta.id}.primertrimmed") + (marked ? '.markdup' : '')
        }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/bam" },
            mode: params.publish_dir_mode
        ]
    }

    // --aligner minibwa (experimental, docs/aligner_evaluation.md); nothing is published by the aligner
    withName: 'MINIBWA_MEM' {
        ext.prefix = { "${meta.id}" }
    }

    // ---- Freyja -------------------------------------------------------------------------
    withName: 'FREYJA_UPDATE' {
        ext.args = { "--pathogen ${params.pathogen}" }
        // Only datasets downloaded with `latest` are kept in the local database
        publishDir = [
            path: { "${params.db_dir ?: System.getProperty('user.home') + '/.wasteline/db'}/freyja" },
            mode: 'copy',
            overwrite: true,
            saveAs: { filename -> source == 'latest' ? filename : null }
        ]
    }

    withName: 'FREYJA_DATASET_INFO' {
        publishDir = [
            // summary/barcode_version.json is published by the workflow (full and demix modes only:
            // aggregate demixes nothing, so its dataset says nothing about the barcodes of the results)
            [
                path: { "${params.outdir}/pipeline_info" },
                mode: params.publish_dir_mode,
                pattern: 'freyja_data.json'
            ]
        ]
    }

    // --compare_barcodes: the second dataset's provenance block, next to the first one
    withName: '.*:FREYJA_DATA_COMPARE:FREYJA_DATASET_INFO' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'freyja_data.json',
            saveAs: { filename -> 'freyja_data_compare.json' }
        ]
    }

    withName: 'FREYJA_VARIANTS' {
        ext.args   = { "--minq ${params.freyja_minq} --varthresh ${params.freyja_varthresh}" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/freyja" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FREYJA_DEMIX|FREYJA_DEMIX_COMPARE' {
        ext.args = {
            [
                "--eps ${params.freyja_eps}",
                "--covcut ${params.freyja_covcut}",
                "--depthcutoff ${params.freyja_depthcutoff}",
                "--adapt ${params.freyja_adapt}",
                "--solver ${params.freyja_solver}",
                "--pathogen ${params.pathogen}",
                params.freyja_autoadapt ? '--autoadapt' : '',
                params.freyja_relaxedmrca ? '--relaxedmrca' : '',
                params.freyja_confirmedonly ? '--confirmedonly' : '',
            ].findAll { arg -> arg }.join(' ')
        }
        ext.covcut                = { params.freyja_covcut }
        ext.min_genome_coverage   = { params.min_genome_coverage_for_demix }
        ext.floor_genome_coverage = { params.demix_floor_coverage }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/freyja" },
            mode: params.publish_dir_mode
        ]
    }

    // --compare_barcodes: the same samples demixed with the second dataset (files <id>.compare.*)
    withName: 'FREYJA_DEMIX_COMPARE' {
        ext.prefix = { "${meta.id}.compare" }
    }

    // --freyja_boot
    withName: 'FREYJA_BOOT' {
        errorStrategy = 'ignore'
        ext.args = {
            [
                "--nb ${params.freyja_boot_n}",
                "--bootseed ${params.freyja_boot_seed}",
                "--eps ${params.freyja_eps}",
                "--depthcutoff ${params.freyja_depthcutoff}",
                "--solver ${params.freyja_solver}",
                "--pathogen ${params.pathogen}",
                params.freyja_relaxedmrca ? '--relaxedmrca' : '',
                params.freyja_confirmedonly ? '--confirmedonly' : '',
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/freyja" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FREYJA_AGGREGATE_PLOT' {
        ext.args   = { "--mincov ${params.freyja_plot_mincov} --pathogen ${params.pathogen}" }
        ext.args2  = { "--interval ${params.freyja_plot_interval} --windowsize ${params.freyja_plot_windowsize}" } // time-aware plot only
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FREYJA_AGGREGATE_CONTROLS' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- results discovery (demix/aggregate from results directories) ---------------------
    withName: 'DISCOVER_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'discovery_*.log'
        ]
    }

    // ---- coverage QC -----------------------------------------------------------------------
    // Upstream QC and consensus steps use errorStrategy 'ignore': one bad sample never fails the run
    // (a sample without a result is still listed downstream: consensus_stats.tsv gets a `failed` row)
    withName: 'SAMTOOLS_FLAGSTAT' {
        errorStrategy = 'ignore'
        ext.prefix = { (params.protocol == 'capture' || params.skip_primer_trimming) ? "${meta.id}.mapped" : "${meta.id}.primertrimmed" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'AMPLICON_COVERAGE' {
        errorStrategy = 'ignore'
        ext.args   = { "--min-depth ${params.amplicon_min_depth}" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QC_SAMPLE' {
        errorStrategy = 'ignore'
        ext.args = {
            [
                "--min-depth ${params.qc_min_depth}",
                "--consensus-min-depth ${params.consensus_min_depth}",
                "--pass-min-pct ${params.qc_pass_min_pct}",
                "--fail-below-pct ${params.qc_fail_below_pct}",
                "--max-dropped ${params.qc_max_dropped_amplicons}",
                "--ntc-max-mapped-reads ${params.ntc_max_mapped_reads}",
                "--ntc-max-genome-coverage-pct ${params.ntc_max_genome_coverage_pct}",
                "--min-primer-trimmed-pct ${params.qc_min_primer_trimmed_pct}",
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CONSENSUS_STATS_CONCAT|CONSENSUS_CONCAT|MUTATIONS_OF_INTEREST_CONCAT' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QC_CONCAT' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            // with the report, summary/qc_summary.tsv is the merged table BUILD_REPORT_DATA publishes
            saveAs: { filename -> filename == 'qc_summary.tsv' && !params.skip_report ? null : filename }
        ]
    }

    // ---- consensus -------------------------------------------------------------------------
    withName: 'IVAR_VARIANTS_TO_VCF' {
        // no --pass_only / --allele_freq_thresh: thresholds are applied in CONSENSUS_FILTER_VCF
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CONSENSUS_FILTER_VCF' {
        errorStrategy = 'ignore'
        ext.consensus_freq      = { params.consensus_freq }
        ext.indel_freq          = { params.indel_freq }
        ext.min_alt_qual        = { params.consensus_min_alt_qual }
        ext.min_depth           = { params.consensus_min_depth_variants } // DP of a call; NOT the mask depth (consensus_min_depth)
        ext.iupac               = { params.consensus_iupac }
        ext.iupac_min_af        = { params.consensus_iupac_min_af }
        ext.iupac_min_alt_reads = { params.consensus_iupac_min_alt_reads }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf.gz*'                  // the called-variants BED is an intermediate
        ]
    }

    withName: 'LOW_DEPTH_MASK' {
        errorStrategy = 'ignore'
        ext.args   = { "--min-depth ${params.consensus_min_depth}" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CONSENSUS_BCFTOOLS|CONSENSUS_STATS' {
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/consensus" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- mutations of interest (opt-in) ----------------------------------------------------
    withName: 'MUTATIONS_OF_INTEREST' {
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANNOTATE_VARIANTS' {
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.annotated.tsv'
        ]
    }

    // ---- primer scheme check (amplicon protocol with trimming; reads of the mapped BAM BEFORE ivar trim) ----
    // A failure never costs a sample its QC row: the primer_scheme_* columns are then NA
    withName: 'READ_STARTS' {
        errorStrategy = 'ignore'
    }

    withName: 'PRIMER_SCHEME_CHECK' {
        errorStrategy = 'ignore'
        ext.args = { "--window ${params.primer_check_window} --min-enrichment ${params.primer_check_min_enrichment} --min-hit-fraction ${params.primer_check_min_hit_fraction}" }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/coverage" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- dropout impact -----------------------------------------------------------------------------------
    withName: 'DROPOUT_IMPACT' {
        errorStrategy = 'ignore'
        ext.args = { "--min-abundance ${params.dropout_min_abundance} --min-affect-abundance ${params.dropout_min_affect_abundance}" }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- unexplained mutations ----------------------------------------------------------------------------
    withName: 'UNEXPLAINED_MUTATIONS' {
        errorStrategy = 'ignore'
        ext.args = {
            [
                "--min-depth ${params.unexplained_min_depth}",
                "--min-alt-depth ${params.unexplained_min_alt_depth}",
                "--min-freq ${params.unexplained_min_freq}",
                "--min-excess ${params.unexplained_min_excess}",
                "--max-pvalue ${params.unexplained_max_pvalue}",
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/samples/${meta.id}/variants" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'UNEXPLAINED_MUTATIONS_CONCAT' {
        errorStrategy = 'ignore'
        ext.args = { "--min-recurrence ${params.unexplained_min_recurrence}" }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    // ---- time series, growth rates, dashboard -------------------------------------------------------------
    withName: 'TIMESERIES_TABLE' {
        errorStrategy = 'ignore'
        ext.args = { "--level summarized --min-abundance ${params.timeseries_min_abundance} --min-coverage ${params.freyja_plot_mincov}" }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TIMESERIES_TABLE_LINEAGES' {
        errorStrategy = 'ignore'
        ext.args = { "--level lineages --min-abundance ${params.timeseries_min_abundance} --min-coverage ${params.freyja_plot_mincov}" }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'freyja_timeseries.tsv' ? 'freyja_timeseries_lineages.tsv' : null }
        ]
    }

    // a soft failure (too few dates, Freyja error) is a published *.failed.txt, never a failed run
    withName: 'FREYJA_RELGROWTHRATE' {
        errorStrategy = 'ignore'
        ext.args = { "--nboots ${params.freyja_growth_nboots} --serial_interval ${params.freyja_growth_serial_interval} --grthresh ${params.freyja_growth_grthresh} --pathogen ${params.pathogen}" + (params.freyja_growth_scale_by_viral_load ? ' --scale_by_viral_load' : '') }
        ext.days          = { params.freyja_growth_days }
        ext.mincov        = { params.freyja_plot_mincov }
        ext.seed          = { params.freyja_growth_seed }
        ext.min_abundance = { params.freyja_growth_min_abundance }
        ext.min_dates     = { params.freyja_growth_min_dates }
        ext.min_span_days = { params.freyja_growth_min_span_days }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FREYJA_DASH' {
        errorStrategy = 'ignore'
        ext.args = { "--nboots ${params.freyja_growth_nboots} --serial_interval ${params.freyja_growth_serial_interval} --grthresh ${params.freyja_growth_grthresh} --pathogen ${params.pathogen}" + (params.freyja_growth_scale_by_viral_load ? ' --scale_by_viral_load' : '') }
        ext.days          = { params.freyja_growth_days }
        ext.mincov        = { params.freyja_plot_mincov }
        ext.seed          = { params.freyja_growth_seed }
        ext.min_abundance = { params.freyja_growth_min_abundance }
        ext.min_dates     = { params.freyja_growth_min_dates }
        ext.min_span_days = { params.freyja_growth_min_span_days }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: 'freyja_dashboard{.html,.failed.txt}'   // not the inputs json nor the dashboard's own growth csv
        ]
    }

    // ---- lineage groups and site aggregation -----------------------------------------------------------------
    // The CHECK processes keep the default error strategy (terminate): a mistake in the user's CSV must stop the
    // run within minutes. The analyses also fail the run on error, since their inputs were checked early.
    withName: 'SITE_AGGREGATE' {
        ext.args = { "--period ${params.site_aggregation_period} --weights ${params.site_aggregation_weights} --min-sites ${params.site_aggregation_min_sites}" + (params.include_low_confidence ? ' --include-low-confidence' : '') }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: 'site_aggregates_{freyja,meta}.tsv'
        ]
    }

    withName: 'LINEAGE_SUMMARY' {
        ext.args = {
            def xlsx = params.lineage_summary_xlsx
                ? " --xlsx-out lineage_summary.xlsx --xlsx-decimals ${params.lineage_summary_xlsx_decimals} --wasteline-version ${workflow.manifest.version}"
                : ''
            "--major-threshold ${params.lineage_major_threshold} --min-abundance ${params.lineage_min_abundance} --zeros ${params.lineage_summary_zeros} --decimals ${params.lineage_summary_decimals}${xlsx}"
        }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: 'lineage_*'
        ]
    }

    // ---- report ----------------------------------------------------------------------------
    withName: 'BUILD_REPORT_DATA' {
        ext.when   = { !params.skip_report }
        // --report_anonymize paths|full; `full` also writes the PRIVATE id map (published only then, never part of the report)
        ext.args   = {
            params.report_anonymize == 'none' ? '' : "--anonymize ${params.report_anonymize}" + (params.report_anonymize == 'full' ? ' --anonymize-map-out sample_id_map.csv' : '')
        }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: '{report_data.json,qc_summary.merged.tsv,sample_id_map.csv}',
            // the complete QC table (demix, consensus and barcode columns filled in) is THE qc_summary.tsv
            saveAs: { filename -> filename == 'qc_summary.merged.tsv' ? 'qc_summary.tsv' : filename }
        ]
    }

    withName: 'RENDER_REPORT' {
        ext.when   = { !params.skip_report }
        publishDir = [ path: { "${params.outdir}/summary" }, mode: params.publish_dir_mode, pattern: 'report.html' ]
    }

    // ---- provenance ---------------------------------------------------------------------
    withName: 'PROVENANCE' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }

}
