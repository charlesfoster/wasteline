/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Placeholder: same data as the test profile but resolves the latest Freyja barcodes from the
    network. A real full-size dataset arrives with the Phase 6 synthetic data.

    Use as follows:
        nextflow run charlesfoster/wasteline -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // The synthetic FASTQ samplesheet is only the default for FASTQ-based runs: not when the run is
    // given results directories (--previous_results, --demix_dir, --results_dir) or needs no input
    input    = (params.previous_results || params.demix_dir || params.results_dir || params.mode in ['report', 'update_db']) ? null : "${projectDir}/tests/data/samplesheet.csv"
    barcodes = 'latest'
    db_dir   = "${params.outdir}/db"
}
