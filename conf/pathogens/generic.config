/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Any other Freyja pathogen (no bundled profile)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded when --pathogen names a pathogen without its own file here. Nothing is bundled:
    --fasta is required and must be the reference.fasta that the Freyja barcodes were built
    on (the pathogen's folder in https://github.com/andersen-lab/Freyja-barcodes); --gff is
    optional. See docs/other_pathogens.md for what is supported.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = null   // given with --pathogen (this file is only loaded for such a name); declared so the strict parser accepts it
    fasta = null
    gff   = null

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null
    freyja_container_pathogen = null
    primer_schemes_bundled    = null  // no bundled primer schemes: pass --primer_bed, --primer_scheme_dir + a name, or --protocol capture
    primer_scheme_default     = null  // no default primer scheme (the bundled SARS-CoV-2 schemes do not fit this reference)
}
