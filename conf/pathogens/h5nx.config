/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Influenza A(H5Nx) (Freyja H5Nx) pathogen defaults: HA segment only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: AF144305.1 (A/Goose/Guangdong/1/96(H5N1) HA segment, 1760 bp), identical in sequence to
    the reference.fasta in the H5Nx folder of andersen-lab/Freyja-barcodes (the sequence the barcodes
    are tied to; Freyja's file has no accession in its header, the GenBank record was found by strain
    name and compared). Freyja's influenza barcodes cover the HA segment only, so this is an HA-only
    pathogen (PLAN D24): reads of the other seven segments do not map. Annotation: the NCBI GFF3 of the
    same record (HA CDS). No primer scheme is bundled: pass --primer_bed (a whole-genome panel BED is
    fine, its lines for the other segments are dropped) or --protocol capture. See docs/other_pathogens.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'H5Nx'
    fasta    = params.whole_genome.toString() == 'true' ? "${projectDir}/assets/references/AF144305.1_wg.fasta" : "${projectDir}/assets/references/AF144305.1.fasta"  // --whole_genome: all eight segments (PLAN D25)
    gff      = params.whole_genome.toString() == 'true' ? "${projectDir}/assets/references/AF144305.1_wg.gff3" : "${projectDir}/assets/references/AF144305.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
    primer_schemes_bundled    = null  // no bundled primer schemes: pass --primer_bed, --primer_scheme_dir + a name, or --protocol capture
    primer_scheme_default     = null  // no default primer scheme (the bundled SARS-CoV-2 schemes do not fit this reference)
    freyja_contig             = params.whole_genome.toString() == 'true' ? 'AF144305.1' : null  // the contig Freyja demixes: the HA segment of the whole-genome reference (PLAN D25); null = single-contig reference
}
