/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Measles (Freyja MEASLESgenome) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: NC_001498.1 (15,894 bp), the sequence the Freyja MEASLESgenome barcodes are
    tied to (Freyja docs, "Running Freyja on other pathogens - Measles"). No annotation is
    bundled (--gff is optional) and no primer scheme: pass --primer_bed (e.g. the ARTIC
    measles panel, contig NC_001498.1) or --protocol capture. See docs/other_pathogens.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'MEASLESgenome'
    fasta    = "${projectDir}/assets/references/NC_001498.1.fasta"
    gff      = null

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
}
