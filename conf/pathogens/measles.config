/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Measles (Freyja MEASLESgenome) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: NC_001498.1 (15,894 bp), the sequence the Freyja MEASLESgenome barcodes are
    tied to (Freyja docs, "Running Freyja on other pathogens - Measles"). No annotation is
    bundled (--gff is optional). The ARTIC measles panel is bundled (assets/primer_schemes/measles/,
    --primer_scheme artic-measles-v1.0.0) but is not the default: name a scheme, pass --primer_bed or
    --protocol capture. See docs/other_pathogens.md and assets/primer_schemes/README.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'MEASLESgenome'
    fasta    = "${projectDir}/assets/references/NC_001498.1.fasta"
    gff      = null

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
    primer_schemes_bundled    = "${projectDir}/assets/primer_schemes/measles"  // directory of the bundled <name>.bed schemes of this pathogen (null = none)
    primer_scheme_default     = null  // no default primer scheme: name one (--primer_scheme), pass --primer_bed or --protocol capture
    freyja_contig             = null  // the contig Freyja demixes when --fasta has several (multi-contig runs, PLAN D25); null = single-contig reference
}
