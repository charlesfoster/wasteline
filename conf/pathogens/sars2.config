/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SARS-CoV-2 pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The only place (besides assets/) where reference names are hard-coded. Command-line
    flags (--fasta, --gff) override these. Loaded when --pathogen is SARS-CoV-2 (the default);
    other pathogens use conf/pathogens/<profile>.config (selected in nextflow.config, PLAN D22).
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'SARS-CoV-2'   // Freyja --pathogen name
    fasta    = "${projectDir}/assets/references/NC_045512.fasta"
    gff      = "${projectDir}/assets/references/NC_045512.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled   = "${projectDir}/assets/lineage_groups.csv"  // default --lineage_groups; null = no bundled groups, the summary is off unless --lineage_groups is given
    freyja_container_pathogen = 'SARS-CoV-2'  // the pathogen whose data the pinned Freyja container bundles (--barcodes container); its datasets live in <db_dir>/freyja
    primer_schemes_bundled    = "${projectDir}/assets/primer_schemes"  // directory of the bundled <name>.bed schemes of this pathogen (null = none)
    primer_scheme_default     = 'qiagenv1'  // used in mode full when no --primer_scheme / --primer_bed / samplesheet cell is given (PLAN D14); null = no default
    freyja_contig             = null  // the contig Freyja demixes when --fasta has several (multi-contig runs, PLAN D25); null = single-contig reference
}
