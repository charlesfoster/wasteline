/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SARS-CoV-2 pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The only place (besides assets/) where reference names are hard-coded. Command-line
    flags (--fasta, --gff) override these. Other pathogens will get their own file here.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'SARS-CoV-2'   // Freyja --pathogen name
    fasta    = "${projectDir}/assets/references/NC_045512.fasta"
    gff      = "${projectDir}/assets/references/NC_045512.gff3"
}
