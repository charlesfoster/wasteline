/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RSV-A (Freyja RSVa) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: PP109421.1 (15,225 bp, hRSV/A/England/397/2017), byte-identical to the
    reference.fasta in the RSVa folder of andersen-lab/Freyja-barcodes (the sequence the
    barcodes are tied to; that file names it by its GISAID id EPI_ISL_412866). Annotation: the NCBI
    GFF3 of the same record. Two RSV panels are bundled in
    assets/primer_schemes/rsva/ (PLAN D27): rsva-rsv-pipeline (the 400 bp panel of charlesfoster/rsv_pipeline, written on this
    reference) and rsva-1000-v1.0.0-lifted (the published ARTIC/primalscheme panel, coordinates LIFTED onto this reference by
    alignment). Neither is the default: name one with --primer_scheme, pass --primer_bed or --protocol capture. See docs/other_pathogens.md and assets/primer_schemes/README.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'RSVa'
    fasta    = "${projectDir}/assets/references/PP109421.1.fasta"
    gff      = "${projectDir}/assets/references/PP109421.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
    primer_schemes_bundled    = "${projectDir}/assets/primer_schemes/rsva"  // directory of the bundled <name>.bed schemes of this pathogen (null = none)
    primer_scheme_default     = null  // no default primer scheme: name one (--primer_scheme), pass --primer_bed or --protocol capture
}
