/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Mpox (Freyja MPX) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: NC_063383.1 (197,209 bp, MPXV-M5312_HM12_Rivers, clade IIb), byte-identical to
    the reference.fasta in the MPX folder of andersen-lab/Freyja-barcodes (the sequence the
    barcodes are tied to; that file names it MPXV-M5312_HM12_Rivers). Annotation: the NCBI GFF3
    of the same record (see the header of the file). The genome has 6,422 bp inverted terminal
    repeats at both ends. Three mpox panels are bundled (assets/primer_schemes/mpx/: bccdc-mpox-v2.3.0,
    yale-mpox-2000-v1.0.0-lifted, artic-inrb-mpox-2500-v1.0.0-cladeiib; PLAN D26, D27) but none is the default.
    See docs/other_pathogens.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'MPX'
    fasta    = "${projectDir}/assets/references/NC_063383.1.fasta"
    gff      = "${projectDir}/assets/references/NC_063383.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
    primer_schemes_bundled    = "${projectDir}/assets/primer_schemes/mpx"  // directory of the bundled <name>.bed schemes of this pathogen (null = none)
    primer_scheme_default     = null  // no default primer scheme: name one (--primer_scheme), pass --primer_bed or --protocol capture
}
