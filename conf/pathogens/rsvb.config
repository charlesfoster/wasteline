/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RSV-B (Freyja RSVb) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: OP975389.1 (15,222 bp, hRSV/B/Australia/VIC-RCH056/2019), byte-identical to the
    reference.fasta in the RSVb folder of andersen-lab/Freyja-barcodes (the sequence the
    barcodes are tied to; that file names it by its GISAID id EPI_ISL_1653999). Annotation: the NCBI
    GFF3 of the same record. No primer scheme is bundled (licences): pass --primer_bed or
    --protocol capture. See docs/other_pathogens.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'RSVb'
    fasta    = "${projectDir}/assets/references/OP975389.1.fasta"
    gff      = "${projectDir}/assets/references/OP975389.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
}
