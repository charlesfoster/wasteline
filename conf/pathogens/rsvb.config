/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RSV-B (Freyja RSVb) pathogen defaults
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: OP975389.1 (15,222 bp, hRSV/B/Australia/VIC-RCH056/2019), byte-identical to the
    reference.fasta in the RSVb folder of andersen-lab/Freyja-barcodes (the sequence the
    barcodes are tied to; that file names it by its GISAID id EPI_ISL_1653999). Annotation: the NCBI
    GFF3 of the same record. Two RSV panels are bundled in
    assets/primer_schemes/rsvb/ (PLAN D27): rsvb-rsv-pipeline (the 400 bp panel of charlesfoster/rsv_pipeline, written on this
    reference) and rsvb-1000-v1.0.0-lifted (the published ARTIC/primalscheme panel, coordinates LIFTED onto this reference by
    alignment). Neither is the default: name one with --primer_scheme, pass --primer_bed or --protocol capture. See docs/other_pathogens.md and assets/primer_schemes/README.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'RSVb'
    fasta    = "${projectDir}/assets/references/OP975389.1.fasta"
    gff      = "${projectDir}/assets/references/OP975389.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
    primer_schemes_bundled    = "${projectDir}/assets/primer_schemes/rsvb"  // directory of the bundled <name>.bed schemes of this pathogen (null = none)
    primer_scheme_default     = null  // no default primer scheme: name one (--primer_scheme), pass --primer_bed or --protocol capture
    freyja_contig             = null  // the contig Freyja demixes when --fasta has several (multi-contig runs, PLAN D25); null = single-contig reference
}
