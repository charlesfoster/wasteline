/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Influenza A(H3N2) (Freyja H3N2) pathogen defaults: HA segment only
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reference: CY163680.1 (A/Wisconsin/67/2005(H3N2) HA segment, 1737 bp), identical in sequence to the
    reference.fasta in the H3N2 folder of andersen-lab/Freyja-barcodes (the sequence the barcodes are
    tied to). Freyja's influenza barcodes cover the HA segment only, so this is an HA-only pathogen
    (PLAN D24): reads of the other seven segments do not map. Annotation: the NCBI GFF3 of the same
    record (HA CDS). No primer scheme is bundled: pass --primer_bed (a whole-genome panel BED is fine,
    its lines for the other segments are dropped) or --protocol capture. See docs/other_pathogens.md.
----------------------------------------------------------------------------------------
*/

params {
    pathogen = 'H3N2'
    fasta    = "${projectDir}/assets/references/CY163680.1.fasta"
    gff      = "${projectDir}/assets/references/CY163680.1.gff3"

    // Facts about the pathogen's bundled data (hidden parameters: not recorded in run_info.json, not for users)
    lineage_groups_bundled    = null  // no bundled lineage groups: the summary is off unless --lineage_groups is given
    freyja_container_pathogen = null  // the Freyja container only bundles the default pathogen: use --barcodes latest or a dataset
}
